--!strict
-- A dot product of a Vec3f and a Vec4f: it fails at line 20, where it's written.
local shader = require '@jess/shader'

return shader.program {
  attributes = {
    normal = shader.vec3,
    position = shader.vec3,
  },

  parameters = {
    tint = shader.vec4,
  },

  vertex = function(input)
    return { position = shader.vec4(input.attributes.position, 1.0), normal = input.attributes.normal }
  end,

  fragment = function(input)
    local facing = shader.dot(shader.normalize(input.normal), input.tint)

    return shader.vec4(facing)
  end,
}
