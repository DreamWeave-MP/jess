--!strict
local test = require '@jess/test'
local catalog = require '../generated-reference'

local suite = test.new()

suite.it('publishes changes to declarations and source comments without reference edits', function()
  local before = [[-- Return the previous value.
local function read(value: string): string return value end
return table.freeze { read = read }]]
  local after = [[-- Return the updated value.
local function read(value: number): number return value end
return table.freeze { read = read }]]
  local first = catalog.packageModule(before, '@jess/new-module', 'new-module.jsl')
  local second = catalog.packageModule(after, '@jess/new-module', 'new-module.jsl')
  test.expect(#first).toBe(1)
  test.expect(#second).toBe(1)
  test.expect(first[1].signature).toBe '@jess/new-module.read(value: string) -> string'
  test.expect(second[1].signature).toBe '@jess/new-module.read(value: number) -> number'
  test.expect(second[1].description).toBe 'Return the updated value.'
  local page = catalog.renderModule('@jess/new-module', second)
  test.expect(string.find(page, 'read(value: number)', 1, true) ~= nil).toBe(true)
  test.expect(string.find(page, 'Return the updated value.', 1, true) ~= nil).toBe(true)
end)

suite.it('escapes documentation before inserting it into HTML', function()
  local source = [[-- Accept <data> & return it.
local function read(value: string): string return value end
return table.freeze { read = read }]]
  local page = catalog.renderModule('@jess/example', catalog.packageModule(source, '@jess/example', 'example.jsl'))
  test.expect(string.find(page, '&lt;data&gt; &amp;', 1, true) ~= nil).toBe(true)
end)

suite.it('extracts methods of an exported metatable type', function()
  local source = [[type Data = { name: string }
local Methods = {}
-- Format a message.
function Methods.format(self: unknown, value: string): string return value end
local Metatable = table.freeze(Methods)
export type Bundle = typeof(setmetatable({} :: Data, Metatable))
return table.freeze {}]]
  local symbols = catalog.packageModule(source, '@jess/example', 'example.jsl')
  local found, field = false, false
  for _, symbol in symbols do
    if symbol.name == '@jess/example.Bundle.name' then field = true end
    if symbol.name ~= '@jess/example.Bundle.format' then continue end
    found = true
    test.expect(symbol.signature).toBe '@jess/example.Bundle.format(self: unknown, value: string) -> string'
    test.expect(symbol.description).toBe 'Format a message.'
  end
  test.expect(found).toBe(true)
  test.expect(field).toBe(true)
end)

suite.it('uses source annotations and comments for exported frozen values', function()
  local source = [[local module = {}
-- The public mapping.
local values: { [string]: number } = { answer = 42 }
module.values = table.freeze(values)
return table.freeze(module)]]
  local symbols = catalog.packageModule(source, '@jess/example', 'example.jsl')
  test.expect(#symbols).toBe(1)
  test.expect(symbols[1].signature).toBe '@jess/example.values: { [string]: number }'
  test.expect(symbols[1].description).toBe 'The public mapping.'
end)

return suite
