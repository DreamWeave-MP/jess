--!strict
-- jess's package bootstrap: what the host runs to inspect, pack, resolve, and activate packages.
-- It is not a module and nothing can require it. Every entry opens packages and resolves them
-- through @jess/package, which runs no package code; `activate` then hands the accepted plan to
-- the one private mount the host passes it, and only after that can `require` reach a package, or
-- the host run the plan's entrypoints.

type Entrypoint = { module: string, capabilities: { string } }
type Layer = { id: string, requires: { string }, exports: { string }, entrypoints: { Entrypoint } }
type Managed = { id: string, module: string, interface: string? }
type Target = {
  id: string,
  kind: 'application' | 'command',
  entry: string,
  capabilities: { string },
  command: string?,
}
type PlanEntrypoint = { module: string, package: string, path: string, layer: string }
type Requirement = { id: string, requirement: string }

type Package = {
  read manifest: {
    read jessApi: string,
    read defaultTarget: string?,
    read modules: { [string]: string },
    read dependencies: { [string]: string },
    read devDependencies: { [string]: string },
    read layers: { Layer },
    read managed: { [string]: Managed },
    read targets: { [string]: Target },
    read tests: { string },
  },
  read id: string,
  read version: string,
  read digest: string,
  read kind: string,
  read location: string,
  read files: { string },
  read read: (path: string) -> buffer?,
}

type Plan = {
  read modules: { { name: string, package: string, path: string } },
  read entrypoints: { PlanEntrypoint },
  read packages: { { read id: string, read dependencies: { string } } },
}

type Offer = { read id: string }

type WorkspaceModule = {
  read open: (folder: string) -> unknown,
  read discover: (start: string) -> unknown,
  read describe: (workspace: unknown) -> { [string]: unknown },
  read verify: (workspace: unknown) -> unknown,
  read target: (workspace: unknown, name: string?, cwd: string) -> { [string]: unknown },
  read tests: (workspace: unknown, names: { string }) -> { { [string]: unknown } },
  read pack: (workspace: unknown, output: string, hostModules: { string }) -> { [string]: unknown },
  read describeImage: (image: Image) -> { [string]: unknown },
  read imageTarget: (image: Image, name: string?) -> { [string]: unknown },
  read sync: (
    workspace: unknown,
    artifacts: { string },
    paths: { string },
    locked: boolean,
    remote: { offline: boolean, indexes: { string }, publishers: { string } }
  ) -> { [string]: unknown },
}

--- A packed workspace opened: its packages as candidates, the digests they're pinned to, and
--- what opens one by its location.
type Image = {
  read offers: { Offer },
  read pins: { [string]: string },
  read open: (location: string) -> Package,
}

--- Where a packed workspace is: the `length` bytes from `offset` of the file `path`.
type ImageRef = { path: string, offset: number, length: number }

type ImageModule = {
  read open: (path: string, offset: number, length: number) -> Image,
}

type PackageModule = {
  read open: (location: string) -> Package,
  read peek: (location: string) -> Offer,
  read candidates: (folder: string) -> { Offer },
  read pack: (source: string, output: string, options: { version: string? }?) -> { [string]: unknown },
  read resolve: (packages: { Package }, request: { [string]: unknown }) -> (Plan, { Package }),
}

--- Where a resolution looks beyond the packages it is handed, and what it selects besides the
--- layers' providers: package path folders, packages offered as candidates by location, root
--- package ids, the ids whose `[dev-dependencies]` come along, and the digests packages are pinned
--- to. With an `image`, the packed workspace is the whole world: every location is one of its
--- packages, all of them are candidates, and each is pinned as its index pins it.
type Search = {
  paths: { string }?,
  candidates: { string }?,
  roots: { string }?,
  dev: { string }?,
  pins: { [string]: string }?,
  image: ImageRef?,
}

-- The host's own @jess/package, workspaces, and packed workspaces, handed in: the @jess/package
-- scripts require reads and writes only what the runtime's policy grants them, and these entries
-- are the host acting.
local package: PackageModule, workspaces: WorkspaceModule, images: ImageModule = ...

--- The packed workspace `ref` names, opened, or nil without one.
local function imageAt(ref: ImageRef?): Image?
  if not ref then return nil end

  return images.open(ref.path, ref.offset, ref.length)
end

type Mounted = {
  id: string,
  version: string,
  digest: string,
  dependencies: { string },
  managed: { Managed },
  files: { string },
  read: (path: string) -> buffer?,
}

export type Mount = (
  modules: { { name: string, package: string, path: string } },
  entrypoints: { PlanEntrypoint },
  packages: { Mounted }
) -> ()

--- The packages at `locations`, each opened out of `image` when there is one.
local function openAll(locations: { string }, image: Image?): { Package }
  local packages = {}

  for _, location in locations do
    table.insert(packages, if image then image.open(location) else package.open(location))
  end

  return packages
end

--- A package's `[managed]` declarations, sorted by id: the order an application supervisor loads
--- one package's managed modules in.
local function sortedManaged(declared: { [string]: Managed }): { Managed }
  local managed: { Managed } = {}

  for _, declaration in declared do
    table.insert(managed, declaration)
  end

  table.sort(
    managed,
    function(left: Managed, right: Managed): boolean return left.id < right.id end
  )

  return managed
end

local function inspect(location: string, ref: ImageRef?)
  local opened = openAll({ location }, imageAt(ref))[1]
  local manifest = opened.manifest
  local modules: { { name: string, path: string } } = {}
  local dependencies: { Requirement }, devDependencies: { Requirement } = {}, {}
  local capabilities: { { capability: string, layer: string, entrypoint: string } } = {}
  local targets: { Target } = {}

  for name, path in manifest.modules do
    table.insert(modules, { name = name, path = path })
  end

  table.sort(
    modules,
    function(
      left: { name: string, path: string },
      right: { name: string, path: string }
    ): boolean
      return left.name < right.name
    end
  )

  for id, requirement in manifest.dependencies do
    table.insert(dependencies, { id = id, requirement = requirement })
  end

  table.sort(
    dependencies,
    function(
      left: { id: string, requirement: string },
      right: { id: string, requirement: string }
    ): boolean
      return left.id < right.id
    end
  )

  for id, requirement in manifest.devDependencies do
    table.insert(devDependencies, { id = id, requirement = requirement })
  end

  table.sort(
    devDependencies,
    function(
      left: { id: string, requirement: string },
      right: { id: string, requirement: string }
    ): boolean
      return left.id < right.id
    end
  )

  for _, target in manifest.targets do
    table.insert(targets, target)
  end

  table.sort(targets, function(left: Target, right: Target): boolean return left.id < right.id end)

  for _, layer in manifest.layers do
    for _, entrypoint in layer.entrypoints do
      for _, capability in entrypoint.capabilities do
        table.insert(
          capabilities,
          { capability = capability, layer = layer.id, entrypoint = entrypoint.module }
        )
      end
    end
  end

  return {
    id = opened.id,
    version = opened.version,
    digest = opened.digest,
    kind = opened.kind,
    location = opened.location,
    jessApi = manifest.jessApi,
    defaultTarget = manifest.defaultTarget,
    files = #opened.files,
    modules = modules,
    layers = manifest.layers,
    managed = sortedManaged(manifest.managed),
    targets = targets,
    dependencies = dependencies,
    devDependencies = devDependencies,
    capabilities = capabilities,
    tests = manifest.tests,
  }
end

--- The request `resolve` takes for `layers` under `search`: every package path's candidates, in
--- the order the paths were given, then the candidates offered by location, then, with `image`,
--- every package it holds, opened out of it and pinned as it pins them.
local function request(
  layers: { string },
  hostModules: { string },
  search: Search?,
  grant: { string }?,
  image: Image?
): { [string]: unknown }
  local offers: { Offer } = {}
  local pins = table.clone((search and search.pins) or {})

  for _, folder in (search and search.paths) or {} do
    for _, offer in package.candidates(folder) do
      table.insert(offers, offer)
    end
  end

  for _, location in (search and search.candidates) or {} do
    table.insert(offers, package.peek(location))
  end

  if image then
    for _, offer in image.offers do
      table.insert(offers, offer)
    end

    for id, digest in image.pins do
      pins[id] = digest
    end
  end

  return {
    layers = layers,
    hostModules = hostModules,
    grant = grant,
    candidates = offers,
    open = image and image.open,
    roots = search and search.roots,
    dev = search and search.dev,
    pins = pins,
  }
end

local function graph(
  locations: { string },
  layers: { string },
  hostModules: { string },
  search: Search?
): Plan
  local image = imageAt(search and search.image)

  return (package.resolve(openAll(locations, image), request(layers, hostModules, search, nil, image)))
end

local function activate(
  mount: Mount,
  locations: { string },
  layers: { string },
  hostModules: { string },
  grant: { string }?,
  search: Search?
): Plan
  local image = imageAt(search and search.image)
  local plan, selected =
    package.resolve(openAll(locations, image), request(layers, hostModules, search, grant, image))
  local mounted: { Mounted } = {}

  for index, opened in selected do
    table.insert(mounted, {
      id = opened.id,
      version = opened.version,
      digest = opened.digest,
      dependencies = plan.packages[index].dependencies,
      managed = sortedManaged(opened.manifest.managed),
      files = opened.files,
      read = opened.read,
    })
  end

  mount(plan.modules, plan.entrypoints, mounted)

  return plan
end

--- The workspace at `start`: the one whose root it is when `explicit`, or else the one it is in.
local function located(start: string, explicit: boolean): unknown
  return if explicit then workspaces.open(start) else workspaces.discover(start)
end

local function workspace(start: string, explicit: boolean): { [string]: unknown }
  return workspaces.describe(workspaces.verify(located(start, explicit)))
end

--- The target of the workspace at `start` that `name` picks, run from `cwd`, and what its
--- package resolves over.
local function workspaceTarget(
  start: string,
  explicit: boolean,
  name: string?,
  cwd: string
): { [string]: unknown }
  return workspaces.target(located(start, explicit), name, cwd)
end

--- The members of the workspace at `start` whose tests run, and what each resolves over.
local function workspaceTests(
  start: string,
  explicit: boolean,
  names: { string }
): { { [string]: unknown } }
  return workspaces.tests(located(start, explicit), names)
end

--- Syncs the workspace at `start`'s lock and `.jess/packages` from the packages offered, and,
--- unless `offline`, from the publishers named and the ones the indexes name.
local function workspaceSync(
  start: string,
  explicit: boolean,
  artifacts: { string },
  paths: { string },
  locked: boolean,
  offline: boolean,
  indexes: { string },
  publishers: { string }
): { [string]: unknown }
  return workspaces.sync(
    located(start, explicit),
    artifacts,
    paths,
    locked,
    { offline = offline, indexes = indexes, publishers = publishers }
  )
end

--- Freezes the workspace at `start` into the packed workspace at `output`.
local function workspacePack(
  start: string,
  explicit: boolean,
  output: string,
  hostModules: { string }
): { [string]: unknown }
  return workspaces.pack(located(start, explicit), output, hostModules)
end

--- The packed workspace `ref` names, as a workspace's plain data.
local function imageWorkspace(ref: ImageRef): { [string]: unknown }
  return workspaces.describeImage(imageAt(ref) :: Image)
end

--- The exported target of the packed workspace `ref` names that `name` picks, or its default.
local function imageTarget(ref: ImageRef, name: string?): { [string]: unknown }
  return workspaces.imageTarget(imageAt(ref) :: Image, name)
end

return table.freeze {
  inspect = inspect,
  pack = function(source: string, output: string, version: string?): { [string]: unknown }
    return package.pack(source, output, if version then { version = version } else nil)
  end,
  graph = graph,
  activate = activate,
  workspace = workspace,
  workspaceTarget = workspaceTarget,
  workspaceTests = workspaceTests,
  workspaceSync = workspaceSync,
  workspacePack = workspacePack,
  imageWorkspace = imageWorkspace,
  imageTarget = imageTarget,
}
