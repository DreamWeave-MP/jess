--!strict
--!native
-- The built-in text decoders' and encoders' contract cases. The larger differential/fuzz corpus lives outside
-- this package test: these are the small cases a Jess build should never regress.
local json = require '@jess/json'
local toml = require '@jess/data/toml'
local values = require '@jess/data/value'
local yaml = require '@jess/yaml'
local test = require '@jess/test'
local expect = test.expect
local suite = test.new()

suite.describe('json', function()
  suite.it('decodes RFC 8259 values and UTF-16 escapes', function()
    local value = json.decode '{"text":"\\uD83D\\uDE03","values":[1,-2.5e2,true,false,null]}'
    expect(value.text).toBe '😃'
    expect(value.values[1]).toBe(1)
    expect(value.values[2]).toBe(-250)
    expect(value.values[3]).toBe(true)
    expect(value.values[4]).toBe(false)
    expect(value.values[5]).toBe(json.null)
  end)

  suite.it('is strict about separators, numbers, strings, and trailing data', function()
    local invalid = {
      '[1,]',
      '{"a":1,}',
      '01',
      '+1',
      '1.',
      '1e',
      '"\\q"',
      '"\\uD800"',
      'true false',
    }

    for _, source in invalid do
      expect(function() json.decode(source) end).toThrow 'json:'
    end
  end)
end)

suite.describe('toml', function()
  suite.it('implements TOML 1.1 values and keeps the native layout side channel', function()
    local value, layout = toml.decode [=[
name = "Jess"
max = 9223372036854775807
small = 42
float = 2.0
when = 1979-05-27T07:32Z
mixed = [1, "two", true,]
inline = {
  one = 1,
  two = 2,
}
]=]
    expect(value.name).toBe 'Jess'
    expect(typeof(value.small)).toBe 'number'
    expect(value.small).toBe(42)
    expect(typeof(value.max)).toBe 'integer'
    expect(tostring(value.max)).toBe '9223372036854775807'
    expect(value.when).toBe '1979-05-27T07:32Z'
    expect(value.mixed).toEqual { 1, 'two', true }
    expect(value.inline).toEqual { one = 1, two = 2 }
    expect(layout[value].keys).toEqual { 'name', 'max', 'small', 'float', 'when', 'mixed', 'inline' }
    expect(layout[value].floats.float).toBe(true)
    expect(layout[value].datetimes.when).toBe(true)
    expect(layout[value].datetimes.name).toBe(nil)

    local times, timesLayout = toml.decode 'times = [1979-05-27, 2, 07:32:00]'
    expect(timesLayout[times.times].datetimes).toEqual { [1] = true, [3] = true }
  end)

  suite.it('implements dotted tables and arrays of tables', function()
    local value = toml.decode [=[
[fruit.apple]
smooth = true
[fruit]
name = "apple"
[[products]]
name = "Hammer"
[[products]]
name = "Nail"
[products.detail]
color = "gray"
]=]
    expect(value.fruit.apple.smooth).toBe(true)
    expect(value.fruit.name).toBe 'apple'
    expect(value.products[1].name).toBe 'Hammer'
    expect(value.products[2].detail.color).toBe 'gray'
  end)

  suite.it('rejects TOML structural and numeric errors', function()
    local invalid = {
      'a = 01',
      'a = 1_',
      'a = 0x8000000000000000',
      'a = 1979-02-29',
      'a = "\\q"',
      'a = 1\na = 2',
      'a.b = 1\n[a]',
      'a = { b = 1 }\na.c = 2',
    }

    for _, source in invalid do
      expect(function() toml.decode(source) end).toThrow 'toml:'
    end
  end)

  suite.it('places a duplicate key at the key, inline or not', function()
    expect(function() toml.decode 'a = 1\na = 22\n' end).toThrow "duplicate key 'a' at line 2, column 1"
    expect(function() toml.decode 't = { a = 1, a = 2 }' end).toThrow "duplicate key 'a' at line 1, column 14"
  end)

  suite.it('records where keys and values are, when asked', function()
    local text = 'name = "Fargoth"\n[owner]\nage = 3\n'
    local document, layout = toml.decode(text, { positions = true })
    local positions = assert(layout[document].positions)
    local name = positions.name
    expect(name.key).toBe(1)
    expect(string.sub(text, name.value, name.valueEnd)).toBe '"Fargoth"'
    expect(positions.owner.key).toBe(19)
    expect(assert(layout[document.owner].positions).age.value).toBe(32)

    local again, plain = toml.decode(text)
    expect(plain[again].positions).toBeNil()
  end)
end)

suite.describe('yaml', function()
  suite.it('uses the YAML 1.2 Core schema', function()
    local value = yaml.decode [[
nulls: [null, Null, NULL, ~]
booleans: [true, True, FALSE]
integers: [12, -19, 0o17, 0x3A]
floats: [.5, +12e03, -.Inf, .NAN]
strings: [yes, no, on, off]
]]
    for _, item in value.nulls do expect(item).toBe(yaml.null) end
    expect(value.booleans).toEqual { true, true, false }
    expect(value.integers).toEqual { 12, -19, 15, 58 }
    expect(value.floats[1]).toBe(0.5)
    expect(value.floats[2]).toBe(12000)
    expect(value.floats[3]).toBe(-math.huge)
    expect(value.floats[4] ~= value.floats[4]).toBe(true)
    expect(value.strings).toEqual { 'yes', 'no', 'on', 'off' }
  end)

  suite.it('loads block, flow, anchor, alias, and custom-tag nodes', function()
    local value = yaml.decode [[
first: &base
  name: Jess
  folded: >-
    one
    two
  flow: [1, {two: 2},]
  literal: |
    a
    b
second: *base
custom: !<tag:example.com,2026:thing> hello
]]
    expect(value.second == value.first).toBe(true)
    expect(value.first.folded).toBe 'one two'
    expect(value.first.literal).toBe 'a\nb\n'
    expect(value.first.flow[2].two).toBe(2)
    expect(value.custom.tag).toBe 'tag:example.com,2026:thing'
    expect(value.custom.value).toBe 'hello'
  end)

  suite.it('loads independent documents and rejects malformed graphs', function()
    local documents = yaml.decodeAll '---\none\n...\n---\ntwo\n...\n'
    expect(documents).toEqual { 'one', 'two' }
    expect(function() yaml.decode '[1,,2]' end).toThrow 'YAML:'
    expect(function() yaml.decode 'value: *missing' end).toThrow 'YAML:'
    expect(function() yaml.decode 'a: 1\na: 2' end).toThrow 'YAML:'
  end)

  suite.it('reads a node from where it starts, whatever blanks or comment follow it', function()
    local value = yaml.decode(
      'quoted: "hello world"   \r\nsingle: \'it\'\'s\' \nflow: [1, 2] # two\nmap: {a: 1} \n'
        .. 'tagged: !!str "5" \nitems:\n  - "x" # first\n  - [3] \n'
    )
    expect(value.quoted).toBe 'hello world'
    expect(value.single).toBe "it's"
    expect(value.flow).toEqual { 1, 2 }
    expect(value.map.a).toBe(1)
    expect(value.tagged).toBe '5'
    expect(value.items[1]).toBe 'x'
    expect(value.items[2]).toEqual { 3 }
  end)
end)

suite.describe('encode', function()
  --- One document with a field of each kind, in an order no sort would give. TOML has no null.
  local function document(null: boolean): values.Map
    local fields: { { unknown } } = {
      { 'name', 'Jess' },
      { 'count', 3 },
      { 'ratio', values.float(2) },
      { 'tags', values.array { 'a', 'b' } },
      { 'absent', nil },
      { 'nested', values.struct { { 'on', true }, { 'note', 'yes' } } },
    }

    if null then table.insert(fields, 2, { 'nothing', values.Null }) end

    return values.struct(fields)
  end

  suite.it('writes JSON on one line, fields in the order they were built', function()
    expect(json.encode(document(true))).toBe(
      '{"name":"Jess","nothing":null,"count":3,"ratio":2.0,"tags":["a","b"],"absent":null,'
        .. '"nested":{"on":true,"note":"yes"}}'
    )
  end)

  suite.it('writes YAML in block style, quoting only what a reader would take for something else', function()
    expect(yaml.encode(document(true))).toBe(table.concat({
      'name: Jess',
      'nothing: null',
      'count: 3',
      'ratio: 2.0',
      'tags:',
      '- a',
      '- b',
      'absent: null',
      'nested:',
      '  on: true',
      '  note: yes',
      '',
    }, '\n'))
  end)

  suite.it('writes TOML with tables after values, and leaves an absent field out', function()
    expect(toml.encode(document(false))).toBe(table.concat({
      'name = "Jess"',
      'count = 3',
      'ratio = 2.0',
      'tags = [',
      '    "a",',
      '    "b",',
      ']',
      '',
      '[nested]',
      'on = true',
      'note = "yes"',
      '',
    }, '\n'))

    expect(function() toml.encode(document(true)) end).toThrow 'toml:'
  end)

  suite.it('writes what each decoder reads back as the same values', function()
    local fromJson = json.decode(json.encode(document(true)))
    local fromYaml = yaml.decode(yaml.encode(document(true)))
    local fromToml = toml.decode(toml.encode(document(false)))

    local documents: { toml.Table } = { fromJson, fromYaml, fromToml }

    for _, read in documents do
      expect({ read.name, read.count, read.ratio }).toEqual { 'Jess', 3, 2 }
      expect(read.tags).toEqual { 'a', 'b' }
      expect(read.nested).toEqual { on = true, note = 'yes' }
    end

    expect(fromJson.nothing).toBe(json.null)
    expect(fromYaml.nothing).toBe(yaml.null)
  end)

  suite.it('writes a null a decoder read as a null', function()
    expect(json.encode(values.array { json.decode 'null', yaml.decode 'null' })).toBe '[null,null]'
  end)

  suite.it('writes a plain table with sorted keys, indented or on one line', function()
    local value = { zeta = { 1, 2.5, 'x\ty' }, alpha = 'Caf\233', empty = {}, none = json.null }
    expect(json.encodeTable(value)).toBe '{"alpha":"Caf\233","empty":[],"none":null,"zeta":[1,2.5,"x\\ty"]}'
    expect(json.encodeTable(value, { latin1 = true })).toContain '"Caf\\u00e9"'
    expect(json.encodeTable({ items = { 1 } }, { indent = 1 })).toBe '{\n "items": [\n  1\n ]\n}'
    expect(function() json.encodeTable { 1, nil, 3 } end).toThrow 'string keys or dense array indexes'
    expect(function() json.encodeTable(0 / 0) end).toThrow 'NaN or infinite'
  end)

  suite.it('has one null, jess.null, everywhere', function()
    expect(json.null).toBe(jess.null)
    expect(yaml.decode 'null').toBe(jess.null)
    expect(values.Null).toBe(jess.null)
    expect(json.encode(jess.null)).toBe 'null'
  end)

  suite.it('refuses a table it would have to guess about, and a format it doesn\'t write', function()
    expect(function() json.encode { 1, 2 } end).toThrow 'a bare table is neither a list nor a map'
    expect(function() yaml.encode { name = 'Jess' } end).toThrow 'a bare table is neither a list nor a map'
    expect(function() json.encode(print) end).toThrow 'a function can\'t be written'
    expect(function() values.encode(values.array {}, 'xml') end).toThrow 'unknown format \'xml\''
  end)
end)

return suite
