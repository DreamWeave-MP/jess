-- Generic Jess runtime service definitions.

declare extern type JessNull with end

--- A handle to a native resource that may cross domain and worker boundaries in a message: its
--- `kind`, in the vocabulary of whatever made it.
declare extern type JessHandle with
  kind: string
end

--- The handlers `jess.context.bind` takes, by phase name. Each gets the phase's payload: seconds
--- for `update`, `fixedUpdate`, and `lateUpdate`, the event for `event`, nothing for `startup` and
--- `shutdown`.
export type ContextHandlers = { [string]: (payload: any) -> () }

--- The host callbacks a managed module returns under `on.host`, each called in its own context:
--- `load` and `startup` once, `fixedUpdate` with the step and `update`/`lateUpdate` with the
--- frame's seconds, `input`/`renderPrepare`/`onDemand` with what the host passes, `shutdown`
--- once at the end. `interfaceOverride` is the loader's, called once with the implementation the
--- module's interface replaces.
export type HostHandlers = {
  load: (() -> ())?,
  startup: (() -> ())?,
  fixedUpdate: ((stepSeconds: number) -> ())?,
  update: ((deltaSeconds: number) -> ())?,
  lateUpdate: ((deltaSeconds: number) -> ())?,
  input: ((payload: any) -> ())?,
  renderPrepare: ((payload: any) -> ())?,
  onDemand: ((payload: any) -> ())?,
  shutdown: (() -> ())?,
  interfaceOverride: ((previous: any) -> ())?,
}

--- What a package's `[managed]` module returns: host callbacks, named-event handlers by event
--- name, and the table its manifest's `interface` names, if it declares one.
export type ManagedModule = {
  on: { host: HostHandlers?, event: { [string]: (payload: any) -> () }? }?,
  interface: { [string]: any }?,
}

--- What `jess.worker.spawn` takes: the worker module's source (a chunk returning the message
--- handler), a name for diagnostics, and the capabilities the worker holds, a subset of the
--- spawner's.
export type WorkerOptions = { source: string, name: string?, capabilities: { string }?, shareServices: boolean? }

--- A worker the domain spawned: `send` queues a message for its handler, `receive` reads its next
--- reply (waiting up to the seconds given), `close` stops it after the queued messages, `join`
--- waits for it to end.
export type Worker = jess_runtime_Worker

--- What an action's value is shaped like: `digital` (boolean), `scalar` (number), or `vector2`
--- (a `vector` with `z` 0).
export type InputValueType = 'digital' | 'scalar' | 'vector2'

--- A device's glyph family, for labels (`@jess/input`'s `label`): `keyboardMouse`, `xbox`,
--- `playstation`, `nintendo`, `genericGamepad`, or `touch`.
export type InputFamily = 'keyboardMouse' | 'xbox' | 'playstation' | 'nintendo' | 'genericGamepad' | 'touch'

--- An action's value: a boolean for digital, a number for scalar, a `vector` (z 0) for vector2.
export type InputValue = boolean | number | vector

--- An action's state after a tick. `pressed` and `released` are this tick's edges; `since` is when
--- it last became active or inactive, in seconds; `device` is the device behind the value.
export type InputActionState = {
  value: InputValue,
  active: boolean,
  pressed: boolean,
  released: boolean,
  changed: boolean,
  since: number,
  device: number?,
}

--- One action edge from a tick.
export type InputActionEvent = {
  action: string,
  kind: 'pressed' | 'released' | 'changed',
  value: InputValue,
  time: number,
  device: number?,
}

--- A device the runtime connected.
export type InputDevice = { id: number, kind: 'keyboard' | 'pointer' | 'gamepad' | 'touch' | 'unknown', name: string, family: InputFamily, connected: boolean }

--- What the last tick did.
export type InputStats = {
  deviceEvents: number,
  ticks: number,
  nodesEvaluated: number,
  bindingsEvaluated: number,
  actionsChanged: number,
  actionEvents: number,
  activeSets: number,
  activeLayers: number,
}

--- A compiled, validated action graph.
export type InputGraph = {
  --- The document as JSON, the same text for the same document.
  toJson: (self: InputGraph) -> string,
  --- The actions, in declaration order.
  actions: (self: InputGraph) -> { { name: string, valueType: InputValueType } },
}

--- An input runtime. Under a host it is the application's live input: the host ticks it in the
--- input phase, and `tick` and `advance` are refused. Anywhere else it is headless: a graph,
--- synthetic devices, and a clock that moves when told to. Reading state needs `input.actions`,
--- `devices` needs `input.observe`, and everything that changes it needs `input.configure`.
export type InputRuntime = {
  --- Installs a graph, replacing the last one. Returns the new generation.
  install: (self: InputRuntime, graph: InputGraph) -> number,
  uninstall: (self: InputRuntime) -> (),
  --- Puts the installed package's bindings back, dropping remaps.
  restoreDefaults: (self: InputRuntime) -> (),
  --- Activates (the default) or deactivates a set, from the next tick.
  setActive: (self: InputRuntime, set: string, active: boolean?) -> (),
  pushLayer: (self: InputRuntime, layer: string) -> (),
  --- Removes a layer; whether it was pushed.
  popLayer: (self: InputRuntime, layer: string) -> boolean,
  --- Connects a synthetic device and returns its id.
  connect: (self: InputRuntime, kind: 'keyboard' | 'pointer' | 'gamepad' | 'touch') -> number,
  disconnect: (self: InputRuntime, device: number) -> (),
  --- Presses a button, named `class:Name` (`key:KeyA`, `gamepadButton:South`).
  press: (self: InputRuntime, device: number, control: string) -> (),
  release: (self: InputRuntime, device: number, control: string) -> (),
  --- Moves an axis (`gamepadAxis:LeftStickX`) to `value`, or a relative one by it.
  axis: (self: InputRuntime, device: number, control: string, value: number) -> (),
  focus: (self: InputRuntime, focused: boolean) -> (),
  --- Moves the clock forward by `seconds`.
  advance: (self: InputRuntime, seconds: number) -> (),
  now: (self: InputRuntime) -> number,
  --- Applies every event so far, evaluates the graph once, and returns the action edges.
  tick: (self: InputRuntime) -> { InputActionEvent },
  --- An action's state after the last tick, or nil for a name the graph doesn't declare.
  action: (self: InputRuntime, name: string) -> InputActionState?,
  devices: (self: InputRuntime) -> { InputDevice },
  stats: (self: InputRuntime) -> InputStats,
}

--- How one sample is stored in interleaved bytes, little-endian: unsigned 8-bit, signed 16-,
--- 24- (three bytes), and 32-bit, and 32- and 64-bit floats.
export type AudioSampleFormat = 'u8' | 's16' | 's24' | 's32' | 'f32' | 'f64'

--- Decoded audio from `jess.audio.pcm`: planar float channels at one rate, shared by every voice
--- that plays it.
export type AudioPcm = {
  --- Frames per second.
  rate: (self: AudioPcm) -> number,
  channels: (self: AudioPcm) -> number,
  --- The length in frames.
  frames: (self: AudioPcm) -> number,
}

--- How to start a voice. `at` is an output frame, and the voice starts on exactly that frame;
--- without one it starts on the next frame rendered. `gain` is linear (1), `pan` -1 to 1 (0;
--- equal power for mono, balance for stereo), `rate` the playback rate, pitch with it (1),
--- `offset` the source frame to start from (0). With `loop`, playback that reaches `loopEnd` (the
--- source's end) continues at `loopStart` (0), without a gap.
export type AudioPlayOptions = {
  at: number?,
  gain: number?,
  pan: number?,
  rate: number?,
  offset: number?,
  loop: boolean?,
  loopStart: number?,
  loopEnd: number?,
  --- The bus it plays into: the master unless told otherwise.
  bus: AudioBus?,
  --- Up to two buses it also sends to, each at a level relative to its own gain (1).
  sends: { { bus: AudioBus, level: number? } }?,
  --- Frames to fade in over, from silence to `gain` (0).
  fade: number?,
  --- Where it is, if it's in space: then distance, direction, and motion set its level, pan, and
  --- pitch, and `pan` is not used.
  place: AudioPlace?,
  --- How much it matters when there are more voices than the context mixes (0): higher keeps its
  --- place over lower, whatever their levels.
  priority: number?,
  --- What it does while culled: keeps time silently (`advance`, the default), holds its place
  --- (`pause`), or ends (`stop`).
  culled: ('advance' | 'pause' | 'stop')?,
}

--- A voice's place in space, in the world's own units and axes. Every field is optional: on
--- `play` the rest are the defaults, on `AudioVoice:place` what they were. `cone` angles are whole
--- angles in degrees: full level inside `inner` of `direction`, `outside` (0 to 1) beyond `outer`.
--- `distance` is the model (`inverse` by default, `linear`, `exponential`, `none`) between
--- `reference` (1, full level) and `maximum` (no quieter beyond), at `rolloff` (1). `doppler` (1)
--- scales the pitch shift from motion. `gain` (1) and `lowpass` (a cutoff in hertz) are for what
--- lies between the voice and the listener, as the application works it out.
export type AudioPlace = {
  position: vector?,
  velocity: vector?,
  direction: vector?,
  cone: { inner: number?, outer: number?, outside: number? }?,
  distance: ('none' | 'inverse' | 'linear' | 'exponential')?,
  reference: number?,
  maximum: number?,
  rolloff: number?,
  doppler: number?,
  gain: number?,
  lowpass: number?,
}

--- How to make a context: 48000 frames per second, 2 channels, 256 voices, 64 buses (the master
--- included), 256 processors, and room for 4096 waiting commands, unless told otherwise. Space is
--- right-handed (forward crossed with up points right) unless `handedness` is `left`, and sound
--- travels at `speedOfSound` (343) of the world's units a second.
export type AudioContextOptions = {
  rate: number?,
  channels: number?,
  voices: number?,
  buses: number?,
  processors: number?,
  commands: number?,
  speedOfSound: number?,
  handedness: ('right' | 'left')?,
  --- Voices mixed at once, if fewer than `voices`: the rest are culled, by priority and then by
  --- loudness, until there is room.
  physical: number?,
}

--- A stream: a bounded ring of interleaved frames that one writer fills, from any worker, while
--- one voice plays it. The voice plays silence where the writer has fallen behind (`missed`
--- counts it), and ends once the writer has finished and everything written has played.
export type AudioStream = {
  channels: (self: AudioStream) -> number,
  rate: (self: AudioStream) -> number,
  --- Frames there is room for now.
  room: (self: AudioStream) -> number,
  --- Writes as many whole frames of interleaved 32-bit floats as fit, from the first `frames`
  --- of the buffer (all of it without), and returns how many.
  write: (self: AudioStream, samples: buffer, frames: number?) -> number,
  --- Waits until there is room for `frames`, or `timeout` seconds pass (forever without one);
  --- true if there is. It sleeps as long as playing at the stream's rate takes to make the room.
  wait: (self: AudioStream, frames: number, timeout: number?) -> boolean,
  --- Says the writer is done: once played to its end, the voice ends.
  finish: (self: AudioStream) -> (),
  stats: (self: AudioStream) -> { written: number, read: number, room: number, missed: number, finished: boolean },
  --- A handle to send a worker, which opens the same stream with `jess.audio.stream`.
  handle: (self: AudioStream) -> JessHandle,
}

--- An output's options: a context's, and the device's.
export type AudioOutputOptions = AudioContextOptions & { device: ('default' | 'null')?, period: number? }

--- An output device: the platform API it plays through, its rate and channels, the frames it
--- asks for at a time and how many periods it buffers (`latency`, about, in frames, is how far
--- what you hear lags `now`), and what has happened to it: `stopped`, `rerouted` to a new default
--- device, `interrupted` by the system, whether the engine `failed` on its thread, and whether
--- the output was `closed`.
export type AudioDevice = {
  backend: string,
  rate: number,
  channels: number,
  period: number,
  periods: number,
  latency: number,
  stopped: number,
  rerouted: number,
  interrupted: number,
  failed: boolean,
  closed: boolean,
}

--- Where the listener is and which way it faces; any field left out stays as it was.
export type AudioListener = { position: vector?, forward: vector?, up: vector?, velocity: vector? }

--- A ramp's shape: a straight line, or the same ratio every frame (both ends above 0), which is
--- even steps in decibels.
export type AudioCurve = 'linear' | 'exponential'

--- A bus's level since it was last read, after its gain: the peak sample's magnitude and the
--- RMS, linear, across its channels.
export type AudioMeter = { peak: number, rms: number }

--- How a bus sends to another: at `level` (1), tapped after its gain and mute (`post`, the usual)
--- or before them (`pre`), from frame `at`.
export type AudioSendOptions = { level: number?, tap: ('post' | 'pre')?, at: number? }

--- A bus: where voices and buses sum. It runs its processors over the sum, applies its gain, and
--- adds the result into its parent and its sends. Every command takes an optional `at`, an output
--- frame; without one, the next frame rendered.
export type AudioBus = {
  --- Sets `gain` (linear) or `mute` (0 off, anything else on).
  set: (self: AudioBus, param: 'gain' | 'mute', value: number, at: number?) -> boolean,
  --- Ramps the gain to `value` over `frames` frames from `at`, sample by sample.
  ramp: (self: AudioBus, param: 'gain', value: number, frames: number, at: number?, curve: AudioCurve?) -> boolean,
  --- Routes the bus into another; a route that would loop back into it is an error.
  route: (self: AudioBus, parent: AudioBus, at: number?) -> (),
  --- Adds a send to `target`, or changes the one there; up to four besides the parent.
  send: (self: AudioBus, target: AudioBus, options: AudioSendOptions?) -> (),
  unsend: (self: AudioBus, target: AudioBus, at: number?) -> boolean,
  --- Removes the bus once nothing routes into it; its processors ring out their tails first.
  remove: (self: AudioBus, at: number?) -> boolean,
  live: (self: AudioBus) -> boolean,
  --- Frames its output lags the voices that reach it, by the longest path's processors.
  latency: (self: AudioBus) -> number,
  meter: (self: AudioBus) -> AudioMeter,
  --- Puts a processor of `kind` in the chain, last or at `index` (from 1), made with `settings`:
  --- its parameters by name, and whatever the kind is made with.
  insert: (self: AudioBus, kind: string, settings: { [string]: number | string }?) -> AudioProcessor,
}

--- A processor in a bus's chain. Once removed, the handle names nothing.
export type AudioProcessor = {
  kind: (self: AudioProcessor) -> string,
  --- Sets a parameter by name; a name it doesn't have, or a value out of range, is an error.
  set: (self: AudioProcessor, param: string, value: number, at: number?) -> boolean,
  --- Ramps a parameter to `value` over `frames` frames from `at`; it moves every 32 frames.
  ramp: (self: AudioProcessor, param: string, value: number, frames: number, at: number?, curve: AudioCurve?) -> boolean,
  --- Listens to `bus` (its sidechain key) from `at` instead of its own bus, or to its own again
  --- with nil. The key is mixed first; a key its own bus feeds is a loop, and an error.
  listen: (self: AudioProcessor, bus: AudioBus?, at: number?) -> boolean,
  remove: (self: AudioProcessor, at: number?) -> boolean,
  live: (self: AudioProcessor) -> boolean,
}

--- What a context's engine has done, as of its last render: `frames` rendered (the clock), voices
--- `active` in it and `allocated` (playing or waiting to start), commands carried out `late`
--- (stamped for a frame already rendered), output samples that weren't finite and were written as
--- silence (`nonfinite`), commands `pending` for a later frame, voices `culled` in the last block
--- for want of room, and voices `stolen`, ended for it, all told.
export type AudioStats = {
  frames: number,
  active: number,
  allocated: number,
  late: number,
  nonfinite: number,
  pending: number,
  culled: number,
  stolen: number,
}

export type AudioVoiceState = 'scheduled' | 'playing' | 'ended'

--- One playback of a Pcm. Every command takes an optional `at`, an output frame to carry it out
--- on; without one, the next frame rendered. Once the voice ends the handle names nothing, and
--- its commands do nothing and return false.
export type AudioVoice = {
  --- Stops it on frame `at`, fading out over `fade` frames first (0).
  stop: (self: AudioVoice, at: number?, fade: number?) -> boolean,
  set: (self: AudioVoice, param: 'gain' | 'pan' | 'rate', value: number, at: number?) -> boolean,
  --- Ramps a parameter to `value` over `frames` frames from `at`, sample by sample.
  ramp: (
    self: AudioVoice,
    param: 'gain' | 'pan' | 'rate',
    value: number,
    frames: number,
    at: number?,
    curve: AudioCurve?
  ) -> boolean,
  --- Loops over source frames `start` up to `stop` from `at`: playback reaching `stop` goes on at
  --- `start`.
  loop: (self: AudioVoice, start: number, stop: number, at: number?) -> boolean,
  --- Lets go of the loop from `at`: playback runs on past it, into whatever follows (an outro).
  release: (self: AudioVoice, at: number?) -> boolean,
  --- Moves a voice in space from `at`, changing the fields given; false for a voice not in space.
  place: (self: AudioVoice, place: AudioPlace, at: number?) -> boolean,
  --- Changes the level of a send it started with.
  send: (self: AudioVoice, bus: AudioBus, level: number, at: number?) -> boolean,
  state: (self: AudioVoice) -> AudioVoiceState,
}

--- An audio context: voices mixed on a sample clock. The clock is output frames rendered, and
--- moves only when the engine renders.
export type AudioContext = {
  rate: (self: AudioContext) -> number,
  channels: (self: AudioContext) -> number,
  --- The next frame the engine renders. A command stamped for it or later lands on its frame.
  now: (self: AudioContext) -> number,
  --- Starts a voice playing decoded audio or a stream (which plays once, with no offset or loop).
  play: (self: AudioContext, source: AudioPcm | AudioStream, options: AudioPlayOptions?) -> AudioVoice,
  --- The master bus: the output. It has no parent and is never removed.
  master: (self: AudioContext) -> AudioBus,
  --- A bus under `parent` (the master), at `gain` (1), muted or not; voices can play into it at once.
  bus: (self: AudioContext, options: { parent: AudioBus?, gain: number?, muted: boolean? }?) -> AudioBus,
  --- Renders `frames` frames and returns them as interleaved 32-bit floats.
  render: (self: AudioContext, frames: number) -> buffer,
  stats: (self: AudioContext) -> AudioStats,
  --- Moves the listener from `at`, changing the fields given. It starts at the origin facing
  --- `-z` with `y` up, still.
  listener: (self: AudioContext, listener: AudioListener, at: number?) -> (),
  --- The device rendering an output, or nil for an offline context.
  device: (self: AudioContext) -> AudioDevice?,
  --- Stops an output's device and drops every voice it played; commands after it are errors.
  --- An output plays until it is closed or its runtime ends, held or not.
  close: (self: AudioContext) -> (),
  --- How many more commands the queue to the engine has room for.
  room: (self: AudioContext) -> number,
  --- Runs `body`, and sends every command it makes to the engine together: ones not stamped for
  --- later are carried out on the same frame. Groups don't nest.
  group: (self: AudioContext, body: () -> ()) -> (),
}

--- A shader type, from `jess.shader` (`float`, `vec2`, `vec3`, `vec4`, `mat3`, `mat4`,
--- `texture2d`, `sampler`): what a program's `parameters` and `textures` declare
--- (`tint = shader.vec4`). Called, the vector types build a vector from values and numbers whose
--- sizes add up to theirs, or from one number repeated (`shader.vec4(position, 1)`), and
--- `shader.float(0.5)` is a `Float` constant; the other types can't be constructed. `tostring`
--- gives the type's name (`Vec4f`).
declare extern type ShaderType with
  __call: (self: ShaderType, ...ShaderExpr | number) -> ShaderExpr
  __tostring: (self: ShaderType) -> string
end

--- A symbolic, typed value in the shader program under construction: not a number, and not a GPU
--- value. Operators append expressions to the program and return new values; a bare number
--- beside one is a `Float`. `.x`, `.xyz`, `.zyx`: a swizzle of one to four of `x`, `y`, `z`, and
--- `w`, the only names a value has. A mistake fails at the line that made it, with the types
--- involved. `tostring` gives `ShaderExpr(Vec4f)`, and `==` whether two handles name one
--- expression. A value is only usable while its `shader.program` call runs.
declare extern type ShaderExpr with
  [string]: ShaderExpr
  __add: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __sub: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __mul: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __div: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __eq: (self: ShaderExpr, other: ShaderExpr) -> boolean
  __tostring: (self: ShaderExpr) -> string
end

--- A stage function's input. Every name is a declared parameter or texture, a semantic input
--- (`model`, `view`, `projection`: `Mat4f`; `cameraPosition`: `Vec3f`; `viewportSize`: `Vec2f`;
--- `time`: `Float`), or, in the vertex function, a vertex attribute (`position` and `normal`:
--- `Vec3f`; `uv`: `Vec2f`; `color`: `Vec4f`) and, in the fragment function, a value the vertex
--- function returned. A name it doesn't have is an error listing the ones it does.
declare extern type ShaderInput with
  [string]: ShaderExpr
  __tostring: (self: ShaderInput) -> string
end

--- A finished, validated shader program: what a shader module returns, for jess to lower to the
--- backend. `tostring` gives `ShaderProgram(2 parameters, 1 texture, 2 varyings)`.
declare extern type ShaderProgram with
  --- The value parameters (not the textures and samplers), sorted by name, each with its type's
  --- name (`Vec4f`).
  parameters: { { name: string, type: string } }
  --- The texture names, each declared with a sampler of the same name.
  textures: { string }
  --- What the vertex function returned besides `position`, sorted by name, as the fragment
  --- function reads it.
  varyings: { { name: string, type: string } }
  __tostring: (self: ShaderProgram) -> string
end

--- What `shader.program` takes. `parameters` are values (`float`, the vectors, the matrices, and
--- `sampler`), `textures` are `texture2d`, each declared with a sampler of the same name; both
--- are declared sorted by name. Neither may be named like a semantic input or a vertex attribute.
--- `vertex` returns `position` (a `Vec4f`) and the values to pass to the fragment stage, each
--- named; `fragment` returns the `Vec4f` color. Both run once, while `shader.program` runs.
export type ShaderProgramSpec = {
  parameters: { [string]: ShaderType }?,
  textures: { [string]: ShaderType }?,
  vertex: (input: ShaderInput) -> { [string]: ShaderExpr },
  fragment: (input: ShaderInput) -> ShaderExpr,
}

--- The arguments after the script's name, as strings, for a script `jess run` runs from a file;
--- `arg[0]` is the script's path. They're the script's `...` too.
declare arg: { [number]: string }

--- `jess.shader`, and what `require("@jess/shader")` returns. A shader module runs once and
--- returns `shader.program { ... }`. Every function takes shader values or numbers (a number is
--- a `Float`) and fails at its line, in shader terms, when the types don't fit:
--- `dot(Vec3f, Vec4f) is invalid: expected two float vectors of the same size`.
export type ShaderModule = {
  float: ShaderType,
  vec2: ShaderType,
  vec3: ShaderType,
  vec4: ShaderType,
  mat3: ShaderType,
  mat4: ShaderType,
  texture2d: ShaderType,
  sampler: ShaderType,
  --- Builds a program: declares the parameters and textures, runs `vertex` and passes what it
  --- returned to the fragment stage, runs `fragment`, then validates the whole program, listing
  --- every problem with its line.
  program: (spec: ShaderProgramSpec) -> ShaderProgram,
  --- The smaller and larger of two values, per component.
  min: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  max: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  --- `value` clamped to `low..high`, per component.
  clamp: (value: ShaderExpr | number, low: ShaderExpr | number, high: ShaderExpr | number) -> ShaderExpr,
  --- The dot product of two vectors of one size, and the cross product of two `Vec3f`.
  dot: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  cross: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  --- A vector scaled to length 1, and a vector's length (a `Float`'s absolute value).
  normalize: (value: ShaderExpr | number) -> ShaderExpr,
  length: (value: ShaderExpr | number) -> ShaderExpr,
  --- The greatest integer no larger than a float or each component of a float vector.
  floor: (value: ShaderExpr | number) -> ShaderExpr,
  --- `start + (finish - start) * amount`, per component.
  mix: (start: ShaderExpr | number, finish: ShaderExpr | number, amount: ShaderExpr | number) -> ShaderExpr,
  --- A texture read, a `Vec4f`: a texture from `textures` with the sampler declared with it and
  --- `Vec2f` coordinates, or any texture, a sampler, and coordinates. Fragment stage only.
  sample: ((texture: ShaderExpr, coordinates: ShaderExpr) -> ShaderExpr) & ((texture: ShaderExpr, sampler: ShaderExpr, coordinates: ShaderExpr) -> ShaderExpr),
}

declare jess: {
  version: string,
  --- What a measurement needs from the host.
  bench: {
    --- Whether this jess was built with the verified toolchain, as releases are. A number from
    --- any other build measures a slower Luau, so a harness refuses to produce one.
    verified: boolean,
    --- Runs a full garbage collection, so one batch's garbage isn't collected inside the next
    --- one's timing.
    collect: () -> (),
  },
  --- A missing value inside an array (such as an empty link in a node's children), where `nil`
  --- would shift everything after it.
  null: JessNull,
  --- Whether the running code holds `capability` (`'process.environment'`, `'network.transport'`,
  --- ...): the runtime's grant, or under a ScriptDomain the broker's. Asking is no denial. A name
  --- no jess runtime can be granted raises, so a misspelling isn't read as "not granted".
  granted: (capability: string) -> boolean,
  --- The calling module's own package payload: every file's path in canonical order
  --- (`jess.toml` first), and a read of one file's bytes, nil for a path the payload lacks. A
  --- package shares its files by exporting a module that hands them out. A script belongs to no
  --- package and raises.
  payload: () -> { files: { string }, read: (path: string) -> buffer? },
  --- Typed shader construction; `require("@jess/shader")` is the same table.
  shader: ShaderModule,

  --- Script contexts (`@jess/context`): binds handlers to the phases the host scheduled for a
  --- context it declared. Only a runtime a ScriptDomain owns has contexts; elsewhere `bind` errors.
  context: {
    --- Binds one handler per phase name (`startup`, `update`, `fixedUpdate`, `event`,
    --- `shutdown`, ...) to the context `name`; a phase the context doesn't schedule is an error.
    bind: (name: string, handlers: ContextHandlers) -> (),
  },

  --- Workers (`@jess/worker`): isolated Luau states beside the domain, talking in messages.
  worker: {
    --- Spawns a worker from its module source, a chunk returning the message handler; needs the
    --- `worker.spawn` capability, and the worker holds `capabilities` (the spawner's, by default).
    --- With `shareServices`, it sees the domain's services too (its live input).
    spawn: (options: WorkerOptions) -> Worker,
    --- From inside a worker: sends a message to the domain, besides what the handler returns.
    send: (message: unknown) -> (),
  },

  --- Named events (`@jess/events`): application-defined events for the handlers bound to a name
  --- (a managed module's `on.event`). Only a domain's own code emits; elsewhere `emit` errors.
  events: {
    --- Queues the event `name` with `payload`, which must be transferable (no functions,
    --- userdata, or tables nested past 32 deep). Nothing runs now: every handler bound to the
    --- name gets it at the domain's next event drain, in the order events were emitted.
    emit: (name: string, payload: unknown?) -> (),
  },

  --- The domain's interfaces (`@jess/interfaces`): plain tables the application's packages
  --- provide through `[managed]` modules, composed before the application's entry runs. They are
  --- this domain's alone; a worker, another domain, or a runtime outside one has none.
  interfaces: {
    --- The effective implementation of the interface `id`, the table the last provider in load
    --- order returned; an error naming the ids the domain has when no package provides it.
    get: (id: string) -> any,
    --- The same, or nil when no package provides `id`: for an interface that is optional.
    tryGet: (id: string) -> any?,
  },

  --- What a script asks of the host running it (`@jess/application`). Only a domain's own code
  --- under a host asks; elsewhere `exit` errors.
  application: {
    --- Asks the host to stop with `status` (0 without one, an integer up to 255) after the
    --- current frame. Shutdown handlers still run; a later call replaces the status.
    exit: (status: number?) -> (),
  },

  --- The native half of `@jess/input`, which wraps it: compiling a binding document and the
  --- input runtime. See `jess::input`.
  input: {
    --- Compiles and validates a binding document, as JSON; every problem is reported at once.
    graph: (json: string) -> InputGraph,
    --- The binding document format version this jess reads and writes.
    formatVersion: number,
    --- A control's canonical `class:Name` form, or an error naming what is wrong with it.
    control: (control: string) -> string,
    --- The domain's live input runtime under a host; a headless one of the script's own otherwise.
    runtime: () -> InputRuntime,
  },

  --- The native half of `@jess/audio`, which wraps it: PCM from interleaved bytes, and contexts
  --- that mix voices on a sample clock. See `jess::audio`.
  audio: {
    --- PCM from interleaved bytes, `channels` samples per frame, each stored as `format`.
    pcm: (data: buffer | string, options: { format: AudioSampleFormat, channels: number, rate: number }) -> AudioPcm,
    --- A context the script renders.
    offline: (options: AudioContextOptions?) -> AudioContext,
    --- A context an output device renders: the default one, or `null`, which plays to nowhere in
    --- real time. It runs at the device's own rate unless `rate` asks for another, and asks for
    --- `period` frames at a time as a hint. Needs `audio.output`, and a jess built with the
    --- audio-device feature.
    output: (options: AudioOutputOptions?) -> AudioContext,
    --- A stream of `channels` (2) at `rate` (48000) holding `seconds` (1, at most 60) of frames; or,
    --- given a stream's handle, the stream itself, in whatever worker the handle was sent to.
    stream: (options: { channels: number?, rate: number?, seconds: number? } | JessHandle) -> AudioStream,
    --- The processor kinds `AudioBus:insert` makes.
    processors: () -> { string },
  },
}
