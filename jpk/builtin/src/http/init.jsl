--!strict
-- @jess/http: an HTTP/1.1 client over @jess/net. Any method, any header fields, a body from a
-- string, a buffer or a table sent as JSON; one connection per request and nothing kept between
-- requests; redirects followed one hop at a time under the same rules as the first request; the
-- body and the whole request bounded. In a @jess/net task a request waits the way the task's
-- other work does, so the loop and everything on it keep running; called anywhere else it runs on
-- a loop of its own and returns when it is done. It is the client jess's own package distribution
-- fetches with. It holds no authority of its own: resolving needs network.dns.resolve and
-- connecting needs network.tcp.connect, both the runtime's to grant.
local bytes = require '@dream/bytes'
local json = require '@jess/json'
local net = require '@jess/net'

type NetConnection = net.Connection

export type Headers = { [string]: string }

export type Url = {
  scheme: 'http' | 'https',
  host: string,
  port: number,
  --- The path and query, as sent on the request line; `/` at least.
  target: string,
}

export type Response = {
  status: number,
  reason: string,
  --- Field names lower-cased; repeated fields joined with `, `.
  headers: Headers,
  body: buffer,
  --- Where the body came from, after redirects.
  url: string,
  --- Every URL that answered with a redirect, in order.
  redirects: { string },
}

export type Options = {
  --- `GET` unless given; any HTTP method token.
  method: string?,
  --- Request header fields beyond Host, Connection and Content-Length, which the client writes.
  headers: Headers?,
  body: (string | buffer)?,
  --- A table sent as the body, as JSON (`@jess/json`'s `encodeTable`), with
  --- `Content-Type: application/json` unless the headers name one.
  json: unknown?,
  --- The most body bytes accepted; more is `tooLarge`. 16 MiB unless given.
  maxBytes: number?,
  --- For the whole request, redirects included. 30 seconds unless given.
  timeoutMs: number?,
  --- Redirect hops followed. 5 unless given; 0 returns the redirect as the response.
  maxRedirects: number?,
  --- What a redirect to another origin may do: `follow` (the default) goes on with only fields
  --- that carry no credentials (Accept, User-Agent and the cache and range fields) and never with a
  --- body; `refuse` fails it as `crossOriginRedirect`.
  crossOriginRedirects: ('follow' | 'refuse')?,
  --- Ask for gzip and deflate and decode them, within `maxBytes`. On unless false.
  decompress: boolean?,
  --- TLS client settings; the platform's trust store unless given.
  tls: dream_tls_ClientConfig?,
}

export type Request = {
  url: string,
  method: string?,
  headers: Headers?,
  body: (string | buffer)?,
  json: unknown?,
  maxBytes: number?,
  timeoutMs: number?,
  maxRedirects: number?,
  crossOriginRedirects: ('follow' | 'refuse')?,
  decompress: boolean?,
  tls: dream_tls_ClientConfig?,
}

--- A request whose body is read as it arrives: `request`'s fields but `decompress`, with
--- `maxBytes` bounding the whole body only when given, `timeoutMs` bounding the request until its
--- head arrives, and `readTimeoutMs` (30 seconds) bounding each read that names no deadline.
export type OpenRequest = {
  url: string,
  method: string?,
  headers: Headers?,
  body: (string | buffer)?,
  json: unknown?,
  maxBytes: number?,
  timeoutMs: number?,
  readTimeoutMs: number?,
  maxRedirects: number?,
  crossOriginRedirects: ('follow' | 'refuse')?,
  tls: dream_tls_ClientConfig?,
}

--- A response whose body is still on the connection.
export type Stream = {
  status: number,
  reason: string,
  headers: Headers,
  url: string,
  redirects: { string },
  --- True once `read` has returned the body's end, or the stream was closed.
  ended: boolean,
  --- The next piece of the body, as much as has arrived up to 64 KiB; nil and no message at its
  --- end, or nil, a message and the kind when it can't be read.
  read: (self: Stream, deadline: number?) -> (string?, string?, ErrorKind?),
  --- Stops reading. The connection is closed, or, under a client, kept when the body was read to
  --- its end. Closing twice does nothing.
  close: (self: Stream) -> (),
}

export type ClientOptions = {
  --- Connections open to one origin at once, idle or busy. 4 unless given; a request past it waits
  --- for one to come back.
  maxConnectionsPerOrigin: number?,
  --- How long a connection may sit idle before it is closed instead of reused. 30 seconds unless
  --- given.
  idleTimeoutMs: number?,
  --- TLS client settings for every connection the client makes.
  tls: dream_tls_ClientConfig?,
}

export type ClientStats = {
  --- Connections open and waiting for a request.
  idle: number,
  --- Connections carrying a request or a stream now.
  busy: number,
}

--- Requests that keep their connections open for the next: `request`, `get` and `open` as the
--- module has them, from tasks on one loop, without `tls` (the client's own settings serve).
export type Client = {
  request: (self: Client, request: Request) -> (Response?, string?, ErrorKind?),
  get: (self: Client, url: string, options: Options?) -> (Response?, string?, ErrorKind?),
  open: (self: Client, request: OpenRequest) -> (Stream?, string?, ErrorKind?),
  stats: (self: Client) -> ClientStats,
  --- Closes every idle connection now, and every busy one as its request ends. Closing twice does
  --- nothing.
  close: (self: Client) -> (),
  closed: boolean,
}

export type UpgradeRequest = {
  url: string,
  --- The protocol asked for in the Upgrade field, `websocket` say.
  protocol: string,
  headers: Headers?,
  --- The most body bytes read from a response that refuses the upgrade.
  maxBytes: number?,
  --- For the connection and the response head.
  timeoutMs: number?,
  tls: dream_tls_ClientConfig?,
}

export type ErrorKind =
  'invalidUrl'
  | 'unsupportedScheme'
  | 'credentialsInUrl'
  | 'resolve'
  | 'connect'
  | 'tls'
  | 'timeout'
  | 'protocol'
  | 'tooLarge'
  | 'tooManyRedirects'
  | 'closed'
  | 'cancelled'
  | 'limitReached'
  | 'upgrade'
  | 'crossOriginRedirect'

local Name = 'jess.http'
local DefaultMaxBytes = 16 * 1024 * 1024
local DefaultTimeoutMs = 30000
local DefaultMaxRedirects = 5
--- The status line and every header field together, and the trailer fields after a chunked body.
local MaxHeadBytes = 64 * 1024
--- A chunk size line, extensions and all.
local MaxChunkLine = 4096
local ReadChunk = 65536
local UserAgent = 'jess/0.1.0 (+https://github.com/DreamWeave-MP/jess)'
local Token = "^[!#$%%&'*+.^_`|~%w-]+$"
local OptionNames = {
  'method',
  'headers',
  'body',
  'json',
  'maxBytes',
  'timeoutMs',
  'maxRedirects',
  'crossOriginRedirects',
  'decompress',
  'tls',
}

local OpenOptionNames = {
  'method',
  'headers',
  'body',
  'json',
  'maxBytes',
  'timeoutMs',
  'readTimeoutMs',
  'maxRedirects',
  'crossOriginRedirects',
  'tls',
}

--- What a client's requests take: everything but `tls`, which is the client's.
local ClientOptionNames: { string } = [for name in OptionNames if name ~= 'tls' => name]
local ClientOpenOptionNames: { string } = [for name in OpenOptionNames if name ~= 'tls' => name]

--- Fields the client writes itself; a caller's value for one would contradict the framing.
local Reserved: { [string]: boolean } = {
  host = true,
  ['content-length'] = true,
  ['transfer-encoding'] = true,
  connection = true,
  upgrade = true,
}

--- The only fields a request carries on to another origin when a redirect leaves the one it was
--- given for. Everything else (Authorization, Cookie, an API key under any name) was written for
--- that origin, and stays with it for the rest of the chain.
local CrossOriginFields: { [string]: boolean } = {
  accept = true,
  ['accept-encoding'] = true,
  ['accept-language'] = true,
  ['cache-control'] = true,
  ['if-modified-since'] = true,
  ['if-none-match'] = true,
  range = true,
  ['user-agent'] = true,
}

local Redirects: { [number]: boolean } = { [301] = true, [302] = true, [303] = true, [307] = true, [308] = true }

--- `url` as a message may name it: up to its query, which is where some APIs put their keys.
local function unqueried(url: string): string return string.match(url, '^[^?#]*') or '' end

--- `value` as a whole number from `low` to `high`, or an error naming the option.
local function whole(value: number, low: number, high: number, what: string, name: string): number
  if type(value) ~= 'number' or value ~= math.floor(value) or value < low or value > high then
    error(`{Name}.{what}: {name} is a whole number from {low} to {high}, not {value}`, 0)
  end

  return value
end

--- `value` as a span of milliseconds: finite and above zero.
local function duration(value: number, what: string, name: string): number
  if type(value) ~= 'number' or value ~= value or value <= 0 or value == math.huge then
    error(`{Name}.{what}: {name} is a finite number of milliseconds above 0, not {value}`, 0)
  end

  return value
end

--- `url` taken apart, or nil and why. Only http and https, no user name or password, no fragment.
--- A space, a control character, or a byte past ASCII outside the host is refused rather than
--- encoded: the target goes on the request line as it is, and a line break there would be a
--- header the caller never wrote.
local function parseUrl(url: string): (Url?, string?, ErrorKind?)
  if type(url) ~= 'string' then return nil, 'a URL is a string', 'invalidUrl' end

  if string.find(url, '[%c ]') then
    return nil, 'the URL holds a space or a control character; percent-encode it', 'invalidUrl'
  end

  local scheme, rest = string.match(url, '^(%a[%w+.-]*)://(.*)$')
  if not scheme or not rest then return nil, `'{unqueried(url)}' is not an absolute URL`, 'invalidUrl' end

  local lowered = string.lower(scheme :: string)
  if lowered ~= 'http' and lowered ~= 'https' then
    return nil, `{scheme}: URLs are not fetched, only http and https`, 'unsupportedScheme'
  end

  local text = rest :: string
  local hash = string.find(text, '#', 1, true)
  if hash then text = string.sub(text, 1, hash - 1) end

  local authority, target = string.match(text, '^([^/?]*)(.*)$')
  local named = unqueried(url)
  if not authority or authority == '' then return nil, `'{named}' has no host`, 'invalidUrl' end

  if string.find(authority :: string, '@', 1, true) then
    return nil, 'the URL carries a user name or password', 'credentialsInUrl'
  end

  local host, port: string?
  local bracketed, afterBracket = string.match(authority :: string, '^%[([%x:.]+)%](.*)$')
  if bracketed then
    host = `[{bracketed}]`
    port = string.match(afterBracket :: string, '^:(%d+)$')
    if afterBracket ~= '' and not port then return nil, `'{named}' has a malformed port`, 'invalidUrl' end
  else
    -- Letters, digits, dots, hyphens and underscores, or the bytes of a name past ASCII, which
    -- the resolver maps to its A-labels.
    local name, portText = string.match(authority :: string, '^([%w._\128-\255-]+):?(%d*)$')
    if not name then return nil, `'{named}' has a malformed host`, 'invalidUrl' end

    host = name :: string
    if portText ~= '' then port = portText end
  end

  local portNumber = if port then tonumber(port) else if lowered == 'https' then 443 else 80
  if not portNumber or portNumber < 1 or portNumber > 65535 then
    return nil, `'{named}' has a port outside 1 to 65535`, 'invalidUrl'
  end

  if string.find(target :: string, '[\128-\255]') then
    return nil, `'{named}' has a path or query past ASCII; percent-encode it`, 'invalidUrl'
  end

  local path = target :: string
  if path == '' or string.sub(path, 1, 1) == '?' then path = `/{path}` end

  return {
    scheme = lowered :: 'http' | 'https',
    host = string.lower(host),
    port = portNumber :: number,
    target = path,
  },
    nil,
    nil
end

--- `reference` against `base` as RFC 3986 resolves a Location header: absolute as is,
--- `//host/path` under the base's scheme, `/path` on the base's host, `?query` on the base's
--- path, an empty reference or `#fragment` as the base itself, and anything else appended to the
--- base's directory, with `.` and `..` folded.
local function resolveReference(base: string, reference: string): string?
  if string.match(reference, '^%a[%w+.-]*://') then return reference end

  local scheme, authority, basePath, baseQuery = string.match(base, '^(%a[%w+.-]*)://([^/?#]*)([^?#]*)([^#]*)')
  if not scheme then return nil end

  if string.sub(reference, 1, 2) == '//' then return `{scheme}:{reference}` end

  local origin = `{scheme}://{authority}`
  local first = string.sub(reference, 1, 1)
  if reference == '' or first == '#' then return `{origin}{basePath}{baseQuery}{reference}` end
  if first == '?' then return `{origin}{basePath}{reference}` end

  local path = reference
  if string.sub(reference, 1, 1) ~= '/' then
    local directory = string.match(basePath :: string, '^(.*/)') or '/'
    path = `{directory}{reference}`
  end

  local pathOnly, suffix = string.match(path, '^([^?#]*)(.*)$')
  local segments: { string } = {}
  for segment in string.gmatch(pathOnly :: string, '[^/]*') do
    if segment == '..' then
      table.remove(segments)
    elseif segment ~= '.' and segment ~= '' then
      table.insert(segments, segment)
    end
  end

  local plainPath = pathOnly :: string
  local trailing = #plainPath == 0 or string.find(plainPath, '[/.]$') ~= nil
  local joined = `/{table.concat(segments, '/')}`
  local folded = if trailing and joined ~= '/' then `{joined}/` else joined

  return `{origin}{folded}{suffix}`
end

local function origin(url: Url): string return `{url.scheme}://{url.host}:{url.port}` end

--- `url` as error messages name it: without its query, which is where some APIs put their keys.
local function describe(url: Url): string
  local path = string.match(url.target, '^[^?]*') or '/'

  return `{url.scheme}://{url.host}:{url.port}{path}`
end

local function netKind(kind: string?): ErrorKind
  if kind == 'resolve' or kind == 'connect' or kind == 'tls' or kind == 'timeout' or kind == 'cancelled' then
    return kind :: ErrorKind
  end

  if kind == 'limitReached' then return 'limitReached' end

  return 'closed'
end

type Head = { version: string, status: number, reason: string, headers: Headers }

local function parseHead(text: string): (Head?, string?)
  local lines = string.split(text, '\r\n')
  local version, status, reason = string.match(lines[1], '^HTTP/(1%.[01]) (%d%d%d) ?(.*)$')
  if not version then return nil, `not an HTTP/1.x status line: '{string.sub(lines[1], 1, 80)}'` end

  local headers: Headers = {}
  for index = 2, #lines do
    local line = lines[index]
    if string.find(line, '^[ \t]') then return nil, 'a header field is folded over lines' end

    local name, value = string.match(line, "^([!#$%%&'*+.^_`|~%w-]+):[ \t]*(.-)[ \t]*$")
    if not name then return nil, `malformed header field: '{string.sub(line, 1, 80)}'` end

    local key = string.lower(name :: string)
    headers[key] = if headers[key] then `{headers[key]}, {value}` else value :: string
  end

  return { version = version :: string, status = tonumber(status) :: number, reason = reason :: string, headers = headers }, nil
end

--- A body under construction: the bytes, and how many of them are the body so far.
type Sink = { data: buffer, length: number }

local function reserve(sink: Sink, extra: number)
  local needed = sink.length + extra
  if needed <= buffer.len(sink.data) then return end

  local capacity = math.max(buffer.len(sink.data), ReadChunk)
  while capacity < needed do
    capacity *= 2
  end

  local grown = buffer.create(capacity)
  buffer.copy(grown, 0, sink.data, 0, sink.length)
  sink.data = grown
end

local function finished(sink: Sink): buffer
  if buffer.len(sink.data) == sink.length then return sink.data end

  local body = buffer.create(sink.length)
  buffer.copy(body, 0, sink.data, 0, sink.length)

  return body
end

--- The size a chunk size line declares, or nil when the line is anything but RFC 9112's
--- `chunk-size *( BWS ";" BWS name [ BWS "=" BWS ( token / quoted-string ) ] )`, a size of at
--- most twelve hex digits. Extensions are checked and ignored.
local function chunkSize(line: string): number?
  local digits, rest = string.match(line, '^(%x+)(.*)$')
  if not digits or #digits > 12 then return nil end

  local remaining = rest :: string
  while remaining ~= '' do
    local afterName = string.match(remaining, "^[ \t]*;[ \t]*[!#$%%&'*+.^_`|~%w-]+(.*)$")
    if not afterName then return nil end

    remaining = afterName :: string
    local afterEquals = string.match(remaining, '^[ \t]*=[ \t]*(.*)$')
    if not afterEquals then continue end

    remaining = afterEquals :: string
    local afterToken = string.match(remaining, "^[!#$%%&'*+.^_`|~%w-]+(.*)$")
    if afterToken then
      remaining = afterToken :: string
      continue
    end

    if string.sub(remaining, 1, 1) ~= '"' then return nil end

    -- A quoted string: any byte but a quote or a backslash, or a backslash and the byte it escapes.
    local at = 2
    while true do
      local byte = string.sub(remaining, at, at)
      if byte == '' then return nil end

      if byte == '"' then break end
      if byte ~= '\t' and string.find(byte, '%c') then return nil end

      at += if byte == '\\' then 2 else 1
    end

    remaining = string.sub(remaining, at + 1)
  end

  return tonumber(digits, 16)
end

--- The body's length from Content-Length, which may repeat but never disagree with itself.
local function declaredLength(value: string): number?
  local length: number?
  for item in string.gmatch(value, '[^,]+') do
    local digits = string.match(item, '^%s*(%d+)%s*$')
    if not digits or #digits > 15 then return nil end

    local parsed = tonumber(digits) :: number
    if length and length ~= parsed then return nil end

    length = parsed
  end

  return length
end

--- A response body on its connection: how it is framed, and how far reading it has got.
type Body = {
  connection: NetConnection,
  --- `none` for a bodiless response, `length` for Content-Length, `chunked`, or `close` for a body
  --- that runs until the connection ends.
  framing: 'none' | 'length' | 'chunked' | 'close',
  --- Bytes left: of the whole body for `length`, of the current chunk for `chunked`.
  remaining: number,
  --- Whether a chunk's data has all been read and the CRLF after it hasn't.
  owesCrlf: boolean,
  done: boolean,
  --- Body bytes handed out so far, and the most there may be.
  delivered: number,
  limit: number,
}

local function bodyFailure(problem: string?, kind: string?): (nil, string, ErrorKind)
  if kind == 'closed' then return nil, 'the connection closed before the body ended', 'closed' end

  if kind == 'truncated' then
    return nil, 'the connection ended without TLS close_notify, so the body may be cut short', 'closed'
  end

  return nil, `reading the body failed: {problem}`, netKind(kind)
end

--- How `head`'s body is framed on `connection`, or nil and why it can't be read.
local function bodyOf(connection: NetConnection, head: Head, method: string, limit: number): (Body?, string?, ErrorKind?)
  local body: Body = {
    connection = connection,
    framing = 'none',
    remaining = 0,
    owesCrlf = false,
    done = false,
    delivered = 0,
    limit = limit,
  }

  local status = head.status
  if method == 'HEAD' or status == 101 or status == 204 or status == 304 then
    body.done = true
    return body, nil, nil
  end

  local encoding = head.headers['transfer-encoding']
  if encoding then
    local codings = string.split(string.lower(encoding), ',')
    local last = string.match(codings[#codings], '^%s*(.-)%s*$')
    body.framing = if last == 'chunked' then 'chunked' else 'close'
    return body, nil, nil
  end

  local declared = head.headers['content-length']
  if not declared then
    body.framing = 'close'
    return body, nil, nil
  end

  local expected = declaredLength(declared)
  if not expected then return nil, 'Content-Length is not a length', 'protocol' end

  if expected > limit then
    return nil, `the response body is {expected} bytes, more than the {limit} allowed`, 'tooLarge'
  end

  body.framing, body.remaining = 'length', expected
  body.done = expected == 0

  return body, nil, nil
end

--- Reads the trailer fields after a chunked body, which nothing here keeps.
local function skipTrailers(connection: NetConnection, deadline: number?): (boolean, string?, ErrorKind?)
  local trailers = 0
  while true do
    local line, problem, kind = connection:receiveUntil('\r\n', MaxHeadBytes, deadline)
    if not line then
      local _, message, failure = bodyFailure(problem, kind)
      return false, message, failure
    end

    if line == '' then return true, nil, nil end

    trailers += #line
    if trailers > MaxHeadBytes then return false, `the trailer is longer than {MaxHeadBytes} bytes`, 'protocol' end
  end
end

--- The next piece of `body`, at most `maxPiece` bytes, or nil and no message at its end.
local function nextPiece(body: Body, maxPiece: number, deadline: number?): (string?, string?, ErrorKind?)
  if body.done then return nil, nil, nil end

  local connection = body.connection
  local piece, problem, kind
  if body.framing == 'length' then
    piece, problem, kind = connection:receiveSome(math.min(maxPiece, body.remaining), deadline)
    if not piece then return bodyFailure(problem, kind) end

    body.remaining -= #piece
    body.done = body.remaining == 0
  elseif body.framing == 'chunked' then
    if body.remaining == 0 then
      if body.owesCrlf then
        local ending, endProblem, endKind = connection:receive(2, deadline)
        if not ending then return bodyFailure(endProblem, endKind) end

        if ending ~= '\r\n' then return nil, 'a chunk did not end with CRLF', 'protocol' end

        body.owesCrlf = false
      end

      local line, lineProblem, lineKind = connection:receiveUntil('\r\n', MaxChunkLine, deadline)
      if not line then
        if lineKind == 'limitReached' then return nil, 'a chunk size line is too long', 'protocol' end

        return bodyFailure(lineProblem, lineKind)
      end

      local size = chunkSize(line)
      if not size then return nil, 'a chunk size line is not a size and its extensions', 'protocol' end

      if size == 0 then
        local skipped, trailerProblem, trailerKind = skipTrailers(connection, deadline)
        if not skipped then return nil, trailerProblem, trailerKind end

        body.done = true
        return nil, nil, nil
      end

      body.remaining = size
    end

    piece, problem, kind = connection:receiveSome(math.min(maxPiece, body.remaining), deadline)
    if not piece then return bodyFailure(problem, kind) end

    body.remaining -= #piece
    body.owesCrlf = body.remaining == 0
  elseif body.framing == 'close' then
    piece, problem, kind = connection:receiveSome(maxPiece, deadline)
    if not piece then
      if kind == 'closed' then
        body.done = true
        return nil, nil, nil
      end

      return bodyFailure(problem, kind)
    end
  else
    body.done = true
    return nil, nil, nil
  end

  local text = piece :: string
  body.delivered += #text
  if body.delivered > body.limit then
    return nil, `the response body is larger than {body.limit} bytes`, 'tooLarge'
  end

  return text, nil, nil
end

--- The whole of `body`, within its limit.
local function readAll(body: Body, deadline: number?): (buffer?, string?, ErrorKind?)
  local sink: Sink = { data = buffer.create(0), length = 0 }
  if body.framing == 'length' then reserve(sink, body.remaining) end

  while true do
    local piece, problem, kind = nextPiece(body, ReadChunk, deadline)
    if not piece then
      if problem then return nil, problem, kind end

      return finished(sink), nil, nil
    end

    reserve(sink, #piece)
    buffer.writestring(sink.data, sink.length, piece)
    sink.length += #piece
  end
end

--- Whether `connection` may carry another request once `body` is read: its end was framed, and
--- neither side asked to close.
local function reusable(head: Head, body: Body): boolean
  if not body.done or body.framing == 'close' or head.version ~= '1.1' then return false end

  local field = string.lower(head.headers.connection or '')

  return not string.find(`,{field},`, ',%s*close%s*,')
end

--- `data` decoded by its Content-Encoding, within `limit`: gzip and deflate (zlib, or raw as some
--- servers send it), anything else as it came.
local function decode(data: buffer, encoding: string?, limit: number): (buffer?, string?, ErrorKind?)
  local coding = string.lower(string.match(encoding or '', '^%s*(.-)%s*$') or '')
  local formats: { string } = if coding == 'gzip' or coding == 'x-gzip'
    then { 'gzip' }
    elseif coding == 'deflate' then { 'zlib', 'raw' }
    else {}
  if #formats == 0 then return data, nil, nil end

  local lastProblem = 'it does not decode'
  for _, format in formats do
    local options: dream_bytes_DecompressOptions = { format = format, maxSize = limit }
    -- `bytes.inflate` throws on a stream that isn't one, and the body is the server's, not ours.
    local inflated, result = pcall(bytes.inflate, data, options)
    if inflated then return result :: buffer, nil, nil end

    lastProblem = tostring(result)
    if string.find(lastProblem, 'exceeds maxSize', 1, true) then
      return nil, `the decoded response body is larger than {limit} bytes`, 'tooLarge'
    end
  end

  return nil, `the {coding} response body does not decode: {lastProblem}`, 'protocol'
end

--- What a request will send, checked before anything touches the network.
type Plan = {
  url: string,
  method: string,
  headers: Headers,
  body: (string | buffer)?,
  maxBytes: number,
  timeoutMs: number,
  readTimeoutMs: number,
  maxRedirects: number,
  crossOriginRedirects: 'follow' | 'refuse',
  decompress: boolean,
  tls: dream_tls_ClientConfig?,
}

--- `headers` checked and with lower-cased names, refusing a field the client writes itself. Values
--- never reach a message: they are where credentials live.
local function checkHeaders(headers: Headers?, what: string): Headers
  local checked: Headers = {}
  for name, value in headers or {} do
    if not string.match(name, Token) then error(`{Name}.{what}: '{name}' is not a header field name`, 0) end

    if type(value) ~= 'string' or string.find(value, '[\r\n%z]') then
      error(`{Name}.{what}: header '{name}' needs a string value without line breaks`, 0)
    end

    local key = string.lower(name)
    if Reserved[key] then error(`{Name}.{what}: '{name}' is written by the client, not the caller`, 0) end

    checked[key] = value
  end

  return checked
end

local function plan(url: string, options: Options & OpenRequest, what: string, names: { string }): Plan
  for key in options :: { [string]: unknown } do
    if key ~= 'url' and not table.find(names, key) then
      error(`unknown {Name}.{what} option '{key}': expected {table.concat(names, ', ')}`, 0)
    end
  end

  if type(url) ~= 'string' then error(`{Name}.{what}: the URL is a string`, 0) end

  local method = options.method or 'GET'
  if not string.match(method, Token) then error(`{Name}.{what}: '{method}' is not an HTTP method`, 0) end

  local headers = checkHeaders(options.headers, what)
  local body = options.body
  if options.json ~= nil then
    if body then error(`{Name}.{what}: a request has a body or json, not both`, 0) end

    body = json.encodeTable(options.json)
    if not headers['content-type'] then headers['content-type'] = 'application/json' end
  end

  local crossOrigin = options.crossOriginRedirects or 'follow'
  if crossOrigin ~= 'follow' and crossOrigin ~= 'refuse' then
    error(`{Name}.{what}: crossOriginRedirects is 'follow' or 'refuse', not '{crossOrigin}'`, 0)
  end

  -- `false` turns decoding off; nil leaves it on for a buffered request.
  local decompress = options.decompress ~= false and table.find(names, 'decompress') ~= nil
  if decompress and not headers['accept-encoding'] then headers['accept-encoding'] = 'gzip, deflate' end

  local streamed = table.find(names, 'readTimeoutMs') ~= nil
  local maxBytes = options.maxBytes or (if streamed then nil else DefaultMaxBytes)

  return {
    url = url,
    method = method,
    headers = headers,
    body = body,
    maxBytes = if maxBytes then whole(maxBytes, 0, 2 ^ 53, what, 'maxBytes') else math.huge,
    timeoutMs = duration(options.timeoutMs or DefaultTimeoutMs, what, 'timeoutMs'),
    readTimeoutMs = duration(options.readTimeoutMs or DefaultTimeoutMs, what, 'readTimeoutMs'),
    maxRedirects = whole(options.maxRedirects or DefaultMaxRedirects, 0, 20, what, 'maxRedirects'),
    crossOriginRedirects = crossOrigin,
    decompress = decompress,
    tls = options.tls,
  }
end

local function bodyLength(body: (string | buffer)?): number?
  if not body then return nil end

  return if type(body) == 'string' then #body else buffer.len(body)
end

--- The request line and header fields, the caller's in name order so a request is the same bytes
--- every time.
local function requestHead(url: Url, method: string, headers: Headers, length: number?, connection: string): string
  local hostHeader = if (url.scheme == 'http' and url.port == 80) or (url.scheme == 'https' and url.port == 443)
    then url.host
    else `{url.host}:{url.port}`
  local lines = { `{method} {url.target} HTTP/1.1`, `host: {hostHeader}` }
  if not headers['user-agent'] then table.insert(lines, `user-agent: {UserAgent}`) end
  if not headers.accept then table.insert(lines, 'accept: */*') end

  local names: { string } = {}
  for name in headers do
    table.insert(names, name)
  end

  table.sort(names)
  for _, name in names do
    table.insert(lines, `{name}: {headers[name]}`)
  end

  table.insert(lines, `connection: {connection}`)
  if length or method == 'POST' or method == 'PUT' or method == 'PATCH' then
    table.insert(lines, `content-length: {length or 0}`)
  end

  return `{table.concat(lines, '\r\n')}\r\n\r\n`
end

--- Where a request gets its connection and where the connection goes after: a fresh one closed
--- after each request, or a client's pool.
type Transport = {
  --- A connection to `url`'s origin, and whether it carried a request before.
  acquire: (url: Url, deadline: number) -> (NetConnection?, boolean, string?, ErrorKind?),
  --- Hands `connection` back: kept for the next request when `keep` says it may be, closed
  --- otherwise.
  release: (url: Url, connection: NetConnection, keep: boolean) -> (),
  --- The Connection field requests on it carry.
  connectionField: string,
}

local function connectTo(url: Url, tlsConfig: dream_tls_ClientConfig?, deadline: number): (NetConnection?, string?, ErrorKind?)
  local connection, problem, kind = net.connect(url.host, url.port, {
    tls = url.scheme == 'https',
    tlsConfig = tlsConfig,
    alpn = { 'http/1.1' },
    deadline = deadline,
  })

  if not connection then return nil, problem, netKind(kind) end

  return connection, nil, nil
end

--- A transport that opens a connection for each request and closes it after.
local function oneShot(tlsConfig: dream_tls_ClientConfig?): Transport
  return {
    acquire = function(url: Url, deadline: number): (NetConnection?, boolean, string?, ErrorKind?)
      local connection, problem, kind = connectTo(url, tlsConfig, deadline)

      return connection, false, problem, kind
    end,
    release = function(_url: Url, connection: NetConnection, _keep: boolean) connection:close() end,
    connectionField = 'close',
  }
end

local function sendRequest(
  connection: NetConnection,
  url: Url,
  method: string,
  headers: Headers,
  body: (string | buffer)?,
  connectionField: string,
  deadline: number
): (boolean, string?, ErrorKind?)
  local head = requestHead(url, method, headers, bodyLength(body), connectionField)
  local sent, problem, kind = connection:send(head, deadline)
  if sent and body then sent, problem, kind = connection:send(body, deadline) end

  if not sent then return false, `sending the request failed: {problem}`, netKind(kind) end

  return true, nil, nil
end

--- The response head on `connection`, past any interim 1xx answers.
local function receiveHead(connection: NetConnection, deadline: number): (Head?, string?, ErrorKind?)
  while true do
    local text, problem, kind = connection:receiveUntil('\r\n\r\n', MaxHeadBytes, deadline)
    if not text then
      if kind == 'limitReached' then return nil, `the response head is longer than {MaxHeadBytes} bytes`, 'protocol' end
      if kind == 'closed' then return nil, 'the connection closed before the response head ended', 'closed' end

      return nil, `reading the response failed: {problem}`, netKind(kind)
    end

    local parsed, parseProblem = parseHead(text)
    if not parsed then return nil, parseProblem, 'protocol' end

    local head = parsed :: Head
    if head.status < 100 or head.status >= 200 or head.status == 101 then return head, nil, nil end
  end
end

local Idempotent: { [string]: boolean } =
  { GET = true, HEAD = true, PUT = true, DELETE = true, OPTIONS = true, TRACE = true }

--- One request on one hop: its head and its body on the connection, still to be read.
local function exchange(
  url: Url,
  method: string,
  headers: Headers,
  body: (string | buffer)?,
  settings: Plan,
  transport: Transport,
  deadline: number
): (Head?, Body?, string?, ErrorKind?)
  -- A connection kept from an earlier request may have been closed by the server while it waited.
  -- A request that met that before any answer arrived goes again once on a fresh connection, but
  -- only if going twice can't change anything: a send that failed may still have delivered the
  -- request, since the head and body go out separately and part of either may have arrived.
  for attempt = 1, 2 do
    local connection, reused, problem, kind = transport.acquire(url, deadline)
    if not connection then return nil, nil, problem, kind end

    local live = connection :: NetConnection
    local sent, sendProblem, sendKind = sendRequest(live, url, method, headers, body, transport.connectionField, deadline)
    if not sent then
      transport.release(url, live, false)
      if reused and attempt == 1 and Idempotent[method] then continue end

      return nil, nil, sendProblem, sendKind
    end

    local head, headProblem, headKind = receiveHead(live, deadline)
    if not head then
      transport.release(url, live, false)
      if reused and attempt == 1 and headKind == 'closed' and Idempotent[method] then continue end

      return nil, nil, headProblem, headKind
    end

    local framed, framingProblem, framingKind = bodyOf(live, head :: Head, method, settings.maxBytes)
    if not framed then
      transport.release(url, live, false)
      return nil, nil, framingProblem, framingKind
    end

    return head, framed, nil, nil
  end

  return nil, nil, 'the connection closed before the response head ended', 'closed'
end

--- Reads a body nobody will see (a redirect's) so its connection can be kept, as far as it is
--- small; anything larger costs the connection instead.
local function discard(head: Head, body: Body, url: Url, transport: Transport, deadline: number)
  for _ = 1, 16 do
    local piece = nextPiece(body, ReadChunk, deadline)
    if not piece then break end
  end

  transport.release(url, body.connection, reusable(head, body))
end

--- Follows `settings` through its redirects to the final response: its head and its body still on
--- the connection, with the URL that answered and those that redirected.
local function follow(settings: Plan, transport: Transport): (Head?, Body?, Url?, string, { string }, string?, ErrorKind?)
  local deadline = net.now() + settings.timeoutMs
  local redirects: { string } = {}
  local current, method, headers, body = settings.url, settings.method, table.clone(settings.headers), settings.body
  local secureSoFar = false
  local previous: Url?

  while true do
    local parsed, problem, kind = parseUrl(current)
    if not parsed then return nil, nil, nil, current, redirects, problem, kind end

    local target = parsed :: Url
    if secureSoFar and target.scheme == 'http' then
      local message = `a redirect from https to {describe(target)} would downgrade the connection`
      return nil, nil, nil, current, redirects, message, 'unsupportedScheme'
    end

    -- A request was written for one origin. Another gets none of its body, and none of its
    -- fields but the few that carry nothing of the caller's, from this hop to the end of the chain.
    if previous and origin(previous) ~= origin(target) then
      local leaving = `a redirect from {describe(previous)} to {describe(target)}`
      if settings.crossOriginRedirects == 'refuse' then
        local message = `{leaving} leaves the origin, and this request refuses that`
        return nil, nil, nil, current, redirects, message, 'crossOriginRedirect'
      end

      if body then
        local message = `{leaving} would carry the request body to another origin`
        return nil, nil, nil, current, redirects, message, 'crossOriginRedirect'
      end

      for name in headers do
        if not CrossOriginFields[name] then headers[name] = nil end
      end
    end

    secureSoFar = secureSoFar or target.scheme == 'https'
    previous = target

    local head, framed, failure, failureKind = exchange(target, method, headers, body, settings, transport, deadline)
    if not head then
      return nil, nil, nil, current, redirects, `{describe(target)}: {failure}`, failureKind
    end

    local response = head :: Head
    local location = response.headers.location
    if Redirects[response.status] and location and #redirects < settings.maxRedirects then
      discard(response, framed :: Body, target, transport, deadline)
      local next = resolveReference(current, location)
      if not next then
        local message = `{describe(target)}: a redirect does not resolve to a URL`
        return nil, nil, nil, current, redirects, message, 'protocol'
      end

      -- 303 always, and 301 and 302 after a POST as every client does, go on as a bodiless GET;
      -- 307 and 308 repeat the request as it was.
      local status = response.status
      if (status == 303 and method ~= 'HEAD') or ((status == 301 or status == 302) and method == 'POST') then
        method, body = 'GET', nil
        headers['content-type'] = nil
      end

      table.insert(redirects, current)
      current = next :: string
      continue
    end

    if Redirects[response.status] and location and settings.maxRedirects > 0 then
      transport.release(target, (framed :: Body).connection, false)
      local message = `{describe(target)}: more than {settings.maxRedirects} redirects`
      return nil, nil, nil, current, redirects, message, 'tooManyRedirects'
    end

    return response, framed, target, current, redirects, nil, nil
  end
end

--- `settings` performed in full: the response with its body read and decoded.
local function perform(settings: Plan, transport: Transport): (Response?, string?, ErrorKind?)
  local head, framed, target, url, redirects, problem, kind = follow(settings, transport)
  if not head then return nil, problem, kind end

  local response, body = head :: Head, framed :: Body
  local deadline = net.now() + settings.timeoutMs
  local data, readProblem, readKind = readAll(body, deadline)
  transport.release(target :: Url, body.connection, data ~= nil and reusable(response, body))
  if not data then return nil, `{describe(target :: Url)}: {readProblem}`, readKind end

  local decoded = data :: buffer
  if settings.decompress then
    local inflated, decodeProblem, decodeKind = decode(decoded, response.headers['content-encoding'], settings.maxBytes)
    if not inflated then return nil, `{describe(target :: Url)}: {decodeProblem}`, decodeKind end

    decoded = inflated :: buffer
  end

  return {
    status = response.status,
    reason = response.reason,
    headers = response.headers,
    body = decoded,
    url = url,
    redirects = redirects,
  },
    nil,
    nil
end

--- `settings` followed to its final head, the body left to read.
local function openStream(settings: Plan, transport: Transport): (Stream?, string?, ErrorKind?)
  local head, framed, target, url, redirects, problem, kind = follow(settings, transport)
  if not head then return nil, problem, kind end

  local response, body, answered = head :: Head, framed :: Body, target :: Url
  local released = false
  local stream: Stream

  local function release(keep: boolean)
    if released then return end

    released = true
    stream.ended = true
    transport.release(answered, body.connection, keep and reusable(response, body))
  end

  stream = {
    status = response.status,
    reason = response.reason,
    headers = response.headers,
    url = url,
    redirects = redirects,
    ended = false,
    read = function(_self: Stream, deadline: number?): (string?, string?, ErrorKind?)
      if released then return nil, nil, nil end

      local piece, readProblem, readKind = nextPiece(body, ReadChunk, deadline or net.now() + settings.readTimeoutMs)
      if piece then return piece, nil, nil end

      release(readProblem == nil)
      if readProblem then return nil, `{describe(answered)}: {readProblem}`, readKind end

      return nil, nil, nil
    end,
    close = function(_self: Stream) release(body.done) end,
  }

  if body.done then release(true) end

  return stream, nil, nil
end

--- `settings` performed in the running @jess/net task, or on a loop of its own outside one.
local function dispatch(settings: Plan): (Response?, string?, ErrorKind?)
  local transport = oneShot(settings.tls)
  if net.current() then return perform(settings, transport) end

  local response: Response?, message: string?, kind: ErrorKind?
  local completed, problem = net.run(function() response, message, kind = perform(settings, transport) end)
  if not completed then error(`{Name}: {problem}`, 0) end

  return response, message, kind
end

--- Performs `request`: the response, whatever its status, or nil, a message and the kind of
--- failure. Redirects are followed up to `maxRedirects` times, each hop checked as the first
--- request was, never from https to http, and never carrying a body or the caller's fields to
--- another origin. Every body byte is bounded by `maxBytes` and the whole by `timeoutMs`.
local function request(spec: Request): (Response?, string?, ErrorKind?)
  if type(spec) ~= 'table' then error(`{Name}.request: takes a request table with a url`, 0) end

  return dispatch(plan(spec.url, spec :: Options & OpenRequest, 'request', OptionNames))
end

--- `request` for `url`, with the rest of the request in `options`.
local function get(url: string, options: Options?): (Response?, string?, ErrorKind?)
  return dispatch(plan(url, (options or {}) :: Options & OpenRequest, 'get', OptionNames))
end

--- In a @jess/net task: `request`, returning as soon as the final head has arrived, with the body
--- left on the connection for the stream to read.
local function open(spec: OpenRequest): (Stream?, string?, ErrorKind?)
  if type(spec) ~= 'table' then error(`{Name}.open: takes a request table with a url`, 0) end

  if not net.current() then error(`{Name}.open: a stream reads its connection, so it opens in a @jess/net task`, 0) end

  local settings = plan(spec.url, spec :: Options & OpenRequest, 'open', OpenOptionNames)

  return openStream(settings, oneShot(settings.tls))
end

--- One origin's connections in a client's pool.
type Origin = {
  idle: { { connection: NetConnection, since: number } },
  busy: number,
  --- Notified whenever a connection comes back or goes, for requests waiting for room.
  turn: net.Signal,
}

local function newClient(options: ClientOptions?): Client
  local settings: ClientOptions = options or {}
  for key in settings :: { [string]: unknown } do
    if not table.find({ 'maxConnectionsPerOrigin', 'idleTimeoutMs', 'tls' }, key) then
      error(`unknown {Name}.client option '{key}': expected maxConnectionsPerOrigin, idleTimeoutMs, tls`, 0)
    end
  end

  local perOrigin = whole(settings.maxConnectionsPerOrigin or 4, 1, 64, 'client', 'maxConnectionsPerOrigin')
  local idleTimeoutMs = duration(settings.idleTimeoutMs or 30000, 'client', 'idleTimeoutMs')
  local tlsConfig = settings.tls
  local origins: { [string]: Origin } = {}
  local client: Client

  local function originOf(url: Url): Origin
    local key = origin(url)
    local found = origins[key]
    if found then return found end

    local created: Origin = { idle = {}, busy = 0, turn = net.signal() }
    origins[key] = created

    return created
  end

  local transport: Transport = {
    acquire = function(url: Url, deadline: number): (NetConnection?, boolean, string?, ErrorKind?)
      local pool = originOf(url)
      while true do
        if client.closed then return nil, false, 'the client is closed', 'closed' end

        local current = net.now()
        while #pool.idle > 0 do
          local entry = table.remove(pool.idle) :: { connection: NetConnection, since: number }
          if current - entry.since <= idleTimeoutMs and entry.connection:idle() then
            pool.busy += 1
            return entry.connection, true, nil, nil
          end

          entry.connection:close()
        end

        if pool.busy < perOrigin then
          pool.busy += 1
          local connection, problem, kind = connectTo(url, tlsConfig, deadline)
          if connection then return connection, false, nil, nil end

          pool.busy -= 1
          pool.turn:notify()
          return nil, false, problem, kind
        end

        local notified, reason = pool.turn:wait(deadline)
        if not notified then
          local kind: ErrorKind = if reason == 'cancelled' then 'cancelled' else 'timeout'
          return nil, false, `every connection to {describe(url)} stayed busy`, kind
        end
      end
    end,

    release = function(url: Url, connection: NetConnection, keep: boolean)
      local pool = originOf(url)
      pool.busy -= 1
      if keep and not client.closed and not connection.closed then
        table.insert(pool.idle, { connection = connection, since = net.now() })
      else
        connection:close()
      end

      pool.turn:notify()
    end,

    connectionField = 'keep-alive',
  }

  local function prepared(spec: Options & OpenRequest, url: string, what: string, names: { string }): Plan
    if spec.tls then error(`{Name}.Client:{what}: a client's requests use its own tls settings`, 0) end

    if not net.current() then error(`{Name}.Client:{what}: a client's connections live on a loop; call it in a task`, 0) end

    return plan(url, spec, `Client:{what}`, names)
  end

  client = {
    request = function(_self: Client, spec: Request): (Response?, string?, ErrorKind?)
      if type(spec) ~= 'table' then error(`{Name}.Client:request: takes a request table with a url`, 0) end

      return perform(prepared(spec :: Options & OpenRequest, spec.url, 'request', ClientOptionNames), transport)
    end,
    get = function(_self: Client, url: string, spec: Options?): (Response?, string?, ErrorKind?)
      return perform(prepared((spec or {}) :: Options & OpenRequest, url, 'get', ClientOptionNames), transport)
    end,
    open = function(_self: Client, spec: OpenRequest): (Stream?, string?, ErrorKind?)
      if type(spec) ~= 'table' then error(`{Name}.Client:open: takes a request table with a url`, 0) end

      return openStream(prepared(spec :: Options & OpenRequest, spec.url, 'open', ClientOpenOptionNames), transport)
    end,
    stats = function(_self: Client): ClientStats
      local idle, busy = 0, 0
      for _, pool in origins do
        idle += #pool.idle
        busy += pool.busy
      end

      return { idle = idle, busy = busy }
    end,
    close = function(_self: Client)
      if client.closed then return end

      client.closed = true
      for _, pool in origins do
        for _, entry in pool.idle do
          entry.connection:close()
        end

        pool.idle = {}
        pool.turn:notify()
      end
    end,
    closed = false,
  }

  return client
end

--- In a @jess/net task: asks `url` to switch the connection to `protocol`. On 101, the response and
--- the open connection, holding whatever the server sent past the head; otherwise the response,
--- its body read within `maxBytes`, and the `upgrade` failure, or nil and why.
local function upgrade(spec: UpgradeRequest): (Response?, NetConnection?, string?, ErrorKind?)
  if not net.current() then error(`{Name}.upgrade: keeps a connection open, so it runs in a @jess/net task`, 0) end

  for key in spec :: { [string]: unknown } do
    if not table.find({ 'url', 'protocol', 'headers', 'maxBytes', 'timeoutMs', 'tls' }, key) then
      error(`unknown {Name}.upgrade option '{key}': expected url, protocol, headers, maxBytes, timeoutMs, tls`, 0)
    end
  end

  local protocol = spec.protocol
  if type(protocol) ~= 'string' or not string.match(protocol, "^[!#$%%&'*+.^_`|~%w/-]+$") then
    error(`{Name}.upgrade: the protocol is a token like 'websocket'`, 0)
  end

  local maxBytes = whole(spec.maxBytes or DefaultMaxBytes, 0, 2 ^ 53, 'upgrade', 'maxBytes')
  local timeoutMs = duration(spec.timeoutMs or DefaultTimeoutMs, 'upgrade', 'timeoutMs')
  local headers = checkHeaders(spec.headers, 'upgrade')
  headers.upgrade = protocol
  local parsed, problem, kind = parseUrl(spec.url)
  if not parsed then return nil, nil, problem, kind end

  local url = parsed :: Url
  local deadline = net.now() + timeoutMs
  local connection, connectProblem, connectKind = connectTo(url, spec.tls, deadline)
  if not connection then return nil, nil, `{describe(url)}: {connectProblem}`, connectKind end

  local live = connection :: NetConnection
  local sent, sendProblem, sendKind = sendRequest(live, url, 'GET', headers, nil, 'Upgrade', deadline)
  local head, headProblem, headKind
  if sent then head, headProblem, headKind = receiveHead(live, deadline) end

  if not head then
    live:close()
    return nil, nil, `{describe(url)}: {headProblem or sendProblem}`, headKind or sendKind
  end

  local answer = head :: Head
  local response: Response = {
    status = answer.status,
    reason = answer.reason,
    headers = answer.headers,
    body = buffer.create(0),
    url = spec.url,
    redirects = {},
  }

  if answer.status == 101 then return response, live, nil, nil end

  local framed = bodyOf(live, answer, 'GET', maxBytes)
  if framed then response.body = readAll(framed, deadline) or buffer.create(0) end

  live:close()

  return response, nil, `{describe(url)} answered {answer.status} instead of switching protocols`, 'upgrade'
end

--- The response's body decoded as JSON, or nil and why it isn't JSON.
local function decodeJson(response: Response): (unknown, string?)
  -- `json.decode` throws on a document that is not JSON, and a server's body is not ours to trust.
  local decoded, value = pcall(json.decode, buffer.tostring(response.body), nil)
  if not decoded then return nil, tostring(value) end

  return value, nil
end

return table.freeze {
  request = request,
  get = get,
  open = open,
  client = newClient,
  upgrade = upgrade,
  json = decodeJson,
  parseUrl = parseUrl,
  resolveReference = resolveReference,
}
