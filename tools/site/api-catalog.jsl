--!strict
-- Extract a documented module from the same generated definitions used by the type checker.
local luau = require '@dream/luau'
local fs = require '@dream/fs'
local process = require '@dream/process'
local json = require '@jess/json'

export type Symbol = {
  name: string,
  module: string,
  signature: string,
  page: string,
  anchor: string,
  checked: boolean,
}

type SearchRecord = { url: string, title: string, description: string, body: string }

local function collect(
  source: string,
  lineStarts: { number },
  module: dream_luau_TypeTable,
  documentation: string,
  prefix: string,
  moduleName: string,
  pageName: string
): { Symbol }
  local symbols: { Symbol } = {}

  for _, property in module.props do
    local kind = property.type
    local first = lineStarts[kind.line] + kind.column - 1
    local last = lineStarts[kind.endLine] + kind.endColumn - 1
    local name = `{prefix}.{property.name}`
    local typeText = string.sub(source, first, last)
    local signature = if kind.kind == 'TypeFunction' then `{name}{typeText}` else `{name}: {typeText}`
    local heading = `## {name}`

    if not string.find(documentation, heading, 1, true) then
      error(`api catalog: missing documentation for {name}`, 0)
    end

    if not string.find(documentation, signature, 1, true) then
      error(`api catalog: signature drift for {name}: {signature}`, 0)
    end

    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = signature,
      page = `docs/api/{pageName}/`,
      anchor = string.gsub(string.lower(name), '%.', '-'),
      checked = true,
    })
  end

  if #symbols == 0 then error(`api catalog: {prefix} has no members`, 0) end

  local pattern = string.gsub(prefix, '%.', '%%.')
  for name in string.gmatch('\n' .. documentation, `\n##+ {pattern}%.([%w_]+)`) do
    local found = false

    for _, symbol in symbols do
      if symbol.name == `{prefix}.{name}` then found = true end
    end

    if not found then error(`api catalog: obsolete documentation for {prefix}.{name}`, 0) end
  end

  table.sort(symbols, function(left: Symbol, right: Symbol) return left.name < right.name end)
  return symbols
end

local function moduleSymbols(definitions: string, documentation: string, member: string): { Symbol }
  local parsed = luau.parse(definitions, { declarations = true })
  if #parsed.errors > 0 then error('api catalog: generated definitions do not parse', 0) end

  local root: dream_luau_TypeTable?
  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatDeclareGlobal' or statement.name ~= 'jess' then continue end
    if statement.type.kind ~= 'TypeTable' then error('api catalog: jess is not a table', 0) end
    root = statement.type
    break
  end

  if not root then error('api catalog: generated definitions have no jess global', 0) end

  for _, property in root.props do
    if property.name ~= member then continue end
    if property.type.kind ~= 'TypeTable' then error(`api catalog: {member} is not a table`, 0) end
    return collect(definitions, parsed.lineStarts, property.type, documentation, `jess.{member}`, `@jess/{member}`, member)
  end

  error(`api catalog: generated definitions have no jess.{member}`, 0)
end

local function stubSymbols(source: string, documentation: string, member: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} stub does not parse`, 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatLocal' or #statement.vars ~= 1 or statement.vars[1].name ~= 'module' then continue end
    local annotation = statement.vars[1].annotation
    if not annotation or annotation.kind ~= 'TypeTable' then error(`api catalog: {member} stub is not a table`, 0) end
    return collect(source, parsed.lineStarts, annotation, documentation, member, `@jess/{member}`, member)
  end

  error(`api catalog: generated {member} stub has no module`, 0)
end

local function inventory(
  source: string,
  lineStarts: { number },
  module: dream_luau_TypeTable,
  prefix: string,
  moduleName: string,
  page: string
): { Symbol }
  local symbols: { Symbol } = {}

  for _, property in module.props do
    local kind = property.type
    local first = lineStarts[kind.line] + kind.column - 1
    local last = lineStarts[kind.endLine] + kind.endColumn - 1
    local name = `{prefix}.{property.name}`
    local typeText = string.sub(source, first, last)
    local signature = if kind.kind == 'TypeFunction' then `{name}{typeText}` else `{name}: {typeText}`
    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = signature,
      page = page,
      anchor = '',
      checked = false,
    })
  end

  if #symbols == 0 then error(`api catalog: {moduleName} has no members`, 0) end
  return symbols
end

local function externalStubSymbols(source: string, member: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} stub does not parse`, 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatLocal' or #statement.vars ~= 1 or statement.vars[1].name ~= 'module' then continue end
    local annotation = statement.vars[1].annotation
    if not annotation or annotation.kind ~= 'TypeTable' then error(`api catalog: {member} stub is not a table`, 0) end

    return inventory(source, parsed.lineStarts, annotation, `@dream/{member}`, `@dream/{member}`, 'docs/api/l3i/')
  end

  error(`api catalog: generated {member} stub has no module`, 0)
end

local function globalInventory(definitions: string, member: string): { Symbol }
  local parsed = luau.parse(definitions, { declarations = true })
  if #parsed.errors > 0 then error('api catalog: generated definitions do not parse', 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatDeclareGlobal' or statement.name ~= 'jess' then continue end
    if statement.type.kind ~= 'TypeTable' then error('api catalog: jess is not a table', 0) end

    for _, property in statement.type.props do
      if property.name ~= member then continue end

      if property.type.kind == 'TypeReference' then
        local aliasName = property.type.name
        for _, alias in parsed.root.body do
          if alias.kind ~= 'StatTypeAlias' or alias.name ~= aliasName then continue end
          if alias.type.kind ~= 'TypeTable' then error(`api catalog: {aliasName} is not a table`, 0) end
          return inventory(definitions, parsed.lineStarts, alias.type, `jess.{member}`, `jess.{member}`, `docs/api/{member}/`)
        end

        error(`api catalog: no definition for {aliasName}`, 0)
      end

      if property.type.kind ~= 'TypeTable' then error(`api catalog: {member} is not a table`, 0) end
      return inventory(definitions, parsed.lineStarts, property.type, `jess.{member}`, `jess.{member}`, `docs/api/{member}/`)
    end
  end

  error(`api catalog: generated definitions have no jess.{member}`, 0)
end

-- These definitions include native handle methods and structural types as well as module tables.
-- Keep their declarations intact: the type checker, not the catalog, resolves aliases and self.
local function typeInventory(definitions: string): { Symbol }
  local parsed = luau.parse(definitions, { declarations = true })
  if #parsed.errors > 0 then error('api catalog: generated definitions do not parse', 0) end
  local symbols: { Symbol } = {}

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatTypeAlias' and statement.kind ~= 'StatDeclareExternType' then continue end
    if statement.kind == 'StatTypeAlias' and not statement.exported then continue end
    local name = statement.name
    local page = 'jess'
    if string.sub(name, 1, 6) == 'dream_' then
      page = 'l3i'
    elseif string.sub(name, 1, 5) == 'Audio' then
      page = 'audio'
    elseif string.sub(name, 1, 5) == 'Input' then
      page = 'input'
    elseif string.sub(name, 1, 3) == 'Gpu' then
      page = 'gpu'
    elseif string.sub(name, 1, 6) == 'Shader' then
      page = 'shader'
    elseif string.sub(name, 1, 7) == 'JessJpk' then
      page = 'jpk'
    elseif string.sub(name, 1, 8) == 'JessTest' then
      page = 'test'
    elseif string.sub(name, 1, 7) == 'JessLog' then
      page = 'log'
    elseif string.sub(name, 1, 11) == 'JessPackage' or name == 'JessActivationPlan' or name == 'JessPackResult' then
      page = 'package'
    elseif name == 'Worker' or name == 'WorkerOptions' or name == 'jess_runtime_Worker' then
      page = 'worker'
    elseif name == 'ManagedModule' or name == 'HostHandlers' or name == 'ContextHandlers' then
      page = 'application'
    end

    local first = parsed.lineStarts[statement.line] + statement.column - 1
    local last = parsed.lineStarts[statement.endLine] + statement.endColumn - 1
    local moduleName = if page == 'l3i' then '@dream' else '@jess'
    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = string.sub(definitions, first, last),
      page = `docs/api/{page}/`,
      anchor = '',
      checked = false,
    })

    if statement.kind == 'StatTypeAlias' and statement.type.kind == 'TypeTable' and #statement.type.props > 0 and page ~= 'l3i' then
      for _, symbol in inventory(definitions, parsed.lineStarts, statement.type, name, moduleName, `docs/api/{page}/`) do
        table.insert(symbols, symbol)
      end
    end

    if statement.kind ~= 'StatDeclareExternType' then continue end

    for _, property in statement.props do
      local propFirst = parsed.lineStarts[property.line] + property.column - 1
      local propLast = parsed.lineStarts[property.endLine] + property.endColumn - 1
      table.insert(symbols, {
        name = `{name}.{property.name}`,
        module = moduleName,
        signature = string.sub(definitions, propFirst, propLast),
        page = `docs/api/{page}/`,
        anchor = '',
        checked = false,
      })
    end
  end

  if #symbols == 0 then error('api catalog: generated definitions have no types', 0) end
  return symbols
end

local function sourceTypes(source: string, moduleName: string, page: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {moduleName} source does not parse`, 0) end
  local symbols: { Symbol } = {}

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatTypeAlias' or not statement.exported then continue end
    local name = `{moduleName}.{statement.name}`
    local first = parsed.lineStarts[statement.line] + statement.column - 1
    local last = parsed.lineStarts[statement.endLine] + statement.endColumn - 1
    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = string.sub(source, first, last),
      page = page,
      anchor = '',
      checked = false,
    })

    if statement.type.kind == 'TypeTable' and #statement.type.props > 0 then
      for _, symbol in inventory(source, parsed.lineStarts, statement.type, name, moduleName, page) do
        table.insert(symbols, symbol)
      end
    end
  end

  return symbols
end

local function tableFunctions(source: string, documentation: string, prefix: string, moduleName: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {moduleName} source does not parse`, 0) end
  local symbols: { Symbol } = {}
  local frozen = false

  for _, statement in parsed.root.body do
    if statement.kind == 'StatAssign' then
      for _, target in statement.vars do
        if target.kind ~= 'ExprIndexName' then continue end
        local owner = target.expr
        if owner.kind ~= 'ExprLocal' or owner['local'].name ~= prefix then continue end
        local name = `{prefix}.{target.index}`
        if prefix ~= 'camera' or target.index ~= 'block' then error(`api catalog: unsupported {name} assignment`, 0) end
        if not string.find(documentation, name, 1, true) then error(`api catalog: missing documentation for {name}`, 0) end

        table.insert(symbols, {
          name = name,
          module = moduleName,
          signature = name,
          page = 'docs/api/render/',
          anchor = 'the-camera',
          checked = false,
        })
      end
    end

    if statement.kind == 'StatReturn' then
      local call = statement.list[1]
      if call and call.kind == 'ExprCall' and call.func.kind == 'ExprIndexName' and call.func.index == 'freeze' and
        call.func.expr.kind == 'ExprGlobal' and call.func.expr.name == 'table' then
        local value = call.args[1]
        frozen = value ~= nil and value.kind == 'ExprLocal' and value['local'].name == prefix
      end
    end

    if statement.kind ~= 'StatFunction' or statement.name.kind ~= 'ExprIndexName' then continue end
    local owner = statement.name.expr
    if owner.kind ~= 'ExprLocal' or owner['local'].name ~= prefix then continue end
    local name = `{prefix}.{statement.name.index}`
    if not string.find(documentation, name, 1, true) then error(`api catalog: missing documentation for {name}`, 0) end
    local args = statement.func.argLocation
    if not args then error(`api catalog: missing arguments for {name}`, 0) end
    local first = parsed.lineStarts[args.line] + args.column - 1
    local last = parsed.lineStarts[args.endLine] + args.endColumn - 1
    local signature = `{name}{string.sub(source, first, last)}`
    local result = statement.func.returnAnnotation
    if result then
      local resultFirst = parsed.lineStarts[result.line] + result.column - 1
      local resultLast = parsed.lineStarts[result.endLine] + result.endColumn - 1
      signature ..= ` -> {string.sub(source, resultFirst, resultLast)}`
    end

    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = signature,
      page = 'docs/api/render/',
      anchor = if prefix == 'render' then 'writers' else 'the-camera',
      checked = false,
    })
  end

  if not frozen or #symbols == 0 then error(`api catalog: unsupported {moduleName} export`, 0) end
  return symbols
end

local function sourceSymbols(source: string, documentation: string, member: string, grouped: boolean?, moduleName: string?, aliases: { [string]: string }?): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} source does not parse`, 0) end
  local exported: dream_luau_ExprTable?

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatReturn' then continue end
    local call = statement.list[1]
    if member == 'audio' and call and call.kind == 'ExprTable' then
      exported = call
      continue
    end

    if not call or call.kind ~= 'ExprCall' or call.func.kind ~= 'ExprIndexName' or call.func.index ~= 'freeze' then continue end
    if call.func.expr.kind ~= 'ExprGlobal' or call.func.expr.name ~= 'table' then continue end
    local value = call.args[1]
    if value and value.kind == 'ExprTable' then exported = value end
  end

  if not exported then error(`api catalog: {member} module has no frozen export table`, 0) end
  local symbols: { Symbol } = {}

  for _, item in exported.items do
    if not item.key or item.key.kind ~= 'ExprConstantString' then
      error(`api catalog: unsupported {member} export`, 0)
    end

    local name = item.key.value
    local symbolName = `{member}.{name}`
    local signature: string?
    local localName: string?
    local func: dream_luau_ExprFunction?

    if item.value.kind == 'ExprLocal' then
      localName = item.value['local'].name
    elseif item.value.kind == 'ExprFunction' then
      func = item.value
    elseif item.value.kind == 'ExprIndexName' and aliases then
      local owner = item.value.expr
      if owner.kind ~= 'ExprLocal' then error(`api catalog: unsupported {member} export {name}`, 0) end
      local key = `{owner['local'].name}.{item.value.index}`
      signature = aliases[key]
    elseif item.value.kind == 'ExprConstantString' then
      local literal = item.value
      local first = parsed.lineStarts[literal.line] + literal.column - 1
      local last = parsed.lineStarts[literal.endLine] + literal.endColumn - 1
      signature = `{symbolName} = {string.sub(source, first, last)}`
    else
      error(`api catalog: unsupported {member} export {name}`, 0)
    end

    for _, statement in parsed.root.body do
      if statement.kind ~= 'StatLocalFunction' or statement.name.name ~= localName then continue end
      func = statement.func
      break
    end

    if localName and not func and aliases then signature = aliases[localName] end

    if func then
      local args, result = func.argLocation, func.returnAnnotation
      if not args then error(`api catalog: {member} function {name} lacks arguments`, 0) end

      local first = parsed.lineStarts[args.line] + args.column - 1
      local last = parsed.lineStarts[args.endLine] + args.endColumn - 1
      signature = `{symbolName}{string.sub(source, first, last)}`
      if result then
        local returnFirst = parsed.lineStarts[result.line] + result.column - 1
        local returnLast = parsed.lineStarts[result.endLine] + result.endColumn - 1
        signature ..= ` -> {string.sub(source, returnFirst, returnLast)}`
      end
    end

    if not signature and name ~= 'null' and not (member == 'value' and (name == 'Null' or name == 'None')) then
      error(`api catalog: unsupported {member} export {name}`, 0)
    end
    local stableSignature = signature or symbolName

    local heading = string.find(documentation, `## {symbolName}`, 1, true)
    local anchor = if grouped or name == 'null' or name == 'version' then '' else string.lower(`{member}-{name}`)
    if anchor ~= '' and not heading then
      error(`api catalog: missing documentation for {symbolName}`, 0)
    end

    if grouped and not string.find(documentation, symbolName, 1, true) then
      error(`api catalog: missing documentation for {symbolName}`, 0)
    end

    table.insert(symbols, {
      name = symbolName,
      module = moduleName or `@jess/{member}`,
      signature = stableSignature,
      page = `docs/api/{member}/`,
      anchor = anchor,
      checked = false,
    })
  end

  if #symbols == 0 then error(`api catalog: {member} module has no exports`, 0) end
  return symbols
end

local function localFunctionSignature(source: string, localName: string, symbolName: string): string
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: source for {symbolName} does not parse`, 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatLocalFunction' or statement.name.name ~= localName then continue end
    local args, result = statement.func.argLocation, statement.func.returnAnnotation
    if not args or not result then error(`api catalog: {symbolName} lacks an explicit signature`, 0) end
    local first = parsed.lineStarts[args.line] + args.column - 1
    local last = parsed.lineStarts[args.endLine] + args.endColumn - 1
    local resultFirst = parsed.lineStarts[result.line] + result.column - 1
    local resultLast = parsed.lineStarts[result.endLine] + result.endColumn - 1
    return `{symbolName}{string.sub(source, first, last)} -> {string.sub(source, resultFirst, resultLast)}`
  end

  error(`api catalog: cannot find source for {symbolName}`, 0)
end

local function generate(root: string): string
  local scratch = fs.join(root, 'target')
  local made, makeProblem = fs.mkdir(scratch, { recursive = true })
  if not made then error(`api catalog: cannot create {scratch}: {makeProblem}`, 0) end
  local folder: string?

  for _ = 1, 32 do
    local candidate = fs.join(scratch, `site-api-{os.time()}-{math.random(1, 1000000000)}`)
    if fs.mkdir(candidate) then
      folder = candidate
      break
    end
  end

  if not folder then error('api catalog: cannot create a temporary directory', 0) end

  local result, problem = process.run('jess', { 'luau-types', folder }, { stdout = 'null', stderr = 'capture' })
  local definitions, readProblem = fs.readFileString(fs.join(folder, 'jess.d.jsl'))
  local sources: { { name: string, source: string, grouped: boolean?, moduleName: string? } } = {}
  local typeSources: { { name: string, page: string, source: string } } = {}
  local sourceProblem: string?

  for _, item in {
    { name = 'json', path = 'data/json.jsl', grouped = false, moduleName = '@jess/json' },
    { name = 'yaml', path = 'data/yaml.jsl', grouped = false, moduleName = '@jess/yaml' },
    { name = 'backup', path = 'backup/init.jsl', grouped = false, moduleName = '@jess/backup' },
    { name = 'http', path = 'http/init.jsl', grouped = false, moduleName = '@jess/http' },
    { name = 'analysis', path = 'analysis/init.jsl', grouped = true, moduleName = '@jess/analysis' },
    { name = 'value', path = 'data/value.jsl', grouped = true, moduleName = '@jess/data/value' },
    { name = 'l10n', path = 'l10n/init.jsl', grouped = true, moduleName = '@jess/l10n' },
    { name = 'input', path = 'input/init.jsl', grouped = true, moduleName = '@jess/input' },
    { name = 'audio', path = 'audio/init.jsl', grouped = true, moduleName = '@jess/audio' },
    { name = 'style', path = 'style/init.jsl', grouped = true, moduleName = '@jess/style' },
  } do
    local source, message = fs.readFileString(fs.join(folder, 'jess', item.path))
    if not source then
      sourceProblem = `cannot read {item.name} module source: {message}`
      break
    end

    table.insert(sources, { name = item.name, source = source, grouped = item.grouped, moduleName = item.moduleName })
  end

  local styleCheck, styleCheckProblem = fs.readFileString(fs.join(folder, 'jess', 'style', 'check.jsl'))
  if not styleCheck then sourceProblem = `cannot read style checker source: {styleCheckProblem}` end

  if not sourceProblem then
    for _, item in {
      { name = 'style', path = 'style/init.jsl', page = 'style' },
      { name = 'analysis', path = 'analysis/init.jsl', page = 'analysis' },
      { name = 'json', path = 'data/json.jsl', page = 'json' },
      { name = 'yaml', path = 'data/yaml.jsl', page = 'yaml' },
      { name = 'data/toml', path = 'data/toml.jsl', page = 'toml' },
      { name = 'data/value', path = 'data/value.jsl', page = 'value' },
      { name = 'l10n', path = 'l10n/init.jsl', page = 'l10n' },
      { name = 'input', path = 'input/init.jsl', page = 'input' },
      { name = 'audio', path = 'audio/init.jsl', page = 'audio' },
      { name = 'backup', path = 'backup/init.jsl', page = 'backup' },
      { name = 'http', path = 'http/init.jsl', page = 'http' },
      { name = 'render', path = 'render/init.jsl', page = 'render' },
      { name = 'render/camera', path = 'render/camera.jsl', page = 'render' },
    } do
      local source, message = fs.readFileString(fs.join(folder, 'jess', item.path))
      if not source then
        sourceProblem = `cannot read {item.name} module source: {message}`
        break
      end

      table.insert(typeSources, { name = item.name, page = item.page, source = source })
    end
  end
  local stubs: { { name: string, source: string } }, dreamStubs: { { name: string, source: string } } = {}, {}
  local stubProblem: string?

  for _, name in { 'jpk', 'log', 'package', 'test' } do
    local source, message = fs.readFileString(fs.join(folder, 'jess', `{name}.jsl`))
    if not source then
      stubProblem = `cannot read {name} stub: {message}`
      break
    end

    table.insert(stubs, { name = name, source = source })
  end

  if not stubProblem then
    local dreamFolder = fs.join(folder, 'dream')
    local files, walkProblem = fs.walk(dreamFolder, { include = 'files', sort = true })
    if not files then stubProblem = `cannot list @dream stubs: {walkProblem}` end

    for _, path in if files then files.paths else {} do
      local name = string.match(path, '^([%w_%-]+)%.jsl$')
      if not name then
        stubProblem = `unsupported @dream stub path: {path}`
        break
      end

      local source, message = fs.readFileString(fs.join(dreamFolder, path))
      if not source then
        stubProblem = `cannot read @dream/{name} stub: {message}`
        break
      end

      table.insert(dreamStubs, { name = name, source = source })
    end
  end

  local removed, removeProblem = fs.remove(folder, { recursive = true })

  if not removed then error(`api catalog: cannot remove {folder}: {removeProblem}`, 0) end
  if not result then error(`api catalog: cannot run jess luau-types: {problem}`, 0) end
  if not result.success then error(`api catalog: jess luau-types failed: {result.stderr or ''}`, 0) end
  if not definitions then error(`api catalog: cannot read definitions: {readProblem}`, 0) end
  if sourceProblem then error(`api catalog: {sourceProblem}`, 0) end
  if stubProblem then error(`api catalog: {stubProblem}`, 0) end

  local version = string.match(definitions, '^%-%- jess ([^ ]+) Luau types')
  if version ~= jess.version then
    error(`api catalog: jess on PATH generated types for {version}, but the site runs on {jess.version}`, 0)
  end

  local members = { 'application', 'bench', 'context', 'events', 'interfaces', 'worker' }
  local modules: { string } = {}
  local symbols: { Symbol } = {}

  for _, member in members do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{member}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, `@jess/{member}`)
    for _, symbol in moduleSymbols(definitions, documentation, member) do
      table.insert(symbols, symbol)
    end
  end

  for _, stub in stubs do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{stub.name}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, `@jess/{stub.name}`)
    for _, symbol in stubSymbols(stub.source, documentation, stub.name) do
      table.insert(symbols, symbol)
    end
  end

  for _, stub in dreamStubs do
    table.insert(modules, `@dream/{stub.name}`)
    for _, symbol in externalStubSymbols(stub.source, stub.name) do
      table.insert(symbols, symbol)
    end
  end

  for _, item in sources do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{item.name}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, item.moduleName or `@jess/{item.name}`)
    local aliases: { [string]: string }? = nil
    if item.name == 'input' or item.name == 'audio' then
      aliases = {}
      for _, symbol in globalInventory(definitions, item.name) do
        local prefix = `jess.{item.name}.`
        local name = string.sub(symbol.name, #prefix + 1)
        aliases[`Native.{name}`] = `{item.name}.{string.sub(symbol.signature, #prefix + 1)}`
      end

      if item.name == 'audio' then
        for _, stub in dreamStubs do
          if stub.name ~= 'audio' then continue end

          for _, symbol in externalStubSymbols(stub.source, 'audio') do
            local prefix = '@dream/audio.'
            local name = string.sub(symbol.name, #prefix + 1)
            aliases[`Decoders.{name}`] = `audio.{string.sub(symbol.signature, #prefix + 1)}`
          end
        end
      end
    end

    if item.name == 'style' then
      if not styleCheck then error('api catalog: missing style checker source', 0) end

      aliases = {
        analysis = 'style.analysis',
        check = localFunctionSignature(styleCheck, 'check', 'style.check'),
        ['rules.Rules'] = 'style.rules',
      }

      for _, other in sources do
        if other.name ~= 'analysis' then continue end
        local path = fs.join(root, 'site', 'content', 'docs', 'api', 'analysis.md')
        local analysisDocumentation, analysisProblem = fs.readFileString(path)
        if not analysisDocumentation then error(`api catalog: cannot read {path}: {analysisProblem}`, 0) end

        for _, symbol in sourceSymbols(other.source, analysisDocumentation, 'analysis', true) do
          if symbol.name ~= 'analysis.analyze' and symbol.name ~= 'analysis.workspace' then continue end
          aliases[symbol.name] = `style.{string.sub(symbol.signature, #'analysis.' + 1)}`
        end
      end
    end

    for _, symbol in sourceSymbols(item.source, documentation, item.name, item.grouped, item.moduleName, aliases) do
      table.insert(symbols, symbol)
    end
  end

  for _, member in { 'audio', 'gpu', 'input', 'shader' } do
    table.insert(modules, `jess.{member}`)
    for _, symbol in globalInventory(definitions, member) do
      table.insert(symbols, symbol)
    end
  end

  for _, symbol in typeInventory(definitions) do
    table.insert(symbols, symbol)
  end

  for _, item in typeSources do
    local moduleName = `@jess/{item.name}`
    local exportedTypes = sourceTypes(item.source, moduleName, `docs/api/{item.page}/`)
    if #exportedTypes > 0 and not table.find(modules, moduleName) then table.insert(modules, moduleName) end

    for _, symbol in exportedTypes do
      table.insert(symbols, symbol)
    end

    if item.name == 'render' or item.name == 'render/camera' then
      local path = fs.join(root, 'site', 'content', 'docs', 'api', 'render.md')
      local documentation, docProblem = fs.readFileString(path)
      if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end
      local prefix = if item.name == 'render' then 'render' else 'camera'
      for _, symbol in tableFunctions(item.source, documentation, prefix, moduleName) do
        table.insert(symbols, symbol)
      end
    end
  end

  table.sort(modules)
  table.sort(symbols, function(left: Symbol, right: Symbol) return left.name < right.name end)

  return json.encodeTable({ schemaVersion = 1, modules = modules, symbols = symbols }, { indent = 2 }) .. '\n'
end

local function publish(output: string, api: string)
  local catalog = json.decode(api) :: { symbols: { Symbol } }
  local indexPath = fs.join(output, 'search_index.en.json')
  local index, problem = fs.readFileString(indexPath)
  if not index then error(`api catalog: cannot read search index: {problem}`, 0) end

  local records = json.decode(index) :: { SearchRecord }
  local suffix = 'docs/api/application/'
  local base: string?

  for _, record in records do
    if string.sub(record.url, -#suffix) == suffix then
      base = string.sub(record.url, 1, #record.url - #suffix)
      break
    end
  end

  if not base then error('api catalog: application reference is missing from the search index', 0) end

  for _, symbol in catalog.symbols do
    local pagePath = fs.join(output, symbol.page, 'index.html')
    local page, pageProblem = fs.readFileString(pagePath)
    if not page then error(`api catalog: cannot read {pagePath}: {pageProblem}`, 0) end

    if symbol.anchor ~= '' and not string.find(page, `id="{symbol.anchor}"`, 1, true) then
      error(`api catalog: missing anchor {symbol.anchor} in {pagePath}`, 0)
    end

    table.insert(records, {
      url = if symbol.anchor == '' then `{base}{symbol.page}` else `{base}{symbol.page}#{symbol.anchor}`,
      title = symbol.name,
      description = symbol.module,
      body = symbol.signature,
    })
  end

  local written, writeProblem = fs.writeFile(indexPath, json.encodeTable(records))
  if not written then error(`api catalog: cannot write search index: {writeProblem}`, 0) end
  local saved, saveProblem = fs.writeFile(fs.join(output, 'api-catalog.json'), api)
  if not saved then error(`api catalog: cannot write catalog: {saveProblem}`, 0) end
end

return table.freeze { moduleSymbols = moduleSymbols, stubSymbols = stubSymbols, sourceSymbols = sourceSymbols, typeInventory = typeInventory, sourceTypes = sourceTypes, tableFunctions = tableFunctions, generate = generate, publish = publish }
