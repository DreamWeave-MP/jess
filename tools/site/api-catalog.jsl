--!strict
-- Extract a documented module from the same generated definitions used by the type checker.
local luau = require '@dream/luau'
local fs = require '@dream/fs'
local process = require '@dream/process'
local json = require '@jess/json'

export type Symbol = {
  name: string,
  module: string,
  signature: string,
  page: string,
  anchor: string,
  checked: boolean,
}

type SearchRecord = { url: string, title: string, description: string, body: string }

local function collect(
  source: string,
  lineStarts: { number },
  module: dream_luau_TypeTable,
  documentation: string,
  prefix: string,
  moduleName: string,
  pageName: string
): { Symbol }
  local symbols: { Symbol } = {}

  for _, property in module.props do
    local kind = property.type
    local first = lineStarts[kind.line] + kind.column - 1
    local last = lineStarts[kind.endLine] + kind.endColumn - 1
    local name = `{prefix}.{property.name}`
    local typeText = string.sub(source, first, last)
    local signature = if kind.kind == 'TypeFunction' then `{name}{typeText}` else `{name}: {typeText}`
    local heading = `## {name}`

    if not string.find(documentation, heading, 1, true) then
      error(`api catalog: missing documentation for {name}`, 0)
    end

    if not string.find(documentation, signature, 1, true) then
      error(`api catalog: signature drift for {name}: {signature}`, 0)
    end

    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = signature,
      page = `docs/api/{pageName}/`,
      anchor = string.gsub(string.lower(name), '%.', '-'),
      checked = true,
    })
  end

  if #symbols == 0 then error(`api catalog: {prefix} has no members`, 0) end

  local pattern = string.gsub(prefix, '%.', '%%.')
  for name in string.gmatch('\n' .. documentation, `\n##+ {pattern}%.([%w_]+)`) do
    local found = false

    for _, symbol in symbols do
      if symbol.name == `{prefix}.{name}` then found = true end
    end

    if not found then error(`api catalog: obsolete documentation for {prefix}.{name}`, 0) end
  end

  table.sort(symbols, function(left: Symbol, right: Symbol) return left.name < right.name end)
  return symbols
end

local function moduleSymbols(definitions: string, documentation: string, member: string): { Symbol }
  local parsed = luau.parse(definitions, { declarations = true })
  if #parsed.errors > 0 then error('api catalog: generated definitions do not parse', 0) end

  local root: dream_luau_TypeTable?
  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatDeclareGlobal' or statement.name ~= 'jess' then continue end
    if statement.type.kind ~= 'TypeTable' then error('api catalog: jess is not a table', 0) end
    root = statement.type
    break
  end

  if not root then error('api catalog: generated definitions have no jess global', 0) end

  for _, property in root.props do
    if property.name ~= member then continue end
    if property.type.kind ~= 'TypeTable' then error(`api catalog: {member} is not a table`, 0) end
    return collect(definitions, parsed.lineStarts, property.type, documentation, `jess.{member}`, `@jess/{member}`, member)
  end

  error(`api catalog: generated definitions have no jess.{member}`, 0)
end

local function stubSymbols(source: string, documentation: string, member: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} stub does not parse`, 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatLocal' or #statement.vars ~= 1 or statement.vars[1].name ~= 'module' then continue end
    local annotation = statement.vars[1].annotation
    if not annotation or annotation.kind ~= 'TypeTable' then error(`api catalog: {member} stub is not a table`, 0) end
    return collect(source, parsed.lineStarts, annotation, documentation, member, `@jess/{member}`, member)
  end

  error(`api catalog: generated {member} stub has no module`, 0)
end

local function inventory(
  source: string,
  lineStarts: { number },
  module: dream_luau_TypeTable,
  prefix: string,
  moduleName: string,
  page: string
): { Symbol }
  local symbols: { Symbol } = {}

  for _, property in module.props do
    local kind = property.type
    local first = lineStarts[kind.line] + kind.column - 1
    local last = lineStarts[kind.endLine] + kind.endColumn - 1
    local name = `{prefix}.{property.name}`
    local typeText = string.sub(source, first, last)
    local signature = if kind.kind == 'TypeFunction' then `{name}{typeText}` else `{name}: {typeText}`
    table.insert(symbols, {
      name = name,
      module = moduleName,
      signature = signature,
      page = page,
      anchor = '',
      checked = false,
    })
  end

  if #symbols == 0 then error(`api catalog: {moduleName} has no members`, 0) end
  return symbols
end

local function externalStubSymbols(source: string, member: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} stub does not parse`, 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatLocal' or #statement.vars ~= 1 or statement.vars[1].name ~= 'module' then continue end
    local annotation = statement.vars[1].annotation
    if not annotation or annotation.kind ~= 'TypeTable' then error(`api catalog: {member} stub is not a table`, 0) end

    return inventory(source, parsed.lineStarts, annotation, `@dream/{member}`, `@dream/{member}`, 'docs/api/l3i/')
  end

  error(`api catalog: generated {member} stub has no module`, 0)
end

local function globalInventory(definitions: string, member: string): { Symbol }
  local parsed = luau.parse(definitions, { declarations = true })
  if #parsed.errors > 0 then error('api catalog: generated definitions do not parse', 0) end

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatDeclareGlobal' or statement.name ~= 'jess' then continue end
    if statement.type.kind ~= 'TypeTable' then error('api catalog: jess is not a table', 0) end

    for _, property in statement.type.props do
      if property.name ~= member then continue end

      if property.type.kind == 'TypeReference' then
        local aliasName = property.type.name
        for _, alias in parsed.root.body do
          if alias.kind ~= 'StatTypeAlias' or alias.name ~= aliasName then continue end
          if alias.type.kind ~= 'TypeTable' then error(`api catalog: {aliasName} is not a table`, 0) end
          return inventory(definitions, parsed.lineStarts, alias.type, `jess.{member}`, `jess.{member}`, `docs/api/{member}/`)
        end

        error(`api catalog: no definition for {aliasName}`, 0)
      end

      if property.type.kind ~= 'TypeTable' then error(`api catalog: {member} is not a table`, 0) end
      return inventory(definitions, parsed.lineStarts, property.type, `jess.{member}`, `jess.{member}`, `docs/api/{member}/`)
    end
  end

  error(`api catalog: generated definitions have no jess.{member}`, 0)
end

local function sourceSymbols(source: string, documentation: string, member: string): { Symbol }
  local parsed = luau.parse(source)
  if #parsed.errors > 0 then error(`api catalog: generated {member} source does not parse`, 0) end
  local exported: dream_luau_ExprTable?

  for _, statement in parsed.root.body do
    if statement.kind ~= 'StatReturn' then continue end
    local call = statement.list[1]
    if not call or call.kind ~= 'ExprCall' or call.func.kind ~= 'ExprIndexName' or call.func.index ~= 'freeze' then continue end
    if call.func.expr.kind ~= 'ExprGlobal' or call.func.expr.name ~= 'table' then continue end
    local value = call.args[1]
    if value and value.kind == 'ExprTable' then exported = value end
  end

  if not exported then error(`api catalog: {member} module has no frozen export table`, 0) end
  local symbols: { Symbol } = {}

  for _, item in exported.items do
    if not item.key or item.key.kind ~= 'ExprConstantString' then
      error(`api catalog: unsupported {member} export`, 0)
    end

    local name = item.key.value
    local symbolName = `{member}.{name}`
    local signature: string?
    local localName: string?

    if item.value.kind == 'ExprLocal' then
      localName = item.value['local'].name
    elseif item.value.kind == 'ExprConstantString' then
      local literal = item.value
      local first = parsed.lineStarts[literal.line] + literal.column - 1
      local last = parsed.lineStarts[literal.endLine] + literal.endColumn - 1
      signature = `{symbolName} = {string.sub(source, first, last)}`
    else
      error(`api catalog: unsupported {member} export {name}`, 0)
    end

    for _, statement in parsed.root.body do
      if statement.kind ~= 'StatLocalFunction' or statement.name.name ~= localName then continue end
      local args, result = statement.func.argLocation, statement.func.returnAnnotation
      if not args or not result then error(`api catalog: {member} function {name} lacks an explicit signature`, 0) end

      local first = parsed.lineStarts[args.line] + args.column - 1
      local last = parsed.lineStarts[args.endLine] + args.endColumn - 1
      local returnFirst = parsed.lineStarts[result.line] + result.column - 1
      local returnLast = parsed.lineStarts[result.endLine] + result.endColumn - 1
      signature = `{symbolName}{string.sub(source, first, last)} -> {string.sub(source, returnFirst, returnLast)}`
      break
    end

    if not signature and name ~= 'null' then error(`api catalog: unsupported {member} export {name}`, 0) end
    local stableSignature = signature or symbolName

    local anchor = if name == 'null' or name == 'version' then '' else string.lower(`{member}-{name}`)
    if anchor ~= '' and not string.find(documentation, `## {symbolName}`, 1, true) then
      error(`api catalog: missing documentation for {symbolName}`, 0)
    end

    table.insert(symbols, {
      name = symbolName,
      module = `@jess/{member}`,
      signature = stableSignature,
      page = `docs/api/{member}/`,
      anchor = anchor,
      checked = false,
    })
  end

  if #symbols == 0 then error(`api catalog: {member} module has no exports`, 0) end
  return symbols
end

local function generate(root: string): string
  local scratch = fs.join(root, 'target')
  local made, makeProblem = fs.mkdir(scratch, { recursive = true })
  if not made then error(`api catalog: cannot create {scratch}: {makeProblem}`, 0) end
  local folder: string?

  for _ = 1, 32 do
    local candidate = fs.join(scratch, `site-api-{os.time()}-{math.random(1, 1000000000)}`)
    if fs.mkdir(candidate) then
      folder = candidate
      break
    end
  end

  if not folder then error('api catalog: cannot create a temporary directory', 0) end

  local result, problem = process.run('jess', { 'luau-types', folder }, { stdout = 'null', stderr = 'capture' })
  local definitions, readProblem = fs.readFileString(fs.join(folder, 'jess.d.jsl'))
  local sources: { { name: string, source: string } } = {}
  local sourceProblem: string?

  for _, item in {
    { name = 'json', path = 'data/json.jsl' },
    { name = 'yaml', path = 'data/yaml.jsl' },
    { name = 'backup', path = 'backup/init.jsl' },
    { name = 'http', path = 'http/init.jsl' },
  } do
    local source, message = fs.readFileString(fs.join(folder, 'jess', item.path))
    if not source then
      sourceProblem = `cannot read {item.name} module source: {message}`
      break
    end

    table.insert(sources, { name = item.name, source = source })
  end
  local stubs: { { name: string, source: string } }, dreamStubs: { { name: string, source: string } } = {}, {}
  local stubProblem: string?

  for _, name in { 'jpk', 'log', 'package', 'test' } do
    local source, message = fs.readFileString(fs.join(folder, 'jess', `{name}.jsl`))
    if not source then
      stubProblem = `cannot read {name} stub: {message}`
      break
    end

    table.insert(stubs, { name = name, source = source })
  end

  if not stubProblem then
    local dreamFolder = fs.join(folder, 'dream')
    local files, walkProblem = fs.walk(dreamFolder, { include = 'files', sort = true })
    if not files then stubProblem = `cannot list @dream stubs: {walkProblem}` end

    for _, path in if files then files.paths else {} do
      local name = string.match(path, '^([%w_%-]+)%.jsl$')
      if not name then
        stubProblem = `unsupported @dream stub path: {path}`
        break
      end

      local source, message = fs.readFileString(fs.join(dreamFolder, path))
      if not source then
        stubProblem = `cannot read @dream/{name} stub: {message}`
        break
      end

      table.insert(dreamStubs, { name = name, source = source })
    end
  end

  local removed, removeProblem = fs.remove(folder, { recursive = true })

  if not removed then error(`api catalog: cannot remove {folder}: {removeProblem}`, 0) end
  if not result then error(`api catalog: cannot run jess luau-types: {problem}`, 0) end
  if not result.success then error(`api catalog: jess luau-types failed: {result.stderr or ''}`, 0) end
  if not definitions then error(`api catalog: cannot read definitions: {readProblem}`, 0) end
  if sourceProblem then error(`api catalog: {sourceProblem}`, 0) end
  if stubProblem then error(`api catalog: {stubProblem}`, 0) end

  local version = string.match(definitions, '^%-%- jess ([^ ]+) Luau types')
  if version ~= jess.version then
    error(`api catalog: jess on PATH generated types for {version}, but the site runs on {jess.version}`, 0)
  end

  local members = { 'application', 'bench', 'context', 'events', 'interfaces', 'worker' }
  local modules: { string } = {}
  local symbols: { Symbol } = {}

  for _, member in members do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{member}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, `@jess/{member}`)
    for _, symbol in moduleSymbols(definitions, documentation, member) do
      table.insert(symbols, symbol)
    end
  end

  for _, stub in stubs do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{stub.name}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, `@jess/{stub.name}`)
    for _, symbol in stubSymbols(stub.source, documentation, stub.name) do
      table.insert(symbols, symbol)
    end
  end

  for _, stub in dreamStubs do
    table.insert(modules, `@dream/{stub.name}`)
    for _, symbol in externalStubSymbols(stub.source, stub.name) do
      table.insert(symbols, symbol)
    end
  end

  for _, item in sources do
    local path = fs.join(root, 'site', 'content', 'docs', 'api', `{item.name}.md`)
    local documentation, docProblem = fs.readFileString(path)
    if not documentation then error(`api catalog: cannot read {path}: {docProblem}`, 0) end

    table.insert(modules, `@jess/{item.name}`)
    for _, symbol in sourceSymbols(item.source, documentation, item.name) do
      table.insert(symbols, symbol)
    end
  end

  for _, member in { 'audio', 'gpu', 'input', 'shader' } do
    table.insert(modules, `jess.{member}`)
    for _, symbol in globalInventory(definitions, member) do
      table.insert(symbols, symbol)
    end
  end

  table.sort(modules)
  table.sort(symbols, function(left: Symbol, right: Symbol) return left.name < right.name end)

  return json.encodeTable({ schemaVersion = 1, modules = modules, symbols = symbols }, { indent = 2 }) .. '\n'
end

local function publish(output: string, api: string)
  local catalog = json.decode(api) :: { symbols: { Symbol } }
  local indexPath = fs.join(output, 'search_index.en.json')
  local index, problem = fs.readFileString(indexPath)
  if not index then error(`api catalog: cannot read search index: {problem}`, 0) end

  local records = json.decode(index) :: { SearchRecord }
  local suffix = 'docs/api/application/'
  local base: string?

  for _, record in records do
    if string.sub(record.url, -#suffix) == suffix then
      base = string.sub(record.url, 1, #record.url - #suffix)
      break
    end
  end

  if not base then error('api catalog: application reference is missing from the search index', 0) end

  for _, symbol in catalog.symbols do
    local pagePath = fs.join(output, symbol.page, 'index.html')
    local page, pageProblem = fs.readFileString(pagePath)
    if not page then error(`api catalog: cannot read {pagePath}: {pageProblem}`, 0) end

    if symbol.anchor ~= '' and not string.find(page, `id="{symbol.anchor}"`, 1, true) then
      error(`api catalog: missing anchor {symbol.anchor} in {pagePath}`, 0)
    end

    table.insert(records, {
      url = if symbol.anchor == '' then `{base}{symbol.page}` else `{base}{symbol.page}#{symbol.anchor}`,
      title = symbol.name,
      description = symbol.module,
      body = symbol.signature,
    })
  end

  local written, writeProblem = fs.writeFile(indexPath, json.encodeTable(records))
  if not written then error(`api catalog: cannot write search index: {writeProblem}`, 0) end
  local saved, saveProblem = fs.writeFile(fs.join(output, 'api-catalog.json'), api)
  if not saved then error(`api catalog: cannot write catalog: {saveProblem}`, 0) end
end

return table.freeze { moduleSymbols = moduleSymbols, stubSymbols = stubSymbols, sourceSymbols = sourceSymbols, generate = generate, publish = publish }
