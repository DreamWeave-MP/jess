--!strict
-- @jess/sse: Server-Sent Events over @jess/http's streams, parsed as the WHATWG HTML standard's
-- event stream format says: lines ended by CRLF, LF or CR, `data` lines joined, `event`, `id` and
-- `retry` kept, comments skipped, and an event dispatched at each blank line. Each event is
-- bounded in bytes. Reconnecting is the caller's: the stream says the last event id and the retry
-- delay the server asked for, and the caller decides what a dropped stream means.
local http = require '@jess/http'

export type Event = {
  --- `message` unless the server named another.
  event: string,
  --- The event's data lines joined by newlines.
  data: string,
  --- The last event id the stream has set, as of this event; empty when none has been.
  id: string,
}

export type ErrorKind = http.ErrorKind | 'notEventStream'

export type Options = {
  url: string,
  method: string?,
  headers: http.Headers?,
  body: (string | buffer)?,
  json: unknown?,
  --- Sent as Last-Event-ID, to resume where an earlier stream ended.
  lastEventId: string?,
  --- The most bytes one event, its lines and fields together, may take. 1 MiB unless given.
  maxEventBytes: number?,
  timeoutMs: number?,
  readTimeoutMs: number?,
  maxRedirects: number?,
  crossOriginRedirects: ('follow' | 'refuse')?,
  tls: dream_tls_ClientConfig?,
  --- Open the stream through this client's connections instead of a connection of its own.
  client: http.Client?,
}

export type EventStream = {
  status: number,
  headers: http.Headers,
  url: string,
  --- The id the last event set, to send as `lastEventId` when reconnecting.
  lastEventId: string,
  --- The reconnection delay in milliseconds the server last asked for with `retry`, if it has.
  retryMs: number?,
  ended: boolean,
  --- The next event. Nil and no message when the server ended the stream; nil, a message and the
  --- kind when it can't be read, after which the stream is ended.
  next: (self: EventStream, deadline: number?) -> (Event?, string?, ErrorKind?),
  close: (self: EventStream) -> (),
}

local Name = 'jess.sse'
local DefaultMaxEventBytes = 1024 * 1024
local OptionNames = {
  'url',
  'method',
  'headers',
  'body',
  'json',
  'lastEventId',
  'maxEventBytes',
  'timeoutMs',
  'readTimeoutMs',
  'maxRedirects',
  'crossOriginRedirects',
  'tls',
  'client',
}

--- What parsing has got to between reads.
type Parser = {
  --- Received text not yet split into lines.
  pending: string,
  --- Whether the byte-order mark the stream may begin with has been looked for.
  started: boolean,
  eventType: string,
  data: { string },
  --- The event so far, in bytes, against the limit.
  size: number,
  lastEventId: string,
  retryMs: number?,
}

--- The next whole line in `parser.pending`, or nil until more arrives. A CR at the very end may
--- be the first half of a CRLF, so it waits for the next read unless the stream has ended.
local function takeLine(parser: Parser, ended: boolean): string?
  local pending = parser.pending
  local at = string.find(pending, '[\r\n]')
  if not at then return nil end

  local ending = string.sub(pending, at, at)
  local length = 1
  if ending == '\r' then
    if at == #pending and not ended then return nil end

    if string.sub(pending, at + 1, at + 1) == '\n' then length = 2 end
  end

  parser.pending = string.sub(pending, at + length)

  return string.sub(pending, 1, at - 1)
end

--- One line applied to `parser`: the event it completes, if it is the blank line that ends one.
local function apply(parser: Parser, line: string): Event?
  if line == '' then
    local data = parser.data
    local eventType = parser.eventType
    parser.data, parser.eventType, parser.size = {}, '', 0
    if #data == 0 then return nil end

    return {
      event = if eventType == '' then 'message' else eventType,
      data = table.concat(data, '\n'),
      id = parser.lastEventId,
    }
  end

  if string.sub(line, 1, 1) == ':' then return nil end

  local colon = string.find(line, ':', 1, true)
  local field = if colon then string.sub(line, 1, colon - 1) else line
  local value = if colon then string.sub(line, colon + 1) else ''
  if string.sub(value, 1, 1) == ' ' then value = string.sub(value, 2) end

  if field == 'data' then
    table.insert(parser.data, value)
  elseif field == 'event' then
    parser.eventType = value
  elseif field == 'id' then
    if not string.find(value, '\0', 1, true) then parser.lastEventId = value end
  elseif field == 'retry' then
    if string.match(value, '^%d+$') then parser.retryMs = tonumber(value) end
  end

  return nil
end

--- In a @jess/net task: opens an event stream, sending `Accept: text/event-stream`. The stream, or
--- nil, a message and the kind of failure; a server that answers anything but 200 with
--- `text/event-stream` is `notEventStream`, its status in the message.
local function open(options: Options): (EventStream?, string?, ErrorKind?)
  if type(options) ~= 'table' then error(`{Name}.open: takes a request table with a url`, 0) end

  for key in options :: { [string]: unknown } do
    if not table.find(OptionNames, key) then
      error(`unknown {Name}.open option '{key}': expected {table.concat(OptionNames, ', ')}`, 0)
    end
  end

  local maxEventBytes = options.maxEventBytes or DefaultMaxEventBytes
  if type(maxEventBytes) ~= 'number' or maxEventBytes ~= math.floor(maxEventBytes) or maxEventBytes < 1 then
    error(`{Name}.open: maxEventBytes is a whole number above 0, not {maxEventBytes}`, 0)
  end

  local headers: http.Headers = {}
  for name, value in options.headers or {} do
    headers[name] = value
  end

  headers.Accept = headers.Accept or 'text/event-stream'
  headers['Cache-Control'] = headers['Cache-Control'] or 'no-cache'
  if options.lastEventId and options.lastEventId ~= '' then headers['Last-Event-ID'] = options.lastEventId end

  local request: http.OpenRequest = {
    url = options.url,
    method = options.method,
    headers = headers,
    body = options.body,
    json = options.json,
    timeoutMs = options.timeoutMs,
    readTimeoutMs = options.readTimeoutMs,
    maxRedirects = options.maxRedirects,
    crossOriginRedirects = options.crossOriginRedirects,
    tls = options.tls,
  }

  local client = options.client
  local opened, problem, kind
  if client then
    if options.tls then error(`{Name}.open: a client's streams use its own tls settings`, 0) end

    opened, problem, kind = client:open(request)
  else
    opened, problem, kind = http.open(request)
  end

  if not opened then return nil, problem, kind end

  local stream = opened :: http.Stream
  local contentType = string.lower(stream.headers['content-type'] or '')
  if stream.status ~= 200 or string.match(contentType, '^%s*([^;%s]*)') ~= 'text/event-stream' then
    stream:close()
    local named = if contentType == '' then 'no Content-Type' else `Content-Type {contentType}`
    -- The URL up to its query, which is where some services put a token.
    local where = string.match(stream.url, '^[^?#]*') or ''
    return nil, `{where} answered {stream.status} with {named}, not an event stream`, 'notEventStream'
  end

  local parser: Parser = {
    pending = '',
    started = false,
    eventType = '',
    data = {},
    size = 0,
    lastEventId = options.lastEventId or '',
    retryMs = nil,
  }

  local events: EventStream
  local function stop()
    events.ended = true
    stream:close()
  end

  events = {
    status = stream.status,
    headers = stream.headers,
    url = stream.url,
    lastEventId = parser.lastEventId,
    retryMs = nil,
    ended = false,
    next = function(_self: EventStream, deadline: number?): (Event?, string?, ErrorKind?)
      local finished = false
      while not events.ended do
        -- The stream may begin with a byte-order mark, and its three bytes may come in as many reads:
        -- nothing is taken as a line until there are three to look at, or the stream ended first.
        if not parser.started and (#parser.pending >= 3 or finished) then
          parser.started = true
          if string.sub(parser.pending, 1, 3) == '\239\187\191' then parser.pending = string.sub(parser.pending, 4) end
        end

        local line = if parser.started then takeLine(parser, finished) else nil
        if line then
          parser.size += #line + 1
          if parser.size > maxEventBytes then
            stop()
            return nil, `an event is larger than the {maxEventBytes} bytes allowed`, 'tooLarge'
          end

          local event = apply(parser, line)
          events.lastEventId, events.retryMs = parser.lastEventId, parser.retryMs
          if event then return event, nil, nil end

          continue
        end

        -- Nothing past a final line ending is an event: the server ended the stream mid-way.
        if finished then
          stop()
          return nil, nil, nil
        end

        if #parser.pending > maxEventBytes then
          stop()
          return nil, `a line is longer than the {maxEventBytes} bytes an event may take`, 'tooLarge'
        end

        local piece, readProblem, readKind = stream:read(deadline)
        if not piece then
          if readProblem then
            events.ended = true
            return nil, readProblem, readKind
          end

          finished = true
          continue
        end

        parser.pending ..= piece :: string
      end

      return nil, nil, nil
    end,
    close = function(_self: EventStream) stop() end,
  } :: EventStream

  return events, nil, nil
end

return table.freeze {
  open = open,
}

--[========[
@api-document sse @jess/sse



Server-Sent Events, the `text/event-stream` responses that services stream updates and model
output as, read with [`@jess/http`'s `open`](@/docs/api/http.md#open) and parsed as the WHATWG
HTML standard says: lines may end in CRLF, LF or CR, a stream may begin with a byte-order mark,
`data` lines join with newlines, `event` names an event, `id` sets the last event id (unless it
holds a NUL), `retry` sets the reconnection delay (digits only), a line starting with `:` is a
comment, and a blank line dispatches what came before it. Pieces of the response split lines,
line endings and events wherever the network splits them; the parser waits for the rest.

It reads one stream and stops when it ends. Reconnecting is yours: what a dropped stream means
(retry at once, back off, give up) depends on the service, so the stream says what you need to
decide it, `lastEventId` and `retryMs`, and does nothing on its own.

## open

{{ api_symbol(value="@jess/sse.open") }}

In a `@jess/net` task: opens the stream with `Accept: text/event-stream` and
`Cache-Control: no-cache`, unless `headers` names its own.

- **Parameters:** `url`, `method`, `headers`, `body`, `json`, `timeoutMs`, `readTimeoutMs`,
  `maxRedirects`, `crossOriginRedirects` and `tls` as `http.open` takes them. `lastEventId`: sent
  as `Last-Event-ID`, to resume after an event you already have. `maxEventBytes` (1 MiB): the most
  one event may take, its lines and fields together; a single line longer than that is refused
  too. `client`: an [`http.client`](@/docs/api/http.md#client) to open the stream through, so a
  stream and the requests around it share connections.
- **Returns:** the `EventStream`, or `nil`, a message and the kind: `@jess/http`'s kinds, and
  `notEventStream` for a response that isn't a `200` with `Content-Type: text/event-stream`, its
  status in the message (an expired token's `401` reads as one).

## EventStream

{{ api_symbol(value="@jess/sse.EventStream") }}

{{ api_symbol(value="@jess/sse.EventStream.next") }}

The next event, `{ event, data, id }`: `event` is `message` unless the server named another,
`data` its data lines joined, and `id` the last event id as of this event, empty when none has
been set. `nil` with no message when the server ended the stream (an event it never finished with
a blank line is dropped, as the standard says); `nil`, a message and the kind (`timeout`,
`closed`, `tooLarge`, `cancelled`) when it can't be read. Either way the stream has `ended`.

`lastEventId` is the id to resume from; `retryMs` is the delay the server last asked for, if it
did. `close` stops reading; a stream read to its end gives its connection back to its client.

```luau
--!strict
local net = require '@jess/net'
local sse = require '@jess/sse'

net.run(function()
  local events, message, kind = sse.open {
    url = 'https://api.example.com/v1/generate',
    method = 'POST',
    json = { prompt = 'hello', stream = true },
    readTimeoutMs = 120000,
  }

  if not events then error(`{kind}: {message}`) end

  while true do
    local event, problem = events:next()
    if not event then
      if problem then print(`stopped at {events.lastEventId}: {problem}`) end
      break
    end

    print(event.event, event.data)
  end
end)
```

Related: [@jess/http](@/docs/api/http.md), [@jess/net](@/docs/api/net.md), [Applications](@/docs/scripting/applications.md#on-the-network).

]========]
