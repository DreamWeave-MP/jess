--!strict
local fs = require '@dream/fs'
local json = require '@jess/json'
local generator = require '../generated-reference'

type Symbol = { name: string, module: string, signature: string, description: string, url: string, reference: string?, valueExpression: boolean }
type Record = { url: string, title: string, description: string, body: string }

local function read(path: string): string
  local content, problem = fs.readFileString(path)
  if not content then error(`catalog output: {problem}`, 0) end
  return content
end

local output = assert(arg[1], 'catalog output: expected a site output folder')
local catalog = json.decode(read(fs.join(output, 'api-catalog.json'))) :: {
  schemaVersion: number,
  modules: { string },
  symbols: { Symbol },
}
assert(catalog.schemaVersion == 2 and #catalog.symbols > 0, 'empty or unknown catalog')
local index = json.decode(read(fs.join(output, 'search_index.en.json'))) :: { Record }
local records: { [string]: Record } = {}
for _, record in index do records[record.title] = record end
local pages: { [string]: string } = {}
for _, module in catalog.modules do
  pages[module] = read(fs.join(output, generator.modulePath(module), 'index.html'))
end

local names: { [string]: boolean } = {}
for _, symbol in catalog.symbols do
  assert(not names[symbol.name], `duplicate symbol {symbol.name}`)
  names[symbol.name] = true
  local target = generator.anchor(symbol.name)
  assert(symbol.url == `{generator.modulePath(symbol.module)}#{target}`, `bad catalog URL for {symbol.name}`)
  assert(symbol.valueExpression == (string.sub(symbol.signature, 1, #symbol.name + 3) == `{symbol.name} = `),
    `bad value classification for {symbol.name}`)
  assert(string.find(pages[symbol.module], `id="{target}"`, 1, true), `missing generated symbol {symbol.name}`)
  local record = records[symbol.name]
  assert(record and record.description == symbol.signature and string.sub(record.url, -#target) == target,
    `missing search record for {symbol.name}`)
end

local jpk = read(fs.join(output, 'docs', 'api', 'jpk', 'index.html'))
assert(string.find(jpk, 'The canonical writer', 1, true), 'source documentation is missing from JPK reference')
assert(string.find(jpk, '@jess/jpk.open(source:', 1, true), 'generated JPK signature is missing')
local markdown = read(fs.join(output, 'docs', 'api', 'jpk', 'index.md'))
assert(string.find(markdown, '@jess/jpk.open(source:', 1, true), 'generated JPK Markdown is missing')
local packagePage = read(fs.join(output, 'docs', 'api', 'package', 'index.html'))
assert(string.find(packagePage, '@jess/package.open(location:', 1, true), 'generated package signature is missing')
local worker = read(fs.join(output, 'docs', 'api', 'worker', 'index.html'))
assert(string.find(worker, 'function send(self, message:', 1, true), 'generated worker method is missing')
local log = read(fs.join(output, 'docs', 'api', 'log', 'index.html'))
assert(string.find(log, 'export type JessLogger', 1, true), 'generated logger type is missing')
local jpkSymbols = pages['@jess/jpk']
assert(string.find(jpkSymbols, '/docs/api/jpk/', 1, true), 'generated JPK symbols do not link to their contracts')
for _, module in { 'net', 'http', 'websocket', 'sse' } do
  local page = read(fs.join(output, 'docs', 'api', module, 'index.md'))
  assert(string.find(page, `@jess/{module}.`, 1, true), `generated {module} reference is missing declarations`)
  assert(not string.find(page, 'api_symbol', 1, true), `unexpanded {module} symbol reference`)
  assert(not string.find(page, '### Declaration:', 1, true), `generated declarations clutter the {module} table of contents`)
end
local netPage = read(fs.join(output, 'docs', 'api', 'net', 'index.html'))
local netAnchor = generator.anchor('@jess/net.loop')
assert(string.find(netPage, `<span id="{netAnchor}"></span>\n<pre><code`, 1, true),
  'the network symbol reference must lead directly to a rendered signature')
print(`checked {#catalog.symbols} generated symbols`)
