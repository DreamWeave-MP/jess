--!strict
--!native
-- YAML 1.2.2 loader using the Core schema. The parser is deliberately self-contained: YAML is a
-- built-in Jess data format, not a privileged Rust path. Presentation trivia is discarded, while
-- anchors/aliases preserve graph identity and custom tags are represented explicitly.

local Bytes = require '@dream/bytes'
local Common = require './common'
local Values = require './value'

export type Options = {
  maxDepth: number?,
}

--- What a decoded collection forgets, keyed by the collection's table. A mapping's entry has
--- `keys`, its keys in document order; a sequence's has none. `floats` marks the values written
--- as floats (`1.0`, `!!float 1`) rather than integers, by key for a mapping and by 1-based
--- position for a sequence.
export type LayoutEntry = {
  keys: { Value }?,
  floats: { [Value]: boolean },
}
export type Layout = { [Value]: LayoutEntry }

export type Tagged = {
  tag: string,
  value: Value,
}

export type Value = unknown

-- One line of the normalized source: its text, its first and last byte, its indentation, and
-- whether a newline ended it.
type Line = { text: string, start: number, finish: number, indent: number, ended: boolean }

local Null = Common.null
local Huge = math.huge
local SafeIntegerMax = integer.fromstring('9007199254740991')
local SafeIntegerMin = integer.fromstring('-9007199254740991')

local source = ''
local length = 0
local maxDepth = 512

local Lines: { Line } = {}
local Anchors: { [string]: Value } = {}
local TagHandles: { [string]: string } = {}
local AnchorFloats: { [string]: boolean } = {}

-- The layout of the text being decoded, and whether the node finished last was a number written
-- as a float. Every scalar ends in resolvePlain or constructTagged and every collection in
-- constructTagged, so the flag always describes the value a caller has just been handed.
local layout: Layout = {}
local lastFloat = false

local function newSequence(): { Value }
  local list: { Value } = {}
  layout[list] = { floats = {} }
  return list
end

local function newMapping(): { [Value]: Value }
  local map: { [Value]: Value } = {}
  layout[map] = { keys = {}, floats = {} }
  return map
end

local function push(list: { Value }, value: Value)
  table.insert(list, value)
  if lastFloat and type(value) == 'number' then layout[list].floats[#list] = true end
end

local function failAt(at: number, message: string): never
  Common.fail('YAML', source, at, message)
  error('unreachable', 0)
end

local function failLine(index: number, column: number, message: string): never
  local line = Lines[index]
  failAt((line and line.start or length + 1) + column - 1, message)
  error('unreachable', 0)
end

local function isSeparation(byte: number?): boolean
  return byte == nil or byte == 32 or byte == 9 or byte == 10 or byte == 13
end

--- Whether a quote or a bracket at `index` opens a node: only where one can start, at the start
--- of the text, after separation white space or a flow indicator, or after a JSON-like key's `:`
--- inside a flow collection. Anywhere else it is a plain scalar's own byte (`it's`, `k[1]`).
local function opensNode(text: string, index: number, depth: number): boolean
  if index == 1 then return true end

  local before = string.byte(text, index - 1)
  return isSeparation(before) or before == 44 or before == 91 or before == 123 or (depth > 0 and before == 58)
end

local function isFlowDelimiter(byte: number?): boolean
  return byte == nil or byte == 44 or byte == 91 or byte == 93 or byte == 123 or byte == 125
end

local function isNameEnd(byte: number?): boolean
  return isSeparation(byte) or byte == 44 or byte == 91 or byte == 93 or byte == 123 or byte == 125
end

local function normalize(text: string): string
  Common.validateUtf8('YAML', text)
  if string.sub(text, 1, 3) == '\239\187\191' then text = string.sub(text, 4) end
  text = string.gsub(text, '\r\n', '\n')
  text = string.gsub(text, '\r', '\n')
  return text
end

local function buildLines()
  table.clear(Lines)
  local lineStart = 1
  local index = 1

  while lineStart <= length + 1 do
    local newline = string.find(source, '\n', lineStart, true)
    local finish = newline and newline - 1 or length
    local text = string.sub(source, lineStart, finish)
    local indent = 0

    while string.byte(text, indent + 1) == 32 do indent += 1 end

    if string.byte(text, indent + 1) == 9 then
      failAt(lineStart + indent, 'tab character may not be used for indentation')
    end

    Lines[index] = {
      text = text,
      start = lineStart,
      finish = finish,
      indent = indent,
      ended = newline ~= nil,
    }
    index += 1

    if not newline then break end
    lineStart = newline + 1
    if lineStart == length + 1 then
      Lines[index] = {
        text = '',
        start = lineStart,
        finish = length,
        indent = 0,
        ended = false,
      }
      break
    end
  end
end

-- Strip a block-line comment. A '#' starts a comment only at the start of the content or after
-- separation white space; quoted and flow collection contents are skipped so their '#' bytes are
-- ordinary scalar data.
local function stripComment(text: string): string
  local quote: number? = nil
  local depth = 0
  local index = 1
  local size = #text

  while index <= size do
    local byte = string.byte(text, index)
    if quote == 39 then
      if byte == 39 then
        if string.byte(text, index + 1) == 39 then
          index += 2
          continue
        end
        quote = nil
      end
    elseif quote == 34 then
      if byte == 92 then
        index += 2
        continue
      elseif byte == 34 then
        quote = nil
      end
    else
      if (byte == 39 or byte == 34) and opensNode(text, index, depth) then
        quote = byte
      elseif (byte == 91 or byte == 123) and (depth > 0 or opensNode(text, index, depth)) then
        depth += 1
      elseif byte == 93 or byte == 125 then
        if depth > 0 then depth -= 1 end
      elseif byte == 35 and (index == 1 or isSeparation(string.byte(text, index - 1))) then
        return Bytes.trimEnd(string.sub(text, 1, index - 1), ' \t')
      end
    end
    index += 1
  end

  return Bytes.trimEnd(text, ' \t')
end

local function significant(index: number): (number?, string?)
  while index <= #Lines do
    local line = Lines[index]
    local content = stripComment(string.sub(line.text, line.indent + 1))
    if content ~= '' then return index, content end
    index += 1
  end
  return nil, nil
end

--- What follows `---` on a document start line, or nil when `content`, a line's content after its
--- `indent`, isn't one. `---` alone gives the empty string. A marker starts in the first column; an
--- indented `---` is content.
local function startMarker(content: string, indent: number): string?
  if indent ~= 0 then return nil end
  if content == '---' then return '' end

  if string.sub(content, 1, 3) == '---' and (string.byte(content, 4) == 32 or string.byte(content, 4) == 9) then
    return Bytes.trim(string.sub(content, 5), ' \t')
  end
  return nil
end

local function documentMarker(content: string, indent: number): boolean
  return (indent == 0 and content == '...') or startMarker(content, indent) ~= nil
end

local function mapColon(text: string): number?
  local quote: number? = nil
  local depth = 0
  local index = 1

  while index <= #text do
    local byte = string.byte(text, index)
    if quote == 39 then
      if byte == 39 then
        if string.byte(text, index + 1) == 39 then
          index += 2
          continue
        end
        quote = nil
      end
    elseif quote == 34 then
      if byte == 92 then
        index += 2
        continue
      end

      if byte == 34 then quote = nil end
    else
      if (byte == 39 or byte == 34) and opensNode(text, index, depth) then
        quote = byte
      elseif (byte == 91 or byte == 123) and (depth > 0 or opensNode(text, index, depth)) then
        depth += 1
      elseif byte == 93 or byte == 125 then
        if depth > 0 then depth -= 1 end
      elseif byte == 58 and depth == 0 and isSeparation(string.byte(text, index + 1)) then
        return index
      end
    end
    index += 1
  end

  return nil
end

local function looksSequence(content: string): boolean
  return string.byte(content, 1) == 45 and isSeparation(string.byte(content, 2))
end

local function looksExplicitKey(content: string): boolean
  return string.byte(content, 1) == 63 and isSeparation(string.byte(content, 2))
end

local function lineForPosition(position: number, hint: number): number
  local index = math.max(1, hint)
  while index < #Lines and position > Lines[index].finish + (Lines[index].ended and 1 or 0) do
    index += 1
  end
  return index
end

local function encodeCodepoint(value: number, position: number): string
  if value > 0x10ffff or (value >= 0xd800 and value <= 0xdfff) then
    failAt(position, 'escape does not name a Unicode scalar value')
  end
  return utf8.char(value)
end

local function foldLines(lines: { string }): string
  if #lines == 0 then return '' end
  local out = { lines[1] }

  local index = 1
  while index < #lines do
    local nextIndex = index + 1
    if lines[index] ~= '' and lines[nextIndex] ~= '' then
      table.insert(out, ' ')
      table.insert(out, lines[nextIndex])
      index = nextIndex
    elseif lines[index] ~= '' then
      local blanks = 0
      while nextIndex <= #lines and lines[nextIndex] == '' do
        blanks += 1
        nextIndex += 1
      end

      if nextIndex <= #lines then
        table.insert(out, string.rep('\n', math.max(1, blanks)))
        table.insert(out, lines[nextIndex])
        index = nextIndex
      else
        table.insert(out, string.rep('\n', blanks))
        break
      end
    else
      table.insert(out, '\n')
      table.insert(out, lines[nextIndex])
      index = nextIndex
    end
  end

  return table.concat(out)
end

local function parseSignedInteger(text: string, base: number, position: number): Value
  local value = integer.fromstring(text, base)
  if value == nil then failAt(position, 'integer is outside the signed 64-bit Luau range') end
  if integer.ge(value, SafeIntegerMin) and integer.le(value, SafeIntegerMax) then return integer.tonumber(value) end
  return value
end

local function resolvePlain(text: string, position: number): Value
  lastFloat = false
  if text == '' or text == '~' or text == 'null' or text == 'Null' or text == 'NULL' then return Null end
  if text == 'true' or text == 'True' or text == 'TRUE' then return true end
  if text == 'false' or text == 'False' or text == 'FALSE' then return false end

  if string.match(text, '^[-+]?%d+$') then
    return parseSignedInteger(text, 10, position)
  end

  if string.match(text, '^0o[0-7]+$') then
    return parseSignedInteger(string.sub(text, 3), 8, position)
  end

  if string.match(text, '^0x[%da-fA-F]+$') then
    return parseSignedInteger(string.sub(text, 3), 16, position)
  end

  local lower = string.lower(text)
  if lower == '.inf' or lower == '+.inf' or lower == '-.inf' or lower == '.nan' then
    lastFloat = true
    if lower == '-.inf' then return -Huge end
    if lower == '.nan' then return 0 / 0 end
    return Huge
  end

  local numeric = string.match(text, '^[-+]?%.%d+[eE][-+]?%d+$')
    or string.match(text, '^[-+]?%.%d+$')
    or string.match(text, '^[-+]?%d+%.%d*[eE][-+]?%d+$')
    or string.match(text, '^[-+]?%d+%.[0-9]*$')
    or string.match(text, '^[-+]?%d+[eE][-+]?%d+$')
  if numeric then
    local value = tonumber(text)
    if not value then failAt(position, 'invalid floating-point value') end
    lastFloat = true
    return value
  end

  return text
end

local function constructTagged(tag: string?, value: Value, plain: boolean, position: number): Value
  lastFloat = false
  if not tag or tag == '?' then
    if plain then return resolvePlain(value :: string, position) end
    return value
  end

  if tag == '!' then return value end

  local full = tag
  if string.sub(tag, 1, 2) == '!!' then
    full = 'tag:yaml.org,2002:' .. string.sub(tag, 3)
  elseif string.sub(tag, 1, 2) == '!<' and string.sub(tag, -1) == '>' then
    full = string.sub(tag, 3, -2)
  elseif string.sub(tag, 1, 1) == '!' then
    local second = string.find(tag, '!', 2, true)
    if second then
      local handle = string.sub(tag, 1, second)
      local prefix = TagHandles[handle]
      if not prefix then failAt(position, `undefined tag handle {handle}`) end
      full = prefix .. string.sub(tag, second + 1)
    end
  end

  if full == 'tag:yaml.org,2002:str' then return tostring(value == Null and '' or value) end
  if full == 'tag:yaml.org,2002:null' then return Null end

  if full == 'tag:yaml.org,2002:bool' then
    local scalar = string.lower(tostring(value))
    if scalar == 'true' then return true end
    if scalar == 'false' then return false end
    failAt(position, 'invalid !!bool scalar')
  end

  if full == 'tag:yaml.org,2002:int' then
    local scalar = tostring(value)
    lastFloat = false
    if string.match(scalar, '^[-+]?%d+$') then return parseSignedInteger(scalar, 10, position) end
    if string.match(scalar, '^0o[0-7]+$') then return parseSignedInteger(string.sub(scalar, 3), 8, position) end
    if string.match(scalar, '^0x[%da-fA-F]+$') then return parseSignedInteger(string.sub(scalar, 3), 16, position) end
    failAt(position, 'invalid !!int scalar')
  end

  if full == 'tag:yaml.org,2002:float' then
    local scalar = tostring(value)
    local resolved = resolvePlain(scalar, position)
    if type(resolved) == 'number' then
      lastFloat = true
      return resolved
    end
    failAt(position, 'invalid !!float scalar')
  end

  if full == 'tag:yaml.org,2002:seq' then
    if type(value) ~= 'table' then failAt(position, '!!seq requires a sequence node') end
    return value
  end

  if full == 'tag:yaml.org,2002:map' then
    if type(value) ~= 'table' then failAt(position, '!!map requires a mapping node') end
    return value
  end

  return { tag = full, value = value }
end

-- Flow parser -----------------------------------------------------------------

local flowAt = 1
local flowCollections = 0

local function skipFlowSpace()
  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if byte == 32 or byte == 9 or byte == 10 then
      flowAt += 1
    elseif byte == 35 then
      local newline = string.find(source, '\n', flowAt + 1, true)
      flowAt = newline and newline + 1 or length + 1
    else
      break
    end
  end
end

local function parseTagToken(): string
  local start = flowAt
  flowAt += 1
  if string.byte(source, flowAt) == 60 then
    flowAt += 1
    local close = string.find(source, '>', flowAt, true)
    if not close then failAt(start, 'unterminated verbatim tag') end
    local closeAt = close :: number
    flowAt = closeAt + 1
    return string.sub(source, start, closeAt)
  end

  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if isNameEnd(byte) or byte == 35 then break end
    flowAt += 1
  end
  return string.sub(source, start, flowAt - 1)
end

local function parseAnchorName(indicator: number): string
  local position = flowAt
  if string.byte(source, flowAt) ~= indicator then failAt(flowAt, 'internal anchor parser mismatch') end
  flowAt += 1
  local start = flowAt
  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if isNameEnd(byte) or byte == 42 or byte == 38 or byte == 33 then break end
    flowAt += 1
  end

  if flowAt == start then failAt(position, 'empty anchor or alias name') end
  return string.sub(source, start, flowAt - 1)
end

local function parseProperties(): (string?, string?)
  local tag: string? = nil
  local anchor: string? = nil
  while true do
    skipFlowSpace()
    local byte = string.byte(source, flowAt)
    if byte == 33 then
      if tag then failAt(flowAt, 'node has more than one tag property') end
      tag = parseTagToken()
    elseif byte == 38 then
      if anchor then failAt(flowAt, 'node has more than one anchor property') end
      anchor = parseAnchorName(38)
    else
      break
    end
  end
  return tag, anchor
end

local function foldQuoted(rawLines: { string }): string
  local cleaned: { string } = {}
  for index, line in rawLines do
    -- White space before a physical line break is presentation separation, but white space before
    -- the closing quote is scalar content and must survive.
    table.insert(cleaned, index < #rawLines and Bytes.trimEnd(line, ' \t') or line)
  end
  return foldLines(cleaned)
end

local Escapes: { [number]: string } = {
  [48] = '\0',
  [97] = '\7',
  [98] = '\b',
  [116] = '\t',
  [9] = '\t',
  [110] = '\n',
  [118] = '\11',
  [102] = '\f',
  [114] = '\r',
  [101] = '\27',
  [32] = ' ',
  [34] = '"',
  [47] = '/',
  [92] = '\\',
  [78] = utf8.char(0x85),
  [95] = utf8.char(0xa0),
  [76] = utf8.char(0x2028),
  [80] = utf8.char(0x2029),
}

local function parseDoubleQuoted(): string
  local start = flowAt
  flowAt += 1
  local lines: { string }, parts: { string } = {}, {}
  local chunk = flowAt

  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if byte == 34 then
      if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
      table.insert(lines, table.concat(parts))
      flowAt += 1
      return foldQuoted(lines)
    end

    if byte == 92 then
      if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
      local escapeAt = flowAt
      flowAt += 1
      local escaped = string.byte(source, flowAt)
      if escaped == 10 then
        flowAt += 1
        while string.byte(source, flowAt) == 32 or string.byte(source, flowAt) == 9 do flowAt += 1 end
        chunk = flowAt
        continue
      end

      local direct = escaped and Escapes[escaped]
      if direct then
        table.insert(parts, direct)
        flowAt += 1
      elseif escaped == 120 or escaped == 117 or escaped == 85 then
        local digits = escaped == 120 and 2 or (escaped == 117 and 4 or 8)
        local value = Common.hex(source, flowAt + 1, digits)
        if not value then failAt(escapeAt, 'invalid hexadecimal escape in double-quoted scalar') end
        table.insert(parts, encodeCodepoint(value :: number, escapeAt))
        flowAt += digits + 1
      else
        failAt(escapeAt, 'invalid escape in double-quoted scalar')
      end
      chunk = flowAt
      continue
    end

    if byte == 10 then
      if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
      table.insert(lines, table.concat(parts))
      table.clear(parts)
      flowAt += 1
      while string.byte(source, flowAt) == 32 or string.byte(source, flowAt) == 9 do flowAt += 1 end
      chunk = flowAt
      continue
    end

    if byte and byte < 32 and byte ~= 9 then failAt(flowAt, 'control character in double-quoted scalar') end
    flowAt += 1
  end

  failAt(start, 'unterminated double-quoted scalar')
  error('unreachable', 0)
end

local function parseSingleQuoted(): string
  local start = flowAt
  flowAt += 1
  local lines: { string }, parts: { string } = {}, {}
  local chunk = flowAt

  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if byte == 39 then
      if string.byte(source, flowAt + 1) == 39 then
        if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
        table.insert(parts, "'")
        flowAt += 2
        chunk = flowAt
        continue
      end

      if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
      table.insert(lines, table.concat(parts))
      flowAt += 1
      return foldQuoted(lines)
    end

    if byte == 10 then
      if flowAt > chunk then table.insert(parts, string.sub(source, chunk, flowAt - 1)) end
      table.insert(lines, table.concat(parts))
      table.clear(parts)
      flowAt += 1
      while string.byte(source, flowAt) == 32 or string.byte(source, flowAt) == 9 do flowAt += 1 end
      chunk = flowAt
      continue
    end

    if byte and byte < 32 and byte ~= 9 then failAt(flowAt, 'control character in single-quoted scalar') end
    flowAt += 1
  end

  failAt(start, 'unterminated single-quoted scalar')
  error('unreachable', 0)
end

local parseFlowNode: (boolean, number) -> Value

local function setMappingPair(map: { [Value]: Value }, key: Value, value: Value, position: number)
  if key == nil then key = Null end
  if type(key) == 'number' and key ~= key then failAt(position, 'NaN cannot be represented as a Luau table key') end
  if map[key] ~= nil then failAt(position, 'duplicate mapping key') end
  map[key] = value
  local entry = layout[map]
  table.insert(entry.keys :: { Value }, key)
  if lastFloat and type(value) == 'number' then entry.floats[key] = true end
end

local function parseFlowPlain(stopColon: boolean): (string, number)
  local start = flowAt
  local lineStart = flowAt
  local lines: { string } = {}

  while flowAt <= length do
    local byte = string.byte(source, flowAt)
    if byte == 44 or byte == 93 or byte == 125 then break end
    if byte == 35 and (flowAt == lineStart or isSeparation(string.byte(source, flowAt - 1))) then break end

    if byte == 58 then
      local nextByte = string.byte(source, flowAt + 1)
      if stopColon and (isSeparation(nextByte) or isFlowDelimiter(nextByte)) then break end
      if isFlowDelimiter(nextByte) then break end
    end

    if byte == 91 or byte == 123 then break end

    if byte == 10 then
      if flowCollections == 0 then break end
      table.insert(lines, Bytes.trimEnd(string.sub(source, lineStart, flowAt - 1), ' \t'))
      flowAt += 1
      while string.byte(source, flowAt) == 32 or string.byte(source, flowAt) == 9 do flowAt += 1 end
      lineStart = flowAt
      continue
    end
    flowAt += 1
  end

  local tail = Bytes.trimEnd(string.sub(source, lineStart, flowAt - 1), ' \t')
  if #lines == 0 then
    if tail == '' then failAt(start, 'expected scalar content') end
    return tail, start
  end

  if tail ~= '' then table.insert(lines, tail) end
  local value = foldLines(lines)
  if value == '' then failAt(start, 'expected scalar content') end
  return value, start
end

local function registerAnchor(anchor: string?, value: Value, position: number)
  if not anchor then return end
  if Anchors[anchor] ~= nil then failAt(position, `anchor &{anchor} is already defined`) end
  Anchors[anchor] = value
  AnchorFloats[anchor] = lastFloat and type(value) == 'number'
end

local function parseFlowSequence(tag: string?, anchor: string?, depth: number, position: number): Value
  if depth > maxDepth then failAt(position, 'maximum nesting depth exceeded') end
  local list = newSequence()
  registerAnchor(anchor, list, position)
  flowCollections += 1
  flowAt += 1
  skipFlowSpace()

  if string.byte(source, flowAt) == 93 then
    flowAt += 1
    flowCollections -= 1
    return constructTagged(tag, list, false, position)
  end

  while true do
    local itemStart = flowAt
    local item = parseFlowNode(true, depth + 1)
    skipFlowSpace()

    if string.byte(source, flowAt) == 58 then
      flowAt += 1
      skipFlowSpace()
      local map = newMapping()
      local value
      local nextByte = string.byte(source, flowAt)
      if nextByte == 44 or nextByte == 93 then value = Null else value = parseFlowNode(false, depth + 1) end
      setMappingPair(map, item, value, itemStart)
      item = map
      lastFloat = false
    end
    push(list, item)

    skipFlowSpace()
    local byte = string.byte(source, flowAt)
    if byte == 93 then
      flowAt += 1
      break
    end

    if byte ~= 44 then failAt(flowAt, "expected ',' or ']' in flow sequence") end
    flowAt += 1
    skipFlowSpace()
    if string.byte(source, flowAt) == 93 then
      flowAt += 1
      break
    end
  end

  flowCollections -= 1
  return constructTagged(tag, list, false, position)
end

local function parseFlowMapping(tag: string?, anchor: string?, depth: number, position: number): Value
  if depth > maxDepth then failAt(position, 'maximum nesting depth exceeded') end
  local map = newMapping()
  registerAnchor(anchor, map, position)
  flowCollections += 1
  flowAt += 1
  skipFlowSpace()

  if string.byte(source, flowAt) == 125 then
    flowAt += 1
    flowCollections -= 1
    return constructTagged(tag, map, false, position)
  end

  while true do
    local pairAt = flowAt
    local explicit = string.byte(source, flowAt) == 63 and isSeparation(string.byte(source, flowAt + 1))
    if explicit then
      flowAt += 1
      skipFlowSpace()
    end

    local key: Value = Null
    local byte = string.byte(source, flowAt)
    if byte ~= 58 and byte ~= 44 and byte ~= 125 then key = parseFlowNode(true, depth + 1) end
    skipFlowSpace()

    local value: Value = Null
    if string.byte(source, flowAt) == 58 then
      flowAt += 1
      skipFlowSpace()
      byte = string.byte(source, flowAt)
      if byte ~= 44 and byte ~= 125 then value = parseFlowNode(false, depth + 1) end
    elseif not explicit then
      failAt(flowAt, "expected ':' in flow mapping")
    end
    setMappingPair(map, key, value, pairAt)

    skipFlowSpace()
    byte = string.byte(source, flowAt)
    if byte == 125 then
      flowAt += 1
      break
    end

    if byte ~= 44 then failAt(flowAt, "expected ',' or '}' in flow mapping") end
    flowAt += 1
    skipFlowSpace()
    if string.byte(source, flowAt) == 125 then
      flowAt += 1
      break
    end
  end

  flowCollections -= 1
  return constructTagged(tag, map, false, position)
end

parseFlowNode = function(stopColon: boolean, depth: number): Value
  if depth > maxDepth then failAt(flowAt, 'maximum nesting depth exceeded') end
  skipFlowSpace()
  local position = flowAt
  local tag, anchor = parseProperties()
  skipFlowSpace()
  position = math.min(position, flowAt)

  local byte = string.byte(source, flowAt)
  if byte == 42 then
    if tag or anchor then failAt(flowAt, 'alias node may not have node properties') end
    local name = parseAnchorName(42)
    local value = Anchors[name]
    if value == nil then failAt(position, `alias *{name} refers to an unknown anchor`) end
    lastFloat = AnchorFloats[name] == true
    return value
  end

  if byte == 91 then return parseFlowSequence(tag, anchor, depth, position) end
  if byte == 123 then return parseFlowMapping(tag, anchor, depth, position) end

  local value: Value
  local plain = false
  if byte == 34 then
    value = parseDoubleQuoted()
  elseif byte == 39 then
    value = parseSingleQuoted()
  else
    local raw, rawAt = parseFlowPlain(stopColon)
    value = raw
    plain = true
    position = rawAt
  end
  value = constructTagged(tag, value, plain, position)
  registerAnchor(anchor, value, position)
  return value
end

local function ensureInlineFinished(lineIndex: number): number
  local endingLine = lineForPosition(flowAt, lineIndex)
  local line = Lines[endingLine]
  local restStart = flowAt - line.start + 1
  local rest = string.sub(line.text, math.max(1, restStart))
  local clean = stripComment(rest)
  if Bytes.trim(clean, ' \t') ~= '' then failAt(flowAt, 'unexpected content after node') end
  return endingLine + 1
end

-- Block parser ----------------------------------------------------------------

type BlockNodeParser = (number, number, number, string?, string?) -> (Value, number)
local parseBlockNodeImpl: BlockNodeParser
local function parseBlockNode(index: number, indent: number, depth: number, tag: string?, anchor: string?): (Value, number)
  return parseBlockNodeImpl(index, indent, depth, tag, anchor)
end

local function parseBlockScalar(index: number, indicatorColumn: number, token: string): (string, number)
  local line = Lines[index]
  local style = string.sub(token, 1, 1)
  local modifiers = stripComment(string.sub(token, 2))
  local chomp = ''
  local explicit: number? = nil

  for offset = 1, #modifiers do
    local byte = string.byte(modifiers, offset)
    if byte == 43 or byte == 45 then
      if chomp ~= '' then failLine(index, indicatorColumn + offset, 'duplicate block scalar chomping indicator') end
      chomp = string.char(byte)
    elseif byte and byte >= 49 and byte <= 57 then
      if explicit then failLine(index, indicatorColumn + offset, 'duplicate block scalar indentation indicator') end
      explicit = byte - 48
    elseif byte == 32 or byte == 9 then
      local trailing = Bytes.trim(string.sub(modifiers, offset), ' \t')
      if trailing ~= '' then failLine(index, indicatorColumn + offset, 'invalid block scalar header') end
      break
    else
      failLine(index, indicatorColumn + offset, 'invalid block scalar header')
    end
  end

  local parentIndent = line.indent
  local contentIndent = parentIndent + 1
  local scan = index + 1
  if explicit then
    contentIndent = parentIndent + explicit
  else
    -- Without an indicator, the first line with content sets the indentation, when it is deeper.
    while scan <= #Lines do
      local candidate = Lines[scan]
      if candidate.text ~= '' and Bytes.trim(candidate.text, ' \t') ~= '' then
        if candidate.indent > parentIndent then contentIndent = candidate.indent end
        break
      end
      scan += 1
    end
  end

  local values: { string } = {}
  local more: { boolean }, endings: { boolean } = {}, {}
  local last = 0
  scan = index + 1
  while scan <= #Lines do
    local candidate = Lines[scan]
    local blank = Bytes.trim(candidate.text, ' \t') == ''
    if not blank and candidate.indent < contentIndent then break end
    if not blank and candidate.indent <= parentIndent then break end

    local value = blank and '' or string.sub(candidate.text, contentIndent + 1)
    table.insert(values, value)
    table.insert(more, not blank and candidate.indent > contentIndent)
    table.insert(endings, candidate.ended)
    if not blank then last = #values end
    scan += 1
  end

  -- The content runs to the last non-blank line. Its own line break is the one clip keeps, and
  -- each trailing empty line that a break ends is one more for keep. Lines with no break (the last
  -- line of a source that does not end in one) add nothing.
  local out: { string } = {}
  for index = 1, last do
    local value = values[index]
    table.insert(out, value)
    if index == last then break end

    if style == '|' then
      table.insert(out, '\n')
      continue
    end

    local nextValue = values[index + 1]
    if more[index] or more[index + 1] then
      table.insert(out, '\n')
    elseif value ~= '' and nextValue ~= '' then
      table.insert(out, ' ')
    elseif value == '' then
      table.insert(out, '\n')
    end
  end

  if chomp == '-' then return table.concat(out), scan end
  if last > 0 and endings[last] then table.insert(out, '\n') end
  if chomp == '' then return table.concat(out), scan end

  for index = last + 1, #values do
    if endings[index] then table.insert(out, '\n') end
  end
  return table.concat(out), scan
end

local function startsSpecialInline(text: string): boolean
  local byte = string.byte(text, 1)
  return byte == 34 or byte == 39 or byte == 91 or byte == 123 or byte == 42 or byte == 33 or byte == 38
end

local function propertyOnly(text: string): (string?, string?, boolean)
  local rest = Bytes.trim(stripComment(text), ' \t')
  local tag: string? = nil
  local anchor: string? = nil

  while rest ~= '' do
    local first = string.sub(rest, 1, 1)
    if first ~= '!' and first ~= '&' then return tag, anchor, false end
    local token: string
    if string.sub(rest, 1, 2) == '!<' then
      local close = string.find(rest, '>', 3, true)
      if not close then return tag, anchor, false end
      token = string.sub(rest, 1, close)
      rest = Bytes.trim(string.sub(rest, close + 1), ' \t')
    else
      local space = string.find(rest, '[ \t]')
      token = space and string.sub(rest, 1, space - 1) or rest
      rest = space and Bytes.trim(string.sub(rest, space + 1), ' \t') or ''
    end

    if first == '!' then
      if tag then return tag, anchor, false end
      tag = token
    else
      if anchor or #token == 1 then return tag, anchor, false end
      anchor = string.sub(token, 2)
    end
  end

  return tag, anchor, tag ~= nil or anchor ~= nil
end

local function parsePlainBlock(first: string, index: number, parentIndent: number, position: number): (Value, number)
  local lines = { Bytes.trim(first, ' \t') }
  local scan = index + 1

  while scan <= #Lines do
    local candidate = Lines[scan]
    local clean = stripComment(string.sub(candidate.text, candidate.indent + 1))
    if documentMarker(clean, candidate.indent) or string.byte(clean, 1) == 37 then break end

    if clean == '' then
      local nextIndex, nextContent = significant(scan + 1)
      if not nextIndex or Lines[nextIndex].indent <= parentIndent or (nextContent and documentMarker(nextContent, Lines[nextIndex].indent)) then break end
      table.insert(lines, '')
      scan += 1
      continue
    end

    if candidate.indent <= parentIndent then break end
    table.insert(lines, Bytes.trim(clean, ' \t'))
    scan += 1
  end

  return resolvePlain(foldLines(lines), position), scan
end

local function parseInlineBlock(text: string, index: number, parentIndent: number, depth: number): (Value, number)
  local line = Lines[index]
  local leading = #text - #string.gsub(text, '^[ \t]+', '')
  local clean = string.sub(text, leading + 1)
  -- Every caller hands over the end of the line's content with its comment and trailing blanks
  -- already cut, so `text` ends where the stripped line does, not where the line does.
  local position = line.start + (#stripComment(line.text) - #text) + leading

  if string.sub(clean, 1, 1) == '|' or string.sub(clean, 1, 1) == '>' then
    local value, nextIndex = parseBlockScalar(index, position - line.start + 1, clean)
    return value, nextIndex
  end

  if not startsSpecialInline(clean) then
    return parsePlainBlock(stripComment(clean), index, parentIndent, position)
  end

  flowAt = position
  local value = parseFlowNode(false, depth)
  local nextIndex = ensureInlineFinished(index)
  return value, nextIndex
end

local function parseKeyText(text: string, index: number, depth: number): Value
  local clean = Bytes.trim(text, ' \t')
  if clean == '' then return Null end
  local line = Lines[index]
  local relative = string.find(line.text, clean, 1, true) or 1
  local position = line.start + relative - 1

  if startsSpecialInline(clean) then
    flowAt = position
    local key = parseFlowNode(true, depth)
    local ending = lineForPosition(flowAt, index)
    if ending ~= index then failAt(position, 'implicit mapping key must be on one line') end
    return key
  end
  return resolvePlain(clean, position)
end

local function parseBlockSequence(index: number, indent: number, depth: number, tag: string?, anchor: string?, firstContent: string?): (Value, number)
  local list = newSequence()
  local position = Lines[index].start + indent
  registerAnchor(anchor, list, position)
  local scan = index

  while scan <= #Lines do
    local found: number?
    local content: string?
    local compactFirst = firstContent ~= nil
    if firstContent then
      found, content = scan, firstContent
      firstContent = nil
    else
      found, content = significant(scan)
    end

    if not found or not content then
      scan = #Lines + 1
      break
    end
    local foundAt = found :: number
    local contentText = content :: string
    local line = Lines[foundAt]
    if (not compactFirst and line.indent ~= indent) or not looksSequence(contentText) then break end
    if documentMarker(contentText, line.indent) then break end

    local rest = string.sub(contentText, 2)
    if string.sub(rest, 1, 1) == ' ' or string.sub(rest, 1, 1) == '\t' then rest = string.sub(rest, 2) end
    rest = stripComment(rest)

    if Bytes.trim(rest, ' \t') == '' then
      local child, childContent = significant(foundAt + 1)
      if child and childContent and not documentMarker(childContent, Lines[child].indent) and Lines[child].indent > indent then
        local value, nextIndex = parseBlockNode(child, Lines[child].indent, depth + 1, nil, nil)
        push(list, value)
        scan = nextIndex
      else
        push(list, Null)
        scan = foundAt + 1
      end
      continue
    end

    -- Compact block mapping: `- key: value`, followed by more entries at the compact mapping's
    -- indentation. Parse it through the mapping machinery by supplying the first entry explicitly.
    if looksSequence(rest) then
      local nested, nextIndex = parseBlockSequence(foundAt, indent + 2, depth + 1, nil, nil, rest)
      push(list, nested)
      scan = nextIndex
      continue
    end

    local propertyTag, propertyAnchor, onlyProperties = propertyOnly(rest)
    if onlyProperties then
      local child, childContent = significant(foundAt + 1)
      if child and childContent and Lines[child].indent > indent then
        local value, nextIndex = parseBlockNode(child, Lines[child].indent, depth + 1, propertyTag, propertyAnchor)
        push(list, value)
        scan = nextIndex
      else
        local value = constructTagged(propertyTag, Null, false, line.start + indent)
        registerAnchor(propertyAnchor, value, line.start + indent)
        push(list, value)
        scan = foundAt + 1
      end
      continue
    end

    local colon = mapColon(rest)
    if colon and not startsSpecialInline(Bytes.trim(rest, ' \t')) then
      local map = newMapping()
      local key = parseKeyText(string.sub(rest, 1, colon - 1), foundAt, depth + 1)
      local rhs = string.sub(rest, colon + 1)
      local value: Value
      local nextIndex: number
      if Bytes.trim(stripComment(rhs), ' \t') == '' then
        local child, childContent = significant(foundAt + 1)
        if child and childContent and Lines[child].indent > indent then
          value, nextIndex = parseBlockNode(child, Lines[child].indent, depth + 2, nil, nil)
        else
          value, nextIndex = Null, foundAt + 1
        end
      else
        value, nextIndex = parseInlineBlock(rhs, foundAt, indent + 2, depth + 2)
      end
      setMappingPair(map, key, value, position)

      local compactIndent: number? = nil
      local look, lookContent = significant(nextIndex)
      if look and lookContent and Lines[look].indent > indent then compactIndent = Lines[look].indent end

      if compactIndent then
        local moreMap, after = parseBlockNode(look :: number, compactIndent, depth + 1, nil, nil)
        if type(moreMap) ~= 'table' then failLine(look :: number, compactIndent + 1, 'compact mapping continuation must be a mapping') end
        local moreLayout = layout[moreMap]
        if not moreLayout or not moreLayout.keys then failLine(look :: number, compactIndent + 1, 'compact mapping continuation must be a mapping') end
        local more = moreMap :: { [Value]: Value }
        for _, otherKey in (moreLayout :: LayoutEntry).keys :: { Value } do
          lastFloat = (moreLayout :: LayoutEntry).floats[otherKey] == true
          setMappingPair(map, otherKey, more[otherKey], Lines[look :: number].start)
        end
        nextIndex = after
      end
      lastFloat = false
      push(list, map)
      scan = nextIndex
    else
      local value, nextIndex = parseInlineBlock(rest, foundAt, indent, depth + 1)
      push(list, value)
      scan = nextIndex
    end
  end

  return constructTagged(tag, list, false, position), scan
end

local function parseBlockMapping(index: number, indent: number, depth: number, tag: string?, anchor: string?): (Value, number)
  local map = newMapping()
  local position = Lines[index].start + indent
  registerAnchor(anchor, map, position)
  local scan = index

  while scan <= #Lines do
    local found, content = significant(scan)
    if not found or not content then
      scan = #Lines + 1
      break
    end
    local line = Lines[found]
    if line.indent ~= indent or looksSequence(content) or documentMarker(content, line.indent) then break end

    local key: Value
    local rhs: string
    local pairAt = line.start + indent

    if looksExplicitKey(content) then
      local afterQuestion = stripComment(string.sub(content, 2))
      key = Bytes.trim(afterQuestion, ' \t') == '' and Null or parseKeyText(afterQuestion, found, depth + 1)
      local valueLine, valueContent = significant(found + 1)
      if not valueLine or not valueContent or Lines[valueLine].indent ~= indent or string.byte(valueContent, 1) ~= 58
        or not isSeparation(string.byte(valueContent, 2)) then
        setMappingPair(map, key, Null, pairAt)
        scan = found + 1
        continue
      end
      rhs = string.sub(valueContent, 2)
      found = valueLine
      line = Lines[found]
    else
      local colon = mapColon(content)
      if not colon then break end
      key = parseKeyText(string.sub(content, 1, colon - 1), found, depth + 1)
      rhs = string.sub(content, colon + 1)
    end

    local cleanRhs = stripComment(rhs)
    local value: Value
    local nextIndex: number
    local propertyTag, propertyAnchor, onlyProperties = propertyOnly(cleanRhs)
    if onlyProperties then
      local child, childContent = significant(found + 1)
      if child and childContent and not documentMarker(childContent, Lines[child].indent) and Lines[child].indent > indent then
        value, nextIndex = parseBlockNode(child, Lines[child].indent, depth + 1, propertyTag, propertyAnchor)
      else
        value = constructTagged(propertyTag, Null, false, line.start + indent)
        registerAnchor(propertyAnchor, value, line.start + indent)
        nextIndex = found + 1
      end
    elseif Bytes.trim(cleanRhs, ' \t') == '' then
      local child, childContent = significant(found + 1)
      if child and childContent and not documentMarker(childContent, Lines[child].indent) then
        local childIndent = Lines[child].indent
        if childIndent > indent or (childIndent == indent and looksSequence(childContent)) then
          value, nextIndex = parseBlockNode(child, childIndent, depth + 1, nil, nil)
        else
          value, nextIndex = Null, found + 1
        end
      else
        value, nextIndex = Null, found + 1
      end
    else
      value, nextIndex = parseInlineBlock(rhs, found, indent, depth + 1)
    end
    setMappingPair(map, key, value, pairAt)
    scan = nextIndex
  end

  return constructTagged(tag, map, false, position), scan
end

local function parsePropertyPrefix(text: string, index: number): (string?, string?, string)
  local line = Lines[index]
  local base = line.start + line.indent
  flowAt = base
  local tag, anchor = parseProperties()
  local consumed = flowAt - base
  return tag, anchor, Bytes.trim(string.sub(text, consumed + 1), ' \t')
end

parseBlockNodeImpl = function(index: number, indent: number, depth: number, inheritedTag: string?, inheritedAnchor: string?): (Value, number)
  if depth > maxDepth then failLine(index, indent + 1, 'maximum nesting depth exceeded') end
  local line = Lines[index]
  local content = stripComment(string.sub(line.text, indent + 1))
  if content == '' then return Null, index + 1 end

  local tag, anchor = inheritedTag, inheritedAnchor
  if string.byte(content, 1) == 33 or string.byte(content, 1) == 38 then
    local originalContent = content
    local parsedTag, parsedAnchor, rest = parsePropertyPrefix(content, index)
    tag = parsedTag or tag
    anchor = parsedAnchor or anchor
    content = rest
    if content == '' then
      local child, childContent = significant(index + 1)
      if child and childContent and Lines[child].indent > indent then
        return parseBlockNode(child, Lines[child].indent, depth + 1, tag, anchor)
      end
      local value = constructTagged(tag, Null, false, line.start + indent)
      registerAnchor(anchor, value, line.start + indent)
      return value, index + 1
    end

    if not looksSequence(content) and not looksExplicitKey(content) and not mapColon(content) then
      return parseInlineBlock(originalContent, index, indent - 1, depth)
    end
  end

  if looksSequence(content) then return parseBlockSequence(index, indent, depth, tag, anchor) end
  if looksExplicitKey(content) or mapColon(content) then return parseBlockMapping(index, indent, depth, tag, anchor) end

  local value, nextIndex = parseInlineBlock(content, index, indent - 1, depth)
  if tag then value = constructTagged(tag :: string, value, false, line.start + indent) end
  registerAnchor(anchor, value, line.start + indent)
  return value, nextIndex
end

-- A document's root node. Its properties may stand alone on its first line, the node itself
-- starting on the next at any indentation, since the root's parent indentation is -1. On a `---`
-- line, `inline` is the rest of the line: a scalar, a flow collection, a block scalar header or
-- properties, but never the start of a block collection.
local function parseRoot(index: number, inline: string?): (Value, number)
  local line = Lines[index]
  local text = inline or stripComment(string.sub(line.text, line.indent + 1))
  local tag, anchor, onlyProperties = propertyOnly(text)
  if onlyProperties then
    local child, childContent = significant(index + 1)
    if child and childContent and not documentMarker(childContent, Lines[child].indent) then
      return parseBlockNode(child, Lines[child].indent, 1, tag, anchor)
    end
    local value = constructTagged(tag, Null, false, line.start + line.indent)
    registerAnchor(anchor, value, line.start + line.indent)
    return value, index + 1
  end

  if not inline then return parseBlockNode(index, line.indent, 1, nil, nil) end

  if looksSequence(inline) or looksExplicitKey(inline) or (mapColon(inline) and not startsSpecialInline(inline)) then
    failLine(index, line.indent + 5, "a block collection cannot start on the '---' line")
  end
  return parseInlineBlock(inline, index, -1, 1)
end

local function resetDocument()
  table.clear(Anchors)
  table.clear(AnchorFloats)
  table.clear(TagHandles)
  TagHandles['!!'] = 'tag:yaml.org,2002:'
  TagHandles['!'] = '!'
end

local function parseDirective(index: number, content: string): number
  if string.sub(content, 1, 5) == '%YAML' and isSeparation(string.byte(content, 6)) then
    local version = Bytes.trim(string.sub(content, 6), ' \t')
    if version ~= '1.2' then failLine(index, 1, `unsupported YAML version {version}`) end
  elseif string.sub(content, 1, 4) == '%TAG' and isSeparation(string.byte(content, 5)) then
    local rest = Bytes.trim(string.sub(content, 5), ' \t')
    local handle, prefix = string.match(rest, '^(%S+)%s+(%S+)$')
    if not handle or not prefix or string.sub(handle, 1, 1) ~= '!' or string.sub(handle, -1) ~= '!' then
      failLine(index, 1, 'invalid %TAG directive')
    end

    local handleValue, prefixValue = handle :: string, prefix :: string
    if TagHandles[handleValue] and handleValue ~= '!' and handleValue ~= '!!' then failLine(index, 1, `duplicate tag handle {handleValue}`) end
    TagHandles[handleValue] = prefixValue
  else
    failLine(index, 1, 'unknown YAML directive')
  end
  return index + 1
end

local function parseDocuments(text: string, options: Options?): { Value }
  layout = {}
  lastFloat = false
  source = normalize(text)
  length = #source
  maxDepth = options and options.maxDepth or 512
  flowCollections = 0
  if maxDepth < 1 or maxDepth ~= math.floor(maxDepth) then error('YAML: maxDepth must be a positive integer', 2) end
  buildLines()

  local documents: { Value } = {}
  local index = 1

  while true do
    resetDocument()
    local sawDirective = false
    while true do
      local found, content = significant(index)
      if not found or not content then return documents end

      if string.byte(content, 1) ~= 37 then
        index = found
        break
      end

      sawDirective = true
      index = parseDirective(found, content)
    end

    local found, content = significant(index)
    if not found or not content then return documents end

    local inline = startMarker(content, Lines[found].indent)
    if sawDirective and not inline then failLine(found, 1, "directives must be followed by '---'") end

    if content == '...' then
      index = found + 1
      table.insert(documents, Null)
      continue
    end

    if inline and inline ~= '' then
      local value, nextIndex = parseRoot(found, inline)
      table.insert(documents, value)
      index = nextIndex
    else
      if inline then index = found + 1 end
      found, content = significant(index)
      if not found or not content then
        table.insert(documents, Null)
        return documents
      end

      if documentMarker(content, Lines[found].indent) then
        table.insert(documents, Null)
        if content == '...' then index = found + 1 else index = found end
      else
        local value, nextIndex = parseRoot(found, nil)
        table.insert(documents, value)
        index = nextIndex
      end
    end

    local marker, markerContent = significant(index)
    if not marker or not markerContent then return documents end

    if markerContent == '...' then
      index = marker + 1
      local nextLine, nextContent = significant(index)
      if nextLine and nextContent and string.byte(nextContent, 1) == 37 then
        index = nextLine
      end
    elseif startMarker(markerContent, Lines[marker].indent) then
      index = marker
    elseif string.byte(markerContent, 1) == 37 then
      failLine(marker, 1, "a directive after a document requires an explicit '...' document end")
    else
      failLine(marker, Lines[marker].indent + 1, 'unexpected content after YAML document')
    end
  end
end

--- The documents in `text` and the layout of every collection in them. The layout is handed over
--- and the module lets go of it, so a decode keeps nothing alive after it returns.
local function decodeAllWithLayout(text: string, options: Options?): ({ Value }, Layout)
  local documents = parseDocuments(text, options)
  local decoded = layout
  layout = {}
  return documents, decoded
end

local function decodeWithLayout(text: string, options: Options?): (Value, Layout)
  local documents, decoded = decodeAllWithLayout(text, options)
  if #documents == 0 then return Null, decoded end
  if #documents ~= 1 then error(`YAML: expected one document, got {#documents}; use decodeAll`, 2) end
  return documents[1], decoded
end

-- One result each, not two: callers pass these straight into calls and table constructors, where
-- a second result would become an argument or an element.
local function decodeAll(text: string, options: Options?): { Value }
  local documents = decodeAllWithLayout(text, options)
  return documents
end

local function decode(text: string, options: Options?): Value
  local documents = decodeAllWithLayout(text, options)
  if #documents == 0 then return Null end
  if #documents ~= 1 then error(`YAML: expected one document, got {#documents}; use decodeAll`, 2) end
  return documents[1]
end

--- A value built with `@jess/data/value` as one YAML document in block style, as serde_yaml
--- writes it: plain scalars where a reader takes them back as what they were, quoted otherwise.
local function encode(value: Values.Value): string return Values.encode(value, 'yaml') end

return table.freeze {
  version = '1.2.2',
  null = Null,
  decode = decode,
  decodeAll = decodeAll,
  decodeWithLayout = decodeWithLayout,
  decodeAllWithLayout = decodeAllWithLayout,
  encode = encode,
}

--[========[
@api-document yaml @jess/yaml


`@jess/yaml` is the YAML codec, Luau in the built-in package. It loads [YAML 1.2.2](https://yaml.org/spec/1.2.2/) with the Core schema, and writes one document in block style. It needs no capability.

YAML is a built-in data format, not a privileged native path, and the loader is self-contained on purpose: `@dream/bytes` for the UTF-8 work, nothing else native. Presentation trivia (comments, quoting style, indentation) is discarded. Anchors and aliases keep graph identity: an alias is the same Luau table as its anchor, not a copy. A tag the schema doesn't know is kept, explicitly, as `{ tag, value }`.

A YAML null (`~`, `null`, or nothing) decodes to [`jess.null`](@/docs/api/jess.md#jess-null), which `yaml.null` is another name for, and `encode` writes `jess.null` back as `null`. It's the one null every codec in jess shares.

## yaml.decode

{{ api_symbol(value="@jess/yaml.decode") }}


Parses a text holding one document and returns its value. `yaml.version` is the spec version the loader follows, `'1.2.2'`.

`Options` is `{ maxDepth: number? }`; the exported `Value` type is `unknown`.

- **Parameters:** `text`, the whole document as UTF-8. `options.maxDepth`: how deep collections may nest, 512 by default; it must be a positive integer.
- **Returns:** the document's value, or `jess.null` for a text with no document in it. Mappings are tables, sequences are tables from 1, and scalars resolve by the Core schema: see the table below.
- **Errors:** `YAML: <what's wrong> at line <n>, column <n>` for a text the grammar refuses (`YAML: expected ',' or ']' in flow sequence at line 1, column 9`), a duplicate mapping key, a NaN mapping key, an undefined tag handle, an invalid `!!int` or `!!bool` scalar, an integer outside the signed 64-bit range, or nesting past `maxDepth` (`YAML: maximum nesting depth exceeded at line 1, column 4`). An invalid depth raises `YAML: maxDepth must be a positive integer`. `YAML: expected one document, got <n>; use decodeAll` means the text contains several documents.

The result is `unknown`. Cast it to the shape your program expects in `--!strict` code, and check what you can't count on.

```luau
--!strict
local yaml = require '@jess/yaml'

type Manifest = {
  id: string,
  version: string,
  count: number,
  empty: JessNull,
  tags: { string },
  first: string,
  custom: { tag: string, value: string },
}

local document = yaml.decode [[
id: com.example.greeter
version: 1.0.0
count: 0x10
empty: ~
tags: [cli, &tool tool]
first: *tool
custom: !flag enabled
]]
local manifest = document :: Manifest
print(manifest.id, typeof(manifest.version), manifest.count, manifest.empty == jess.null)
print(manifest.tags[2], manifest.first, manifest.custom.tag, manifest.custom.value)
```

```text
com.example.greeter	string	16	true
tool	tool	!flag	enabled
```

`1.0.0` is a string because the Core schema says so: two dots make it no number. `0x10` is an integer because the Core schema says that too.

## yaml.decodeAll

{{ api_symbol(value="@jess/yaml.decodeAll") }}


Parses a text holding any number of documents, separated by `---`, and returns their values in order. A text with none gives an empty table. It takes the same depth option and reports the same parsing errors as `decode`.

```luau
--!strict
local yaml = require '@jess/yaml'

local documents = yaml.decodeAll '---\nid: one\n---\nid: two\n'
print(#documents, (documents[1] :: { id: string }).id, (documents[2] :: { id: string }).id)
```

```text
2	one	two
```

## yaml.decodeWithLayout

{{ api_symbol(value="@jess/yaml.decodeWithLayout") }}


`decode`, plus a layout table for what Luau tables forget: the same side channel [`@jess/data/toml`](@/docs/api/toml.md) returns, for a tool that has to hold a file to the shape its author wrote. `Layout` and `LayoutEntry` are exported types of this module.

- **Returns:** two values:
  1. The document's value, as `decode` returns it.
  2. The layout, keyed by each decoded mapping and sequence (by identity). A mapping's entry has `keys`, its keys in document order; a sequence's has no `keys`, which is how `{}` is told from `[]` and `{1: a}` from `[a]`. `floats` marks the values written as floats (`1.0`, `1e3`, `.inf`, `!!float 1`) rather than integers, by key for a mapping and by 1-based position for a sequence. An alias shares its anchor's entry. A custom tag's `{ tag, value }` table has no entry; its `value` has one when it's a collection.
- **Errors:** as `decode`.

```luau
--!strict
local yaml = require '@jess/yaml'

local document, layout = yaml.decodeWithLayout 'jobs: {}\nsteps: []\nratio: 1.0\ncount: 1\n'
local root = document :: { jobs: unknown, steps: unknown }
print(table.concat(layout[root].keys :: { any }, ', '))
print(layout[root.jobs].keys ~= nil, layout[root.steps].keys ~= nil)
print(layout[root].floats.ratio, layout[root].floats.count)
```

```text
jobs, steps, ratio, count
true	false
true	nil
```

`decode` and `decodeAll` return one value each, so a call in the last place of an argument list or a table constructor adds one element, not two.

## yaml.decodeAllWithLayout

{{ api_symbol(value="@jess/yaml.decodeAllWithLayout") }}


`decodeAll`, plus one layout covering every document's collections.

```luau
--!strict
local yaml = require '@jess/yaml'

local documents, layout = yaml.decodeAllWithLayout '---\n[1.0]\n---\n{}\n'
print(layout[documents[1]].floats[1], layout[documents[2]].keys ~= nil)
```

```text
true	true
```

## yaml.encode

{{ api_symbol(value="@jess/yaml.encode") }}


`Values.Value` is the exported `Value` type of [`@jess/data/value`](@/docs/api/value.md).

Writes a value built with [`@jess/data/value`](@/docs/api/value.md) as one document in block style, as `serde_yaml` writes it: plain scalars where a reader would take them back as what they were, quoted where it wouldn't (a string that looks like a number, a boolean, or a null stays a string), sequences one item per line, keys in the order the map was given them, a variant as a `!tag` on its value, an absent field as `null`.

- **Parameters:** `value`, from `value.struct`, `value.map`, `value.array`, `value.variant`, `value.float`, or a scalar.
- **Returns:** the document, ending in a newline.
- **Errors:** `data: a bare table is neither a list nor a map: build it with array, map, or struct` for a Luau table the value module didn't build.

```luau
--!strict
local yaml = require '@jess/yaml'
local value = require '@jess/data/value'

local record = value.struct {
  { 'id', 'com.example.greeter' },
  { 'version', '1.0.0' },
  { 'layers', value.array { 'example.greetings' } },
  { 'note', nil },
}

print(yaml.encode(record))
```

```text
id: com.example.greeter
version: 1.0.0
layers:
- example.greetings
note: null
```

## Type mapping

| YAML | Luau |
| --- | --- |
| Plain `~`, `null`, `Null`, `NULL`, or an empty value | `jess.null` |
| Plain `true`, `false` (and `True`, `TRUE`, ...) | `boolean` |
| Plain decimal, `0o` octal, `0x` hexadecimal integer | `number` within ±2^53, beyond it an exact `integer` (`typeof(value) == 'integer'`) |
| Plain float, `.inf`, `-.inf`, `.nan` | `number` |
| Any other plain scalar, and every quoted scalar | `string` |
| `!!str`, `!!null`, `!!bool`, `!!int`, `!!float`, `!!seq`, `!!map` | The Core type, checked: `!!int abc` is an error, not a string |
| Any other tag, `!flag` or `!<tag:example.com,2026:thing>` | `{ tag: string, value: unknown }`, with the tag as written, or resolved through its `%TAG` handle |
| Sequence | A table from 1; its layout entry has no `keys` |
| Mapping | A table keyed by the resolved keys; its layout entry's `keys` keep their order |
| Alias | The anchored value itself, by identity |

Related: [`@jess/data/value`](@/docs/api/value.md), [`@jess/json`](@/docs/api/json.md), [`@jess/data/toml`](@/docs/api/toml.md).

]========]
