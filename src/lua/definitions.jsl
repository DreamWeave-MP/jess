-- Generic Jess runtime service definitions.

declare extern type JessNull with end

--- A handle to a native resource that may cross domain and worker boundaries in a message: its
--- `kind`, in the vocabulary of whatever made it.
declare extern type JessHandle with
  kind: string
end

--- The handlers `jess.context.bind` takes, by phase name. Each gets the phase's payload: seconds
--- for `update`, `fixedUpdate`, and `lateUpdate`, the event for `event`, nothing for `startup` and
--- `shutdown`.
export type ContextHandlers = { [string]: (payload: any) -> () }

--- The host callbacks a managed module returns under `on.host`, each called in its own context:
--- `load` and `startup` once, `fixedUpdate` with the step and `update`/`lateUpdate` with the
--- frame's seconds, `input`/`renderPrepare`/`onDemand` with what the host passes, `shutdown`
--- once at the end. `interfaceOverride` is the loader's, called once with the implementation the
--- module's interface replaces.
export type HostHandlers = {
  load: (() -> ())?,
  startup: (() -> ())?,
  fixedUpdate: ((stepSeconds: number) -> ())?,
  update: ((deltaSeconds: number) -> ())?,
  lateUpdate: ((deltaSeconds: number) -> ())?,
  input: ((payload: any) -> ())?,
  renderPrepare: ((payload: any) -> ())?,
  onDemand: ((payload: any) -> ())?,
  shutdown: (() -> ())?,
  interfaceOverride: ((previous: any) -> ())?,
}

--- What a package's `[managed]` module returns: host callbacks, named-event handlers by event
--- name, and the table its manifest's `interface` names, if it declares one.
export type ManagedModule = {
  on: { host: HostHandlers?, event: { [string]: (payload: any) -> () }? }?,
  interface: { [string]: any }?,
}

--- What `jess.worker.spawn` takes: the worker module's source (a chunk returning the message
--- handler), a name for diagnostics, and the capabilities the worker holds, a subset of the
--- spawner's.
export type WorkerOptions = { source: string, name: string?, capabilities: { string }?, shareServices: boolean? }

--- A worker the domain spawned: `send` queues a message for its handler, `receive` reads its next
--- reply (waiting up to the seconds given), `close` stops it after the queued messages, `join`
--- waits for it to end.
export type Worker = jess_runtime_Worker

--- What an action's value is shaped like: `digital` (boolean), `scalar` (number), or `vector2`
--- (a `vector` with `z` 0).
export type InputValueType = 'digital' | 'scalar' | 'vector2'

--- A device's glyph family, for labels (`@jess/input`'s `label`): `keyboardMouse`, `xbox`,
--- `playstation`, `nintendo`, `genericGamepad`, or `touch`.
export type InputFamily = 'keyboardMouse' | 'xbox' | 'playstation' | 'nintendo' | 'genericGamepad' | 'touch'

--- An action's value: a boolean for digital, a number for scalar, a `vector` (z 0) for vector2.
export type InputValue = boolean | number | vector

--- An action's state after a tick. `pressed` and `released` are this tick's edges; `since` is when
--- it last became active or inactive, in seconds; `device` is the device behind the value.
export type InputActionState = {
  value: InputValue,
  active: boolean,
  pressed: boolean,
  released: boolean,
  changed: boolean,
  since: number,
  device: number?,
}

--- One action edge from a tick.
export type InputActionEvent = {
  action: string,
  kind: 'pressed' | 'released' | 'changed',
  value: InputValue,
  time: number,
  device: number?,
}

--- A device the runtime connected.
export type InputDevice = { id: number, kind: 'keyboard' | 'pointer' | 'gamepad' | 'touch' | 'unknown', name: string, family: InputFamily, connected: boolean }

--- What the last tick did.
export type InputStats = {
  deviceEvents: number,
  ticks: number,
  nodesEvaluated: number,
  bindingsEvaluated: number,
  actionsChanged: number,
  actionEvents: number,
  activeSets: number,
  activeLayers: number,
}

--- A compiled, validated action graph.
export type InputGraph = {
  --- The document as JSON, the same text for the same document.
  toJson: (self: InputGraph) -> string,
  --- The actions, in declaration order.
  actions: (self: InputGraph) -> { { name: string, valueType: InputValueType } },
}

--- An input runtime. Under a host it is the application's live input: the host ticks it in the
--- input phase, and `tick` and `advance` are refused. Anywhere else it is headless: a graph,
--- synthetic devices, and a clock that moves when told to. Reading state needs `input.actions`,
--- `devices` needs `input.observe`, and everything that changes it needs `input.configure`.
export type InputRuntime = {
  --- Installs a graph, replacing the last one. Returns the new generation.
  install: (self: InputRuntime, graph: InputGraph) -> number,
  uninstall: (self: InputRuntime) -> (),
  --- Puts the installed package's bindings back, dropping remaps.
  restoreDefaults: (self: InputRuntime) -> (),
  --- Activates (the default) or deactivates a set, from the next tick.
  setActive: (self: InputRuntime, set: string, active: boolean?) -> (),
  pushLayer: (self: InputRuntime, layer: string) -> (),
  --- Removes a layer; whether it was pushed.
  popLayer: (self: InputRuntime, layer: string) -> boolean,
  --- Connects a synthetic device and returns its id.
  connect: (self: InputRuntime, kind: 'keyboard' | 'pointer' | 'gamepad' | 'touch') -> number,
  disconnect: (self: InputRuntime, device: number) -> (),
  --- Presses a button, named `class:Name` (`key:KeyA`, `gamepadButton:South`).
  press: (self: InputRuntime, device: number, control: string) -> (),
  release: (self: InputRuntime, device: number, control: string) -> (),
  --- Moves an axis (`gamepadAxis:LeftStickX`) to `value`, or a relative one by it.
  axis: (self: InputRuntime, device: number, control: string, value: number) -> (),
  focus: (self: InputRuntime, focused: boolean) -> (),
  --- Moves the clock forward by `seconds`.
  advance: (self: InputRuntime, seconds: number) -> (),
  now: (self: InputRuntime) -> number,
  --- Applies every event so far, evaluates the graph once, and returns the action edges.
  tick: (self: InputRuntime) -> { InputActionEvent },
  --- An action's state after the last tick, or nil for a name the graph doesn't declare.
  action: (self: InputRuntime, name: string) -> InputActionState?,
  devices: (self: InputRuntime) -> { InputDevice },
  stats: (self: InputRuntime) -> InputStats,
}

--- How one sample is stored in interleaved bytes, little-endian: unsigned 8-bit, signed 16-,
--- 24- (three bytes), and 32-bit, and 32- and 64-bit floats.
export type AudioSampleFormat = 'u8' | 's16' | 's24' | 's32' | 'f32' | 'f64'

--- Decoded audio from `jess.audio.pcm`: planar float channels at one rate, shared by every voice
--- that plays it.
export type AudioPcm = {
  --- Frames per second.
  rate: (self: AudioPcm) -> number,
  channels: (self: AudioPcm) -> number,
  --- The length in frames.
  frames: (self: AudioPcm) -> number,
}

--- How to start a voice. `at` is an output frame, and the voice starts on exactly that frame;
--- without one it starts on the next frame rendered. `gain` is linear (1), `pan` -1 to 1 (0;
--- equal power for mono, balance for stereo), `rate` the playback rate, pitch with it (1),
--- `offset` the source frame to start from (0). With `loop`, playback that reaches `loopEnd` (the
--- source's end) continues at `loopStart` (0), without a gap.
export type AudioPlayOptions = {
  at: number?,
  gain: number?,
  pan: number?,
  rate: number?,
  offset: number?,
  loop: boolean?,
  loopStart: number?,
  loopEnd: number?,
  --- The node it plays into: a bus, usually, and the master unless told otherwise; or a processor
  --- only it goes through.
  bus: AudioNode?,
  --- Up to fifteen nodes it also sends to, each at a level relative to its own gain (1).
  sends: { { bus: AudioNode, level: number? } }?,
  --- Frames to fade in over, from silence to `gain` (0).
  fade: number?,
  --- Where it is, if it's in space: then distance, direction, and motion set its level, pan, and
  --- pitch, and `pan` is not used.
  place: AudioPlace?,
  --- How much it matters when there are more voices than the context mixes (0): higher keeps its
  --- place over lower, whatever their levels.
  priority: number?,
  --- What it does while culled: keeps time silently (`advance`, the default), holds its place
  --- (`pause`), or ends (`stop`).
  culled: ('advance' | 'pause' | 'stop')?,
}

--- A voice's place in space, in the world's own units and axes. Every field is optional: on
--- `play` the rest are the defaults, on `AudioVoice:place` what they were. `cone` angles are whole
--- angles in degrees: full level inside `inner` of `direction`, `outside` (0 to 1) beyond `outer`.
--- `distance` is the model (`inverse` by default, `linear`, `exponential`, `none`) between
--- `reference` (1, full level) and `maximum` (no quieter beyond), at `rolloff` (1). `doppler` (1)
--- scales the pitch shift from motion. `gain` (1) and `lowpass` (a cutoff in hertz) are for what
--- lies between the voice and the listener, as the application works it out.
export type AudioPlace = {
  position: vector?,
  velocity: vector?,
  direction: vector?,
  cone: { inner: number?, outer: number?, outside: number? }?,
  distance: ('none' | 'inverse' | 'linear' | 'exponential')?,
  reference: number?,
  maximum: number?,
  rolloff: number?,
  doppler: number?,
  gain: number?,
  lowpass: number?,
}

--- How to make a context: 48000 frames per second, 2 channels, 256 voices, 256 nodes (buses and
--- processors, the master included), 1024 connections between them, and room for 4096 waiting
--- commands, unless told otherwise. Space is right-handed (forward crossed with up points right)
--- unless `handedness` is `left`, and sound travels at `speedOfSound` (343) of the world's units a
--- second.
export type AudioContextOptions = {
  rate: number?,
  channels: number?,
  voices: number?,
  nodes: number?,
  connections: number?,
  commands: number?,
  speedOfSound: number?,
  handedness: ('right' | 'left')?,
  --- Voices mixed at once, if fewer than `voices`: the rest are culled, by priority and then by
  --- loudness, until there is room.
  physical: number?,
}

--- A stream: a bounded ring of interleaved frames that one writer fills, from any worker, while
--- one voice plays it. The voice plays silence where the writer has fallen behind (`missed`
--- counts it), and ends once the writer has finished and everything written has played. A
--- script's stream plays every frame it is given, late ones after the gap; a feed's keeps time,
--- letting go of what came too late. `late` counts the silence played after a seek's frame
--- because the feed hadn't decoded from the new frame yet.
export type AudioStream = {
  channels: (self: AudioStream) -> number,
  rate: (self: AudioStream) -> number,
  --- Frames there is room for now.
  room: (self: AudioStream) -> number,
  --- Writes as many whole frames of interleaved 32-bit floats as fit, from the first `frames`
  --- of the buffer (all of it without), and returns how many.
  write: (self: AudioStream, samples: buffer, frames: number?) -> number,
  --- Waits until there is room for `frames`, or `timeout` seconds pass (forever without one);
  --- true if there is. It sleeps as long as playing at the stream's rate takes to make the room.
  wait: (self: AudioStream, frames: number, timeout: number?) -> boolean,
  --- Says the writer is done: once played to its end, the voice ends.
  finish: (self: AudioStream) -> (),
  stats: (self: AudioStream) -> {
    written: number,
    read: number,
    room: number,
    missed: number,
    late: number,
    finished: boolean,
  },
  --- A handle to send a worker, which opens the same stream with `jess.audio.stream`.
  handle: (self: AudioStream) -> JessHandle,
}

--- How a feed reads its file: as `format` (detected unless named), `seconds` (1) of it ahead in
--- its stream, `block` frames (4096) at a time, from frame `start` (0); and with `loop`, from
--- `loopStart` (0) again at the end instead of finishing the stream.
export type AudioFeedOptions = {
  format: ('mp3' | 'vorbis' | 'opus')?,
  seconds: number?,
  block: number?,
  start: number?,
  loop: boolean?,
  loopStart: number?,
}

--- What a feed has done: whether its thread is `done`, how many times it went back to its
--- `loopStart`, and the `error` the decoder failed with, if it did (the stream finished there).
export type AudioFeedStatus = { done: boolean, loops: number, error: string? }

--- A compressed file decoded into a stream on a thread of its own. It ends at the file's end
--- (unless it loops), when stopped, on a decoding error, or once nothing else holds its stream;
--- the runtime's end stops it.
export type AudioFeed = {
  --- The stream it fills, at the file's rate and channels, to play.
  stream: (self: AudioFeed) -> AudioStream,
  status: (self: AudioFeed) -> AudioFeedStatus,
  --- Stops decoding, leaving what it wrote to play; the stream isn't finished.
  stop: (self: AudioFeed) -> (),
}

--- An output's options: a context's, and the device's.
export type AudioOutputOptions = AudioContextOptions & { device: ('default' | 'null')?, period: number? }

--- An output device: the platform API it plays through, its rate and channels, the frames it
--- asks for at a time and how many periods it buffers (`latency`, about, in frames, is how far
--- what you hear lags `now`), and what has happened to it: `stopped`, `rerouted` to a new default
--- device, `interrupted` by the system, whether the engine `failed` on its thread, and whether
--- the output was `closed`.
export type AudioDevice = {
  backend: string,
  rate: number,
  channels: number,
  period: number,
  periods: number,
  latency: number,
  stopped: number,
  rerouted: number,
  interrupted: number,
  failed: boolean,
  closed: boolean,
}

--- Where the listener is and which way it faces; any field left out stays as it was.
export type AudioListener = { position: vector?, forward: vector?, up: vector?, velocity: vector? }

--- A ramp's shape: a straight line, or the same ratio every frame (both ends above 0), which is
--- even steps in decibels.
export type AudioCurve = 'linear' | 'exponential'

--- A bus's level since it was last read, after its gain: the peak sample's magnitude and the
--- RMS, linear, across its channels.
export type AudioMeter = { peak: number, rms: number }

--- How a node sends to another: at `level` (1), tapped after its processing (`post`, the usual: a
--- bus's gain and mute) or before it (`pre`), from frame `at`.
export type AudioSendOptions = { level: number?, tap: ('post' | 'pre')?, at: number? }

--- One of a node's parameters: its range, default, and unit (`Hz`, `dB`, `s`, or empty), and how
--- often it can change: on every frame that is a multiple of 32 while it moves (`control`), or
--- every sample (`audio`).
export type AudioParam = {
  name: string,
  min: number,
  max: number,
  default: number,
  unit: string,
  rate: 'control' | 'audio',
}

--- A node of a context's graph: a bus (a mixer, `kind` `mixer`), or a processor. A bus sums what
--- reaches it, runs its insert chain, applies its gain and mute, and feeds its route and sends.
--- Every command takes an optional `at`, an output frame; without one, the next frame rendered.
--- Once the node is removed the handle names nothing.
export type AudioNode = {
  kind: (self: AudioNode) -> string,
  --- Its parameters, in order.
  params: (self: AudioNode) -> { AudioParam },
  --- Sets a parameter by name (a bus has `gain`, linear, and `mute`, 0 or 1); a name it doesn't
  --- have, or a value out of range, is an error.
  set: (self: AudioNode, param: string, value: number, at: number?) -> boolean,
  --- Ramps a parameter to `value` over `frames` frames from `at`: every frame for an audio-rate
  --- parameter, every 32 for a control-rate one.
  ramp: (self: AudioNode, param: string, value: number, frames: number, at: number?, curve: AudioCurve?) -> boolean,
  --- From `at`, drops every change of a parameter sent before this one and still waiting for its
  --- frame, and stops a ramp of it where it has got to. Changes sent after it stand.
  cancel: (self: AudioNode, param: string, at: number?) -> boolean,
  --- Routes the node into another, replacing its route; a route that would loop back is an error.
  route: (self: AudioNode, parent: AudioNode, at: number?) -> (),
  --- Adds a send to `target`, or changes the one there.
  send: (self: AudioNode, target: AudioNode, options: AudioSendOptions?) -> (),
  unsend: (self: AudioNode, target: AudioNode, at: number?) -> boolean,
  --- Listens to `key` on its sidechain from `at`, or to nothing with nil (a compressor then follows
  --- its own input). The key runs first; a key the node feeds is a loop, and an error.
  listen: (self: AudioNode, key: AudioNode?, at: number?) -> boolean,
  --- Removes the node once nothing feeds it, with its insert chain; what has a tail rings out
  --- first. Its connections out go with it.
  remove: (self: AudioNode, at: number?) -> boolean,
  live: (self: AudioNode) -> boolean,
  --- Frames its output lags the voices that reach it, by the longest path's processors.
  latency: (self: AudioNode) -> number,
  --- A bus's output since it was last read; an error for another node.
  meter: (self: AudioNode) -> AudioMeter,
  --- Puts a processor of `kind` in the node's insert chain, last or at `index` (from 1), made with
  --- `settings`: its parameters by name, and whatever the kind is made with.
  insert: (self: AudioNode, kind: string, settings: { [string]: number | string }?) -> AudioNode,
}

--- How a patch connects two nodes: from output `from` (the first) to input `to` (the first audio
--- input, or any input port, or a parameter to modulate), at `level` (1), tapped after the source's
--- processing (`post`) or before it (`pre`), and, for a connection that closes a loop, delayed by
--- `feedback` frames (at least 128). A voice connects at a level, to an audio input.
export type AudioConnectOptions = {
  from: string?,
  to: string?,
  level: number?,
  tap: ('post' | 'pre')?,
  feedback: number?,
}

--- The graph as an `AudioContext:patch` body sees it. Every change is collected; once the body
--- returns, they take effect together on the patch's frame, or, if any is wrong or the body
--- raises, none of them does.
export type AudioPatch = {
  connect: (self: AudioPatch, from: AudioNode | AudioVoice, to: AudioNode, options: AudioConnectOptions?) -> (),
  disconnect: (
    self: AudioPatch,
    from: AudioNode | AudioVoice,
    to: AudioNode,
    options: { from: string?, to: string? }?
  ) -> (),
  --- Routes `node` into `parent`, replacing its route.
  route: (self: AudioPatch, node: AudioNode, parent: AudioNode) -> (),
  --- Puts an unconnected processor in `host`'s insert chain, last or at `index` (from 1).
  insert: (self: AudioPatch, host: AudioNode, node: AudioNode, index: number?) -> (),
  --- Removes a node once nothing feeds it.
  remove: (self: AudioPatch, node: AudioNode) -> (),
}

--- What a context's engine has done, as of its last render: `frames` rendered (the clock), voices
--- `active` in it and `allocated` (playing or waiting to start), commands carried out `late`
--- (stamped for a frame already rendered), output samples that weren't finite and were written as
--- silence (`nonfinite`), commands `pending` for a later frame, voices `culled` in the last block
--- for want of room, and voices `stolen`, ended for it, all told, and graph `revisions` carried out
--- (playing and stopping voices revises nothing).
export type AudioStats = {
  frames: number,
  active: number,
  allocated: number,
  late: number,
  nonfinite: number,
  pending: number,
  culled: number,
  stolen: number,
  revisions: number,
}

export type AudioVoiceState = 'scheduled' | 'playing' | 'paused' | 'ended'

--- One playback of a Pcm. Every command takes an optional `at`, an output frame to carry it out
--- on; without one, the next frame rendered. Once the voice ends the handle names nothing, and
--- its commands do nothing and return false.
export type AudioVoice = {
  --- Stops it on frame `at`, fading out over `fade` frames first (0).
  stop: (self: AudioVoice, at: number?, fade: number?) -> boolean,
  set: (self: AudioVoice, param: 'gain' | 'pan' | 'rate', value: number, at: number?) -> boolean,
  --- Ramps a parameter to `value` over `frames` frames from `at`, sample by sample.
  ramp: (
    self: AudioVoice,
    param: 'gain' | 'pan' | 'rate',
    value: number,
    frames: number,
    at: number?,
    curve: AudioCurve?
  ) -> boolean,
  --- Loops over source frames `start` up to `stop` from `at`: playback reaching `stop` goes on at
  --- `start`.
  loop: (self: AudioVoice, start: number, stop: number, at: number?) -> boolean,
  --- Lets go of the loop from `at`: playback runs on past it, into whatever follows (an outro).
  release: (self: AudioVoice, at: number?) -> boolean,
  --- Moves a voice in space from `at`, changing the fields given; false for a voice not in space.
  place: (self: AudioVoice, place: AudioPlace, at: number?) -> boolean,
  --- Sends it to `node` at `level` as well as wherever it plays, or changes the level it plays
  --- there at (where it plays first included).
  send: (self: AudioVoice, node: AudioNode, level: number, at: number?) -> boolean,
  --- Stops it playing into `node`; false if it didn't.
  unsend: (self: AudioVoice, node: AudioNode, at: number?) -> boolean,
  --- Plays it into `node` instead of where it plays first, keeping its sends. Moving a voice
  --- changes nothing in the graph.
  route: (self: AudioVoice, node: AudioNode, at: number?) -> boolean,
  --- Pauses it on frame `at`, holding its place: unmixed, and counted against no budget.
  pause: (self: AudioVoice, at: number?) -> boolean,
  --- Plays it on from where it was paused, on frame `at`; a voice made with
  --- `AudioContext:voice` starts here.
  play: (self: AudioVoice, at: number?) -> boolean,
  --- Moves it to source frame `frame` on frame `at`: at once for PCM, and for a stream a feed
  --- decodes once the feed has decoded from there. Stamped at least `seekLead()` ahead, the seek
  --- is prepared and lands on `at` without a gap; if the feed is still late on `at`, the voice
  --- keeps time in silence and joins where it would have got to. A stream a script writes can't
  --- seek, and says so.
  seek: (self: AudioVoice, frame: number, at: number?) -> boolean,
  --- How far ahead, in frames, a seek has to be stamped to be prepared: half its stream. Nil for a
  --- voice that isn't a stream a feed decodes, which needs no lead.
  seekLead: (self: AudioVoice) -> number?,
  --- The source frame it is at, as of the last render (for a stream, counted from where it
  --- started or last sought to); nil once it has ended.
  position: (self: AudioVoice) -> number?,
  state: (self: AudioVoice) -> AudioVoiceState,
}

--- An audio context: voices mixed on a sample clock. The clock is output frames rendered, and
--- moves only when the engine renders.
export type AudioContext = {
  rate: (self: AudioContext) -> number,
  channels: (self: AudioContext) -> number,
  --- The next frame the engine renders. A command stamped for it or later lands on its frame.
  now: (self: AudioContext) -> number,
  --- Starts a voice playing decoded audio or a stream (which plays once, with no offset or loop).
  play: (self: AudioContext, source: AudioPcm | AudioStream, options: AudioPlayOptions?) -> AudioVoice,
  --- A voice as `play` makes it, paused: it holds a slot and waits for `AudioVoice:play`.
  voice: (self: AudioContext, source: AudioPcm | AudioStream, options: AudioPlayOptions?) -> AudioVoice,
  --- The master bus: the output. It has no route and is never removed.
  master: (self: AudioContext) -> AudioNode,
  --- A bus routed into `parent` (the master), at `gain` (1), muted or not, with `channels` (the
  --- context's); voices can play into it at once.
  bus: (
    self: AudioContext,
    options: { parent: AudioNode?, gain: number?, muted: boolean?, channels: number? }?
  ) -> AudioNode,
  --- A node running a processor of `kind` (`audio.processors()` lists them), made with `settings`:
  --- its parameters by name, `channels` (the context's), and whatever the kind is made with.
  --- It is connected to nothing.
  node: (self: AudioContext, kind: string, settings: { [string]: number | string }?) -> AudioNode,
  --- Runs `body` with the graph, and makes every change it asks for together from frame `at`, or
  --- none of them. Changes to the graph take effect in the order they're made: one stamped
  --- earlier than one still waiting is an error.
  patch: (self: AudioContext, body: (graph: AudioPatch) -> (), at: number?) -> (),
  --- Renders `frames` frames and returns them as interleaved 32-bit floats.
  render: (self: AudioContext, frames: number) -> buffer,
  stats: (self: AudioContext) -> AudioStats,
  --- Moves the listener from `at`, changing the fields given. It starts at the origin facing
  --- `-z` with `y` up, still.
  listener: (self: AudioContext, listener: AudioListener, at: number?) -> (),
  --- The device rendering an output, or nil for an offline context.
  device: (self: AudioContext) -> AudioDevice?,
  --- Stops an output's device and drops every voice it played; commands after it are errors.
  --- An output plays until it is closed or its runtime ends, held or not.
  close: (self: AudioContext) -> (),
  --- How many more commands the queue to the engine has room for.
  room: (self: AudioContext) -> number,
  --- Runs `body`, and sends every command it makes to the engine together: ones not stamped for
  --- later are carried out on the same frame. Groups don't nest.
  group: (self: AudioContext, body: () -> ()) -> (),
}

--- A shader type, from `jess.shader`: a value type (`float`, `int`, `uint`, `vec2`..`vec4`,
--- `vec2i`..`vec4i`, `vec2u`..`vec4u`, `mat3`, `mat4`), a texture (`texture2d`, `texture2dArray`,
--- `textureCube`, `texture3d`) or `sampler`, or a struct or array type from `shader.struct` and
--- `shader.array`. It's what a program's attributes and bindings declare (`tint = shader.vec4`).
--- Called, the vector types build a vector from values and numbers whose sizes add up to theirs,
--- or from one number repeated (`shader.vec4(position, 1)`); a number in an integer vector is
--- that vector's integer, and must be whole. `shader.float(0.5)`, `shader.int(-3)`, and
--- `shader.uint(7)` are constants. One value of another scalar converts (`shader.float(index)`,
--- `shader.vec3(cell)`), keeping its size; `shader.mat3` and `shader.mat4` take their columns.
--- The other types can't be constructed. `tostring` gives the type's name (`Vec4f`, `Light`,
--- `Light[8]`).
declare extern type ShaderType with
  __call: (self: ShaderType, ...ShaderExpr | number) -> ShaderExpr
  __tostring: (self: ShaderType) -> string
end

--- A symbolic, typed value in the shader program under construction: not a number, and not a GPU
--- value. Operators (`+ - * / %` and unary `-`) append expressions to the program and return new
--- values; a bare number beside one is a `Float`. `.x`, `.xyz`, `.zyx`: a swizzle of one to four
--- of `x`, `y`, `z`, and `w`. A mistake fails at the line that made it, with the types involved.
--- `tostring` gives `ShaderExpr(Vec4f)`, and `==` whether two handles name one expression. A value
--- is only usable while its `shader.program` call runs.
---
--- The checker sees every name a binding has as one of these, as it sees every value's shader
--- type as this one: a struct, an array, and a texture are indexed, measured, and sampled through
--- it, and which one a name is gets checked when the module runs.
declare extern type ShaderExpr with
  [string | number | ShaderExpr]: ShaderExpr
  __add: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __sub: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __mul: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __div: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __mod: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr
  __unm: (self: ShaderExpr) -> ShaderExpr
  __len: (self: ShaderExpr) -> number
  __eq: (self: ShaderExpr, other: ShaderExpr) -> boolean
  __tostring: (self: ShaderExpr) -> string
end

--- The declared attributes of one rate, by name: `input.attributes` (per vertex) or
--- `input.instance` (per instance), readable in the vertex function. A name the program didn't
--- declare is an error listing the ones it did.
declare extern type ShaderAttributes with
  [string]: ShaderExpr
  __tostring: (self: ShaderAttributes) -> string
end

--- What one frequency binds (`input.pass`, `input.material`, `input.draw`), a struct member, or
--- an array, on the way to a value. Indexing it by name, or an array by a number or shader value
--- (from 0), goes one step in; `#` is an array's length. A step that reaches a value reads it, and
--- a texture or sampler is its handle. `tostring` gives `ShaderPlace(material)`.
declare extern type ShaderPlace with
  [string | number | ShaderExpr]: ShaderExpr
  __len: (self: ShaderPlace) -> number
  __tostring: (self: ShaderPlace) -> string
end

--- A declared texture, with the sampler declared with it, for `shader.sample`. `tostring` gives
--- its kind: `ShaderTexture(TextureCube)`.
declare extern type ShaderTexture with
  __tostring: (self: ShaderTexture) -> string
end

--- A sampler declared on its own, for `shader.sample`'s three-argument form.
declare extern type ShaderSampler with
  __tostring: (self: ShaderSampler) -> string
end

--- The values the pipeline gives one stage, by name: `input.builtin`. The vertex function has
--- `vertexIndex` and `instanceIndex`, `UInt`s; the fragment function has `position`, a `Vec4f`
--- (`x` and `y` in pixels from the target's top left, at the pixel's centre, `z` its depth, `w`
--- one over the clip position's `w`), and `frontFacing`, a `Bool`.
declare extern type ShaderBuiltins with
  [string]: ShaderExpr
  __tostring: (self: ShaderBuiltins) -> string
end

--- A stage function's input. `pass`, `material`, and `draw` are what each frequency binds;
--- `builtin` the values the pipeline gives the stage; `attributes` and `instance`, in the vertex
--- function, the declared attributes; in the fragment function every other name is a value the
--- vertex function returned. A name it doesn't have is an error listing the ones it does.
declare extern type ShaderInput with
  attributes: ShaderAttributes
  instance: ShaderAttributes
  builtin: ShaderBuiltins
  pass: ShaderPlace
  material: ShaderPlace
  draw: ShaderPlace
  [string]: ShaderExpr
  __tostring: (self: ShaderInput) -> string
end

--- A finished, validated shader program: what a shader module returns, for jess to lower to the
--- backend. `tostring` gives `ShaderProgram(3 attributes, 2 uniforms, 1 texture, 2 varyings)`.
declare extern type ShaderProgram with
  --- The per-vertex attributes, sorted by name, each with its type's name (`Vec3f`).
  attributes: { { name: string, type: string } }
  --- The per-instance attributes, the same way.
  instance: { { name: string, type: string } }
  --- What the pass binds, sorted by name, each with its type's name (`Vec4f`, `Camera`,
  --- `Light[8]`, `Texture2D`, `Sampler`).
  pass: { { name: string, type: string } }
  --- What the material binds, the same way.
  material: { { name: string, type: string } }
  --- What each draw binds, the same way.
  draw: { { name: string, type: string } }
  --- What the vertex function returned besides `position`, sorted by name, as the fragment
  --- function reads it.
  varyings: { { name: string, type: string } }
  __tostring: (self: ShaderProgram) -> string
end

--- What `shader.program` takes. `attributes` and `instance` are what each vertex and each
--- instance has (`Int`, `UInt`, `Float`, vectors, and matrices), read from its vertex buffers.
--- `pass`, `material`, and `draw` are what each frequency binds: values, structs, and arrays in
--- its uniform block, `texture2d` (each declared with a sampler of the same name), and `sampler`.
--- All are declared sorted by name. `vertex` returns `position` (a `Vec4f`) and the values to pass
--- to the fragment stage, each named; `fragment` returns the `Vec4f` color. Both run once, while
--- `shader.program` runs.
export type ShaderProgramSpec = {
  attributes: { [string]: ShaderType }?,
  instance: { [string]: ShaderType }?,
  pass: { [string]: ShaderType }?,
  material: { [string]: ShaderType }?,
  draw: { [string]: ShaderType }?,
  vertex: (input: ShaderInput) -> { [string]: ShaderExpr },
  fragment: (input: ShaderInput) -> ShaderExpr,
}

--- The arguments after the script's name, as strings, for a script `jess run` runs from a file;
--- `arg[0]` is the script's path. They're the script's `...` too.
declare arg: { [number]: string }

--- `jess.shader`, and what `require("@jess/shader")` returns. A shader module runs once and
--- returns `shader.program { ... }`. Every function takes shader values or numbers (a number is
--- a `Float`) and fails at its line, in shader terms, when the types don't fit:
--- `dot(Vec3f, Vec4f) is invalid: expected two vectors of the same type`.
export type ShaderModule = {
  float: ShaderType,
  int: ShaderType,
  uint: ShaderType,
  vec2: ShaderType,
  vec3: ShaderType,
  vec4: ShaderType,
  vec2i: ShaderType,
  vec3i: ShaderType,
  vec4i: ShaderType,
  vec2u: ShaderType,
  vec3u: ShaderType,
  vec4u: ShaderType,
  mat3: ShaderType,
  mat4: ShaderType,
  texture2d: ShaderType,
  texture2dArray: ShaderType,
  textureCube: ShaderType,
  texture3d: ShaderType,
  sampler: ShaderType,
  --- A struct type: named fields of value, struct, and array types, laid out by jess.
  struct: (name: string, fields: { [string]: ShaderType }) -> ShaderType,
  --- An array type: `length` (at least 1) values or structs.
  array: (element: ShaderType, length: number) -> ShaderType,
  --- Builds a program: declares the attributes and bindings, runs `vertex` and passes what it
  --- returned to the fragment stage, runs `fragment`, then validates the whole program, listing
  --- every problem with its line.
  program: (spec: ShaderProgramSpec) -> ShaderProgram,
  --- The smaller and larger of two values, per component.
  min: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  max: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  --- `value` clamped to `low..high`, per component.
  clamp: (value: ShaderExpr | number, low: ShaderExpr | number, high: ShaderExpr | number) -> ShaderExpr,
  --- The dot product of two vectors of one size, and the cross product of two `Vec3f`.
  dot: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  cross: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  --- A vector scaled to length 1, and a vector's length (a `Float`'s absolute value).
  normalize: (value: ShaderExpr | number) -> ShaderExpr,
  length: (value: ShaderExpr | number) -> ShaderExpr,
  --- The distance between two points, `incident` reflected about the plane of a unit `normal`,
  --- and refracted through it at the ratio of indices `eta`.
  distance: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  reflect: (incident: ShaderExpr, normal: ShaderExpr) -> ShaderExpr,
  refract: (incident: ShaderExpr, normal: ShaderExpr, eta: ShaderExpr | number) -> ShaderExpr,
  --- A matrix's rows as its columns, and its determinant.
  transpose: (matrix: ShaderExpr) -> ShaderExpr,
  determinant: (matrix: ShaderExpr) -> ShaderExpr,
  --- How fast a `Float` or float vector changes across the screen: horizontally, vertically,
  --- and the sum of both sizes. Fragment stage only.
  dpdx: (value: ShaderExpr) -> ShaderExpr,
  dpdy: (value: ShaderExpr) -> ShaderExpr,
  fwidth: (value: ShaderExpr) -> ShaderExpr,
  --- The absolute value of a number, and its sign (-1, 0, or 1) of an `Int` or `Float`, per
  --- component.
  abs: (value: ShaderExpr | number) -> ShaderExpr,
  sign: (value: ShaderExpr | number) -> ShaderExpr,
  --- A `Float` or float vector rounded, per component: down, up, to the nearest integer (halves
  --- to even), and toward zero; and what `floor` drops.
  floor: (value: ShaderExpr | number) -> ShaderExpr,
  ceil: (value: ShaderExpr | number) -> ShaderExpr,
  round: (value: ShaderExpr | number) -> ShaderExpr,
  trunc: (value: ShaderExpr | number) -> ShaderExpr,
  fract: (value: ShaderExpr | number) -> ShaderExpr,
  --- Roots, powers, and logarithms of a `Float` or float vector, per component.
  sqrt: (value: ShaderExpr | number) -> ShaderExpr,
  inverseSqrt: (value: ShaderExpr | number) -> ShaderExpr,
  exp: (value: ShaderExpr | number) -> ShaderExpr,
  exp2: (value: ShaderExpr | number) -> ShaderExpr,
  log: (value: ShaderExpr | number) -> ShaderExpr,
  log2: (value: ShaderExpr | number) -> ShaderExpr,
  pow: (base: ShaderExpr | number, exponent: ShaderExpr | number) -> ShaderExpr,
  --- Trigonometry in radians, per component; `atan2(y, x)` is the angle of the point `(x, y)`.
  sin: (value: ShaderExpr | number) -> ShaderExpr,
  cos: (value: ShaderExpr | number) -> ShaderExpr,
  tan: (value: ShaderExpr | number) -> ShaderExpr,
  asin: (value: ShaderExpr | number) -> ShaderExpr,
  acos: (value: ShaderExpr | number) -> ShaderExpr,
  atan: (value: ShaderExpr | number) -> ShaderExpr,
  atan2: (y: ShaderExpr | number, x: ShaderExpr | number) -> ShaderExpr,
  radians: (degrees: ShaderExpr | number) -> ShaderExpr,
  degrees: (radians: ShaderExpr | number) -> ShaderExpr,
  --- A `Float` or float vector clamped to `0..1`; 0 below `edge` and 1 from it; and a smooth
  --- curve from 0 at `low` to 1 at `high`. Edges may be a `Float` beside a vector.
  saturate: (value: ShaderExpr | number) -> ShaderExpr,
  step: (edge: ShaderExpr | number, value: ShaderExpr | number) -> ShaderExpr,
  smoothstep: (low: ShaderExpr | number, high: ShaderExpr | number, value: ShaderExpr | number) -> ShaderExpr,
  --- `start + (finish - start) * amount`, per component.
  mix: (start: ShaderExpr | number, finish: ShaderExpr | number, amount: ShaderExpr | number) -> ShaderExpr,
  --- Comparisons of two scalars of one type, to a `Bool`: `equal` and `notEqual` any scalars, the
  --- rest `Int`, `UInt`, or `Float`.
  equal: (left: ShaderExpr | number | boolean, right: ShaderExpr | number | boolean) -> ShaderExpr,
  notEqual: (left: ShaderExpr | number | boolean, right: ShaderExpr | number | boolean) -> ShaderExpr,
  less: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  lessEqual: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  greater: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  greaterEqual: (left: ShaderExpr | number, right: ShaderExpr | number) -> ShaderExpr,
  --- Both, either, and not, of `Bool`s; a Luau boolean is a `Bool` constant.
  logicalAnd: (left: ShaderExpr | boolean, right: ShaderExpr | boolean) -> ShaderExpr,
  logicalOr: (left: ShaderExpr | boolean, right: ShaderExpr | boolean) -> ShaderExpr,
  logicalNot: (value: ShaderExpr | boolean) -> ShaderExpr,
  --- Bitwise and, or, and exclusive or of two `Int` or `UInt` values of one type, and every bit
  --- flipped.
  bitAnd: (left: ShaderExpr, right: ShaderExpr) -> ShaderExpr,
  bitOr: (left: ShaderExpr, right: ShaderExpr) -> ShaderExpr,
  bitXor: (left: ShaderExpr, right: ShaderExpr) -> ShaderExpr,
  bitNot: (value: ShaderExpr) -> ShaderExpr,
  --- An `Int` or `UInt` value shifted by a `UInt` amount, or a `UInt` vector of its size: right
  --- shifts of an `Int` keep its sign.
  shiftLeft: (value: ShaderExpr, amount: ShaderExpr) -> ShaderExpr,
  shiftRight: (value: ShaderExpr, amount: ShaderExpr) -> ShaderExpr,
  --- `accept` where `condition` holds, else `reject`, two values of one scalar or vector type.
  --- Both are computed.
  select: (condition: ShaderExpr | boolean, accept: ShaderExpr | number, reject: ShaderExpr | number) -> ShaderExpr,
  --- A texture read, a `Vec4f`: a declared texture with the sampler declared with it and its
  --- coordinates (`Vec2f` for `texture2d` and `texture2dArray`, `Vec3f` for `textureCube` and
  --- `texture3d`), or a texture, a sampler declared on its own, and coordinates. An array texture
  --- takes its layer last, an `Int` or `UInt`. Fragment stage only.
  sample: ((texture: ShaderExpr, coordinates: ShaderExpr, layer: (ShaderExpr | number)?) -> ShaderExpr) & ((texture: ShaderExpr, sampler: ShaderExpr, coordinates: ShaderExpr, layer: (ShaderExpr | number)?) -> ShaderExpr),
}

declare jess: {
  version: string,
  --- What a measurement needs from the host.
  bench: {
    --- Whether this jess was built with the verified toolchain, as releases are. A number from
    --- any other build measures a slower Luau, so a harness refuses to produce one.
    verified: boolean,
    --- Runs a full garbage collection, so one batch's garbage isn't collected inside the next
    --- one's timing.
    collect: () -> (),
  },
  --- A missing value inside an array (such as an empty link in a node's children), where `nil`
  --- would shift everything after it.
  null: JessNull,
  --- Whether the running code holds `capability` (`'process.environment'`, `'network.transport'`,
  --- ...): the runtime's grant, or under a ScriptDomain the broker's. Asking is no denial. A name
  --- no jess runtime can be granted raises, so a misspelling isn't read as "not granted".
  granted: (capability: string) -> boolean,
  --- The calling module's own package payload: every file's path in canonical order
  --- (`jess.toml` first), and a read of one file's bytes, nil for a path the payload lacks. A
  --- package shares its files by exporting a module that hands them out. A script belongs to no
  --- package and raises.
  payload: () -> { files: { string }, read: (path: string) -> buffer? },
  --- Typed shader construction; `require("@jess/shader")` is the same table.
  shader: ShaderModule,

  --- Script contexts (`@jess/context`): binds handlers to the phases the host scheduled for a
  --- context it declared. Only a runtime a ScriptDomain owns has contexts; elsewhere `bind` errors.
  context: {
    --- Binds one handler per phase name (`startup`, `update`, `fixedUpdate`, `event`,
    --- `shutdown`, ...) to the context `name`; a phase the context doesn't schedule is an error.
    bind: (name: string, handlers: ContextHandlers) -> (),
  },

  --- Workers (`@jess/worker`): isolated Luau states beside the domain, talking in messages.
  worker: {
    --- Spawns a worker from its module source, a chunk returning the message handler; needs the
    --- `worker.spawn` capability, and the worker holds `capabilities` (the spawner's, by default).
    --- With `shareServices`, it sees the domain's services too (its live input).
    spawn: (options: WorkerOptions) -> Worker,
    --- From inside a worker: sends a message to the domain, besides what the handler returns.
    send: (message: unknown) -> (),
  },

  --- Named events (`@jess/events`): application-defined events for the handlers bound to a name
  --- (a managed module's `on.event`). Only a domain's own code emits; elsewhere `emit` errors.
  events: {
    --- Queues the event `name` with `payload`, which must be transferable (no functions,
    --- userdata, or tables nested past 32 deep). Nothing runs now: every handler bound to the
    --- name gets it at the domain's next event drain, in the order events were emitted.
    emit: (name: string, payload: unknown?) -> (),
  },

  --- The domain's interfaces (`@jess/interfaces`): plain tables the application's packages
  --- provide through `[managed]` modules, composed before the application's entry runs. They are
  --- this domain's alone; a worker, another domain, or a runtime outside one has none.
  interfaces: {
    --- The effective implementation of the interface `id`, the table the last provider in load
    --- order returned; an error naming the ids the domain has when no package provides it.
    get: (id: string) -> any,
    --- The same, or nil when no package provides `id`: for an interface that is optional.
    tryGet: (id: string) -> any?,
  },

  --- What a script asks of the host running it (`@jess/application`). Only a domain's own code
  --- under a host asks; elsewhere `exit` errors.
  application: {
    --- Asks the host to stop with `status` (0 without one, an integer up to 255) after the
    --- current frame. Shutdown handlers still run; a later call replaces the status.
    exit: (status: number?) -> (),
  },

  --- The native half of `@jess/input`, which wraps it: compiling a binding document and the
  --- input runtime. See `jess::input`.
  input: {
    --- Compiles and validates a binding document, as JSON; every problem is reported at once.
    graph: (json: string) -> InputGraph,
    --- The binding document format version this jess reads and writes.
    formatVersion: number,
    --- A control's canonical `class:Name` form, or an error naming what is wrong with it.
    control: (control: string) -> string,
    --- The domain's live input runtime under a host; a headless one of the script's own otherwise.
    runtime: () -> InputRuntime,
  },

  --- The native half of `@jess/audio`, which wraps it: PCM from interleaved bytes, and contexts
  --- that mix voices on a sample clock. See `jess::audio`.
  audio: {
    --- PCM from interleaved bytes, `channels` samples per frame, each stored as `format`.
    pcm: (data: buffer | string, options: { format: AudioSampleFormat, channels: number, rate: number }) -> AudioPcm,
    --- A context the script renders.
    offline: (options: AudioContextOptions?) -> AudioContext,
    --- A context an output device renders: the default one, or `null`, which plays to nowhere in
    --- real time. It runs at the device's own rate unless `rate` asks for another, and asks for
    --- `period` frames at a time as a hint. Needs `audio.output`, and a jess built with the
    --- audio-device feature.
    output: (options: AudioOutputOptions?) -> AudioContext,
    --- A stream of `channels` (2) at `rate` (48000) holding `seconds` (1, at most 60) of frames; or,
    --- given a stream's handle, the stream itself, in whatever worker the handle was sent to.
    stream: (options: { channels: number?, rate: number?, seconds: number? } | JessHandle) -> AudioStream,
    --- An MP3, Ogg Vorbis, or Ogg Opus file decoded into a stream of its own layout on a thread
    --- of its own, which keeps the stream full whatever the script is doing.
    feed: (data: buffer | string, options: AudioFeedOptions?) -> AudioFeed,
    --- The processor kinds `AudioContext:node` and `AudioNode:insert` make, a host's own included.
    processors: () -> { string },
  },
}
