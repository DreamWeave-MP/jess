--!strict
-- Compare the shipped parser's help with the reference, without executing package code.
local fs = require '@dream/fs'
local process = require '@dream/process'

local Commands = {
  { args = { 'run' }, page = 'run' },
  { args = { 'test' }, page = 'test' },
  { args = { 'check' }, page = 'check' },
  { args = { 'pack' }, page = 'package' },
  { args = { 'package' }, page = 'package' },
  { args = { 'package', 'inspect' }, page = 'package' },
  { args = { 'package', 'graph' }, page = 'package' },
  { args = { 'package', 'test' }, page = 'package' },
  { args = { 'package', 'check' }, page = 'package' },
  { args = { 'package', 'run' }, page = 'package' },
  { args = { 'workspace' }, page = 'workspace' },
  { args = { 'workspace', 'info' }, page = 'workspace' },
  { args = { 'workspace', 'targets' }, page = 'workspace' },
  { args = { 'workspace', 'graph' }, page = 'workspace' },
  { args = { 'workspace', 'run' }, page = 'workspace' },
  { args = { 'workspace', 'sync' }, page = 'workspace' },
  { args = { 'workspace', 'test' }, page = 'workspace' },
  { args = { 'workspace', 'pack' }, page = 'workspace' },
  { args = { 'install' }, page = 'install' },
  { args = { 'uninstall' }, page = 'install' },
  { args = { 'init' }, page = 'utility-commands' },
  { args = { 'luau-types' }, page = 'utility-commands' },
  { args = { 'completions' }, page = 'utility-commands' },
  { args = { 'man' }, page = 'utility-commands' },
}

local function help(args: { string }): string
  local request = table.clone(args)
  table.insert(request, '--help')
  local result, problem = process.run('jess', request, { stdout = 'capture', stderr = 'capture' })
  if not result or not result.success then error(`CLI reference: help failed for {table.concat(request, ' ')}: {problem}`, 0) end
  return result.stdout or ''
end

local function verifyCommands(parent: string?)
  local output = help(if parent then { parent } else {})
  local section = string.match(output, 'Commands:\n(.-)\nOptions:')
  if not section then error('CLI reference: no command list in help', 0) end
  local expected: { [string]: boolean } = {}
  for _, command in Commands do
    if parent and #command.args == 2 and command.args[1] == parent then expected[command.args[2]] = true end
    if not parent and #command.args == 1 then expected[command.args[1]] = true end
  end

  for name in string.gmatch('\n' .. section, '\n  ([%l][%l%d%-]*)%s') do
    if name == 'help' then continue end
    if not expected[name] then error(`CLI reference: unmapped command {parent or 'jess'} {name}`, 0) end
    expected[name] = nil
  end

  for name in expected do error(`CLI reference: obsolete command mapping {parent or 'jess'} {name}`, 0) end
end

verifyCommands(nil)
verifyCommands 'package'
verifyCommands 'workspace'

for _, command in Commands do
  local output = help(command.args)
  local path = `site/content/docs/cli/{command.page}.md`
  local documentation, readProblem = fs.readFileString(path)
  if not documentation then error(`CLI reference: cannot read {path}: {readProblem}`, 0) end

  for option in string.gmatch(output, '%-%-[%l][%l%d%-]*') do
    if option == '--help' or option == '--version' or option == '--format' then continue end

    if not string.find(documentation, option, 1, true) then
      error(`CLI reference: {table.concat(command.args, ' ')} {option} is missing from {path}`, 0)
    end
  end
end

local forwarded, forwardProblem = process.run('jess', {
  'run', 'tests/fixtures/docs/arguments.jsl', 'hello', '--format', 'json',
}, { stdout = 'capture', stderr = 'capture' })

if not forwarded or not forwarded.success then error(`CLI reference: argument test failed: {forwardProblem}`, 0) end

assert(forwarded.stdout == 'hello\t--format\tjson\n', 'trailing options did not reach the script')

local denied, denyProblem = process.run('jess', {
  'run', 'tests/fixtures/docs/http-denied.jsl',
}, { stdout = 'capture', stderr = 'capture' })

if not denied or not denied.success then error(`CLI reference: HTTP denial test failed: {denyProblem}`, 0) end

assert(denied.stdout == 'denied\n', 'HTTP capability denial did not raise')

print 'CLI help commands and options are documented'
