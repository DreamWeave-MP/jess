--!strict
-- TOML 1.1.0: the decoder in ./tomldecode, and an encoder over @jess/data/value. jess's one TOML
-- codec; package manifests, lockfiles and workspaces are read with the same decoder.
local Decode = require './tomldecode'
local Values = require './value'

export type Value = Decode.Value
export type Table = Decode.Table
export type Layout = Decode.Layout
export type Kind = Decode.Kind

--- A value built with `@jess/data/value` as a TOML document, as the toml crate's pretty writer
--- lays it out. The value is a map; an absent field is left out, and raises inside a list, where
--- TOML has nothing to write for it.
local function encode(value: Values.Value): string return Values.encode(value, 'toml') end

return table.freeze {
  version = Decode.version,
  decode = Decode.decode,
  encode = encode,
}
