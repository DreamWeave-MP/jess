--!strict
-- A dot product of a Vec3f and a Vec4f: it fails at line 22, where it's written.
local shader = require '@jess/shader'

return shader.program {
  attributes = {
    normal = shader.vec3,
    position = shader.vec3,
  },

  material = {
    tint = shader.vec4,
  },

  vertex = function(input)
    local vertex = input.attributes

    return { position = shader.vec4(vertex.position, 1.0), normal = vertex.normal }
  end,

  fragment = function(input)
    local facing = shader.dot(shader.normalize(input.normal), input.material.tint)

    return shader.vec4(facing)
  end,
}
