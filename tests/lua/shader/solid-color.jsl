--!strict
-- A vertex position through the camera and one flat color from the material.
local shader = require '@jess/shader'

return shader.program {
  attributes = {
    position = shader.vec3,
  },

  pass = {
    projection = shader.mat4,
    view = shader.mat4,
  },

  material = {
    tint = shader.vec4,
  },

  draw = {
    model = shader.mat4,
  },

  vertex = function(input)
    local localPosition = shader.vec4(input.attributes.position, 1.0)

    return {
      position = input.pass.projection * input.pass.view * input.draw.model * localPosition,
    }
  end,

  fragment = function(input) return input.material.tint end,
}
