--!strict
-- @jess/input: binding documents, how people see them, and what action edges mean, over the
-- native half (`jess.input`).
--
-- Rust owns device truth, the control vocabulary, compiling and evaluating the action graph, and
-- the runtime a host ticks. Everything that decides what input means to a person is here: the
-- builders that write a binding document, the labels a glyph family gives controls, the shape of
-- a binding a GUI draws, the conflicts a remapping screen warns about, and the routes that turn
-- action edges into intents. All of it reads the document or the events, never a device.

local Json = require '@jess/json'

local Native = jess.input

export type ValueType = InputValueType
export type Family = InputFamily
export type EventKind = 'pressed' | 'released' | 'changed'

--- Where something was declared, for diagnostics.
export type Origin = { file: string, line: number, column: number }

--- One node of a binding, tagged by `type`, with its inputs nested. Durations are milliseconds
--- (`withinMs`, `durationMs`), which is how the document stores them; the builders take seconds.
export type Node =
  { type: 'sourceButton', control: string, device: number? }
  | { type: 'sourceAxis', control: string, device: number? }
  | { type: 'constant', value: number }
  | { type: 'invert', input: Node }
  | { type: 'scale', input: Node, factor: number }
  | { type: 'deadzone', input: Node, inner: number, outer: number }
  | { type: 'threshold', input: Node, level: number }
  | { type: 'chord', members: { Node } }
  | { type: 'any', members: { Node } }
  | { type: 'gate', input: Node, condition: Node }
  | { type: 'tap', input: Node, withinMs: number }
  | { type: 'hold', input: Node, durationMs: number }
  | { type: 'axisFromButtons', negative: Node, positive: Node }
  | { type: 'vector2', horizontal: Node, vertical: Node }
  | { type: 'actionActive', action: string }
  | { type: 'actionValue', action: string }

--- An action's declaration.
export type Action = { name: string, valueType: ValueType, origin: Origin? }

--- One binding: the action, by name, and the node tree that produces its value.
export type Binding = { action: string, input: Node }

--- An action set: the bindings of one mode. Any number of sets can be active at once.
export type Set = { name: string, owner: string, bindings: { Binding }, origin: Origin? }

--- An action layer over the active sets: its bindings replace lower ones for the actions it
--- names, and `masks` silences actions. The layer pushed last decides first.
export type Layer = {
  name: string,
  owner: string,
  bindings: { Binding },
  masks: { string }?,
  origin: Origin?,
}

--- A binding document. `graph` fills in `version`, `sets`, and `layers` when they are left out.
export type Document = {
  version: number?,
  actions: { Action },
  sets: { Set }?,
  layers: { Layer }?,
}

--- Where a binding is in a document: its set or layer, and its position in that one's
--- `bindings`, from 1.
export type Location = { set: string?, layer: string?, index: number }

--- A binding's shape, for a GUI to draw. Modifiers (`invert`, `scale`, `deadzone`, `threshold`)
--- draw as their input; thresholds of `tap` and `hold` are seconds.
export type Presentation =
  { kind: 'control', control: string, family: Family, label: string }
  | { kind: 'chord', parts: { Presentation } }
  | { kind: 'anyOf', parts: { Presentation } }
  | { kind: 'tap', input: Presentation, within: number }
  | { kind: 'hold', input: Presentation, duration: number }
  | { kind: 'axis', negative: Presentation, positive: Presentation }
  | { kind: 'vector2', horizontal: Presentation, vertical: Presentation }
  | { kind: 'while', input: Presentation, condition: Presentation }
  | { kind: 'action', action: string }
  | { kind: 'constant' }

--- One binding of an action as presentation data.
export type BindingPresentation = {
  action: string,
  location: Location,
  family: Family,
  shape: Presentation,
}

export type ConflictKind = 'press' | 'tap' | 'hold' | 'axis'

--- Two bindings in one set or layer that fire different actions from the same input.
export type Conflict = {
  owner: { set: string?, layer: string? },
  kind: ConflictKind,
  controls: { string },
  actions: { string },
  bindings: { Location },
}

--- One route: this edge of this action is this intent.
export type Route = { action: string, kind: EventKind, intent: string }

--- An intent a routed action edge dispatched: the event, and the intent it means.
export type Intent = {
  intent: string,
  action: string,
  kind: EventKind,
  value: InputValue,
  time: number,
  device: number?,
}

-- Building ------------------------------------------------------------------------------------

--- The control classes whose controls are buttons; every other class is an axis.
local Digital: { [string]: true } = { key = true, pointerButton = true, gamepadButton = true, touch = true }

local function class(control: string): string
  return string.match(control, '^[^:]*') :: string
end

local function sourceButton(control: string): Node
  return { type = 'sourceButton', control = control }
end

local function sourceAxis(control: string): Node
  return { type = 'sourceAxis', control = control }
end

local function millis(name: string, seconds: number): number
  if seconds ~= seconds or seconds < 0 or seconds == math.huge then
    error(`input.{name} takes a duration in seconds, not {seconds}`, 3)
  end

  return math.round(seconds * 1000)
end

--- A key by its W3C position name (`KeyA`, `ControlLeft`, `Numpad7`).
local function key(name: string): Node return sourceButton(Native.control(`key:{name}`)) end

local function pointerButton(name: string): Node
  return sourceButton(Native.control(`pointerButton:{name}`))
end

--- A gamepad button by position (`South`, `LeftBumper`, `DPadUp`).
local function gamepadButton(name: string): Node
  return sourceButton(Native.control(`gamepadButton:{name}`))
end

--- Any button, as `class:Name`.
local function button(control: string): Node
  local canonical = Native.control(control)
  if not Digital[class(canonical)] then
    error(`input.button reads a button, and {canonical} is an axis; use input.axis`, 2)
  end

  return sourceButton(canonical)
end

--- Any axis, as `class:Name` (`gamepadAxis:LeftStickX`, `pointerAxis:DeltaY`).
local function axis(control: string): Node
  local canonical = Native.control(control)
  if Digital[class(canonical)] then
    error(`input.axis reads an axis, and {canonical} is a button; use input.button`, 2)
  end

  return sourceAxis(canonical)
end

local function gamepadAxis(name: string): Node
  return sourceAxis(Native.control(`gamepadAxis:{name}`))
end

local function pointerAxis(name: string): Node
  return sourceAxis(Native.control(`pointerAxis:{name}`))
end

local function constant(value: number): Node return { type = 'constant', value = value } end

local function invert(input: Node): Node return { type = 'invert', input = input } end

local function scale(input: Node, factor: number): Node
  return { type = 'scale', input = input, factor = factor }
end

--- Zero at or below `inner`, one at or above `outer`, rescaled between; radial on a vector.
local function deadzone(input: Node, inner: number, outer: number): Node
  return { type = 'deadzone', input = input, inner = inner, outer = outer }
end

--- A scalar as a button, on at or above `level`.
local function threshold(input: Node, level: number): Node
  return { type = 'threshold', input = input, level = level }
end

--- Every member held; on when the last lands, off when any lifts.
local function chord(members: { Node }): Node return { type = 'chord', members = members } end

local function any(members: { Node }): Node return { type = 'any', members = members } end

--- `input` while `condition` is on, the type's zero otherwise.
local function gate(input: Node, condition: Node): Node
  return { type = 'gate', input = input, condition = condition }
end

--- On for one tick when `input` is released within `within` seconds of its press.
local function tap(input: Node, within: number): Node
  return { type = 'tap', input = input, withinMs = millis('tap', within) }
end

--- On once `input` has been held for `duration` seconds, until it is released.
local function hold(input: Node, duration: number): Node
  return { type = 'hold', input = input, durationMs = millis('hold', duration) }
end

--- `-1`, `0`, or `1` from two buttons.
local function axisFromButtons(negative: Node, positive: Node): Node
  return { type = 'axisFromButtons', negative = negative, positive = positive }
end

--- A vector from two scalars: `horizontal` is its x, `vertical` its y.
local function vector2(horizontal: Node, vertical: Node): Node
  return { type = 'vector2', horizontal = horizontal, vertical = vertical }
end

--- Whether another action is active this tick.
local function actionActive(action: string): Node
  return { type = 'actionActive', action = action }
end

--- Another action's value this tick.
local function actionValue(action: string): Node return { type = 'actionValue', action = action } end

-- Compiling -----------------------------------------------------------------------------------

--- Compiles and validates a document; every problem is reported at once, by place. The
--- document isn't changed.
local function graph(document: Document): InputGraph
  local complete = table.clone(document)
  complete.version = complete.version or Native.formatVersion
  complete.sets = complete.sets or {}
  complete.layers = complete.layers or {}
  return Native.graph(Json.encodeTable(complete))
end

--- Compiles a saved document, as `toJson` wrote it.
local function fromJson(text: string): InputGraph return Native.graph(text) end

--- A compiled graph's document, with everything `graph` fills in filled in.
local function document(compiled: InputGraph): Document
  return Json.decode(compiled:toJson()) :: Document
end

-- Presenting ----------------------------------------------------------------------------------

--- What each family calls the gamepad buttons it names its own way; the rest keep their
--- positional names. Nintendo's face buttons are swapped against Xbox's: A is east.
local GamepadLabels: { [Family]: { [string]: string } } = {
  xbox = {
    South = 'A',
    East = 'B',
    West = 'X',
    North = 'Y',
    LeftBumper = 'LB',
    RightBumper = 'RB',
    LeftTrigger = 'LT',
    RightTrigger = 'RT',
    Select = 'View',
    Start = 'Menu',
    Guide = 'Xbox',
    LeftStick = 'LS',
    RightStick = 'RS',
  },
  playstation = {
    South = 'Cross',
    East = 'Circle',
    West = 'Square',
    North = 'Triangle',
    LeftBumper = 'L1',
    RightBumper = 'R1',
    LeftTrigger = 'L2',
    RightTrigger = 'R2',
    Select = 'Create',
    Start = 'Options',
    Guide = 'PS',
    LeftStick = 'L3',
    RightStick = 'R3',
  },
  nintendo = {
    East = 'A',
    South = 'B',
    North = 'X',
    West = 'Y',
    LeftBumper = 'L',
    RightBumper = 'R',
    LeftTrigger = 'ZL',
    RightTrigger = 'ZR',
    Select = 'Minus',
    Start = 'Plus',
    Guide = 'Home',
    LeftStick = 'LS',
    RightStick = 'RS',
  },
}

--- The device kind each control class belongs to, and the families that draw each kind.
local ClassKinds: { [string]: string } = {
  key = 'keyboard',
  pointerButton = 'pointer',
  pointerAxis = 'pointer',
  gamepadButton = 'gamepad',
  gamepadAxis = 'gamepad',
  touch = 'touch',
  touchAxis = 'touch',
}

local FamilyKinds: { [Family]: { [string]: true } } = {
  keyboardMouse = { keyboard = true, pointer = true },
  xbox = { gamepad = true },
  playstation = { gamepad = true },
  nintendo = { gamepad = true },
  genericGamepad = { gamepad = true },
  touch = { touch = true },
}

local function checkFamily(family: Family)
  if FamilyKinds[family] then return end

  error(
    `a presentation family is keyboardMouse, xbox, playstation, nintendo, genericGamepad, or touch, not {family}`,
    3
  )
end

--- The glyph identifier `family` gives `control` (`class:Name`): `A` for an Xbox pad's south
--- button, `Cross` for a PlayStation's, a key's position name, `Contact0` for a touch. A theme
--- maps it to whatever it draws.
local function label(family: Family, control: string): string
  checkFamily(family)
  local canonical = Native.control(control)
  local controlClass, name = string.match(canonical, '^([^:]*):(.*)$')
  assert(controlClass and name, 'a canonical control is class:name')

  if controlClass == 'gamepadButton' then
    local labels = GamepadLabels[family]
    return labels and labels[name] or name
  end

  if controlClass == 'touch' then return `Contact{name}` end

  if controlClass == 'touchAxis' then
    local contact, touchAxis = string.match(name, '^(%d+):(.*)$')
    return `Contact{contact}{touchAxis}`
  end

  return name
end

type Presented = { shape: Presentation, covered: boolean }

local function present(node: Node, family: Family): Presented
  local covered = true

  local function visit(part: Node): Presentation
    if part.type == 'sourceButton' or part.type == 'sourceAxis' then
      covered = covered and FamilyKinds[family][ClassKinds[class(part.control)]] == true
      return { kind = 'control', control = part.control, family = family, label = label(family, part.control) }
    end

    if part.type == 'constant' then return { kind = 'constant' } end

    if part.type == 'invert' or part.type == 'scale' then return visit(part.input) end
    if part.type == 'deadzone' or part.type == 'threshold' then return visit(part.input) end

    if part.type == 'chord' or part.type == 'any' then
      local parts: { Presentation } = {}
      for index, member in part.members do
        parts[index] = visit(member)
      end

      return if part.type == 'chord' then { kind = 'chord', parts = parts } else { kind = 'anyOf', parts = parts }
    end

    if part.type == 'gate' then
      return { kind = 'while', input = visit(part.input), condition = visit(part.condition) }
    end

    if part.type == 'tap' then return { kind = 'tap', input = visit(part.input), within = part.withinMs / 1000 } end

    if part.type == 'hold' then
      return { kind = 'hold', input = visit(part.input), duration = part.durationMs / 1000 }
    end

    if part.type == 'axisFromButtons' then
      return { kind = 'axis', negative = visit(part.negative), positive = visit(part.positive) }
    end

    if part.type == 'vector2' then
      return { kind = 'vector2', horizontal = visit(part.horizontal), vertical = visit(part.vertical) }
    end

    return { kind = 'action', action = part.action }
  end

  local shape = visit(node)
  return { shape = shape, covered = covered }
end

type Owned = { bindings: { Binding }, name: string, isSet: boolean }

--- Every set's and layer's bindings, sets first, in document order.
local function owners(document: Document): { Owned }
  local found = {}
  for _, set in document.sets or {} do
    table.insert(found, { bindings = set.bindings, name = set.name, isSet = true })
  end

  for _, layer in document.layers or {} do
    table.insert(found, { bindings = layer.bindings, name = layer.name, isSet = false })
  end

  return found
end

local function locate(owner: Owned, index: number): Location
  if owner.isSet then return { set = owner.name, index = index } end

  return { layer = owner.name, index = index }
end

--- Where `action`'s bindings are, sets first.
local function bindings(document: Document, action: string): { Location }
  local found = {}
  for _, owner in owners(document) do
    for index, binding in owner.bindings do
      if binding.action == action then table.insert(found, locate(owner, index)) end
    end
  end

  return found
end

--- `action`'s bindings a person using `family` can press, as presentation data: a binding that
--- needs a device the family doesn't draw is left out.
local function presentations(document: Document, action: string, family: Family): { BindingPresentation }
  checkFamily(family)
  local found = {}
  for _, owner in owners(document) do
    for index, binding in owner.bindings do
      if binding.action ~= action then continue end

      local presented = present(binding.input, family)
      if not presented.covered then continue end

      table.insert(found, { action = action, location = locate(owner, index), family = family, shape = presented.shape })
    end
  end

  return found
end

type Signature = { kind: ConflictKind, controls: { string }, key: string }

--- The controls a binding presses when it is buttons only (one, or a chord of them) on no
--- particular device, sorted; nil for anything else.
local function pressed(node: Node): { string }?
  if node.type == 'sourceButton' then return if node.device then nil else { node.control } end

  if node.type ~= 'chord' then return nil end

  local controls = {}
  for _, member in node.members do
    if member.type ~= 'sourceButton' or member.device then return nil end

    table.insert(controls, member.control)
  end

  table.sort(controls)
  return controls
end

local function signature(node: Node): Signature?
  local kind: ConflictKind, controls: { string }? = 'press', nil
  if node.type == 'tap' then
    kind, controls = 'tap', pressed(node.input)
  elseif node.type == 'hold' then
    kind, controls = 'hold', pressed(node.input)
  elseif node.type == 'sourceAxis' then
    kind, controls = 'axis', if node.device then nil else { node.control }
  else
    controls = pressed(node)
  end

  if not controls then return nil end

  return { kind = kind, controls = controls, key = `{kind} {table.concat(controls, ' ')}` }
end

--- The plain conflicts: two bindings in one set or layer firing different actions from the same
--- buttons pressed the same way, or the same axis. Bindings with modifiers, gates, or a device
--- of their own are never plain.
local function conflicts(document: Document): { Conflict }
  local found = {}
  for _, owner in owners(document) do
    local signatures: { Signature | false } = {}
    for index, binding in owner.bindings do
      signatures[index] = signature(binding.input) or false
    end

    for first, firstSignature in signatures do
      if not firstSignature then continue end

      for second = first + 1, #signatures do
        local secondSignature = signatures[second]
        if not secondSignature or secondSignature.key ~= firstSignature.key then continue end

        local firstAction, secondAction = owner.bindings[first].action, owner.bindings[second].action
        if firstAction == secondAction then continue end

        table.insert(found, {
          owner = if owner.isSet then { set = owner.name } else { layer = owner.name },
          kind = firstSignature.kind,
          controls = table.clone(firstSignature.controls),
          actions = { firstAction, secondAction },
          bindings = { locate(owner, first), locate(owner, second) },
        })
      end
    end
  end

  return found
end

-- Routing -------------------------------------------------------------------------------------

local EventKinds: { [string]: true } = { pressed = true, released = true, changed = true }

type RouterState = { added: { Route } }

local RouterMethods = {}
RouterMethods.__index = RouterMethods
RouterMethods.__metatable = false

--- Routes `kind` edges of `action` to `intent`. Routes are by name, so they outlive every graph:
--- a route to an action no graph declares waits for one that does.
function RouterMethods.route(router: RouterState, action: string, kind: EventKind, intent: string)
  if not EventKinds[kind] then
    error(`an action event kind is pressed, released, or changed, not {kind}`, 2)
  end

  table.insert(router.added, { action = action, kind = kind, intent = intent })
end

--- The routes, in the order they were added.
function RouterMethods.routes(router: RouterState): { Route }
  return table.clone(router.added)
end

function RouterMethods.clear(router: RouterState)
  table.clear(router.added)
end

--- The intents `events` (a tick's action events, in order) dispatch: each event's routes, in the
--- order they were added. An event no route matches dispatches nothing.
function RouterMethods.dispatch(router: RouterState, events: { InputActionEvent }): { Intent }
  local found = {}
  for _, event in events do
    for _, route in router.added do
      if route.action ~= event.action or route.kind ~= event.kind then continue end

      table.insert(found, {
        intent = route.intent,
        action = event.action,
        kind = event.kind,
        value = event.value,
        time = event.time,
        device = event.device,
      })
    end
  end

  return found
end

local RouterMetatable = table.freeze(RouterMethods)

--- A table of routes from action edges to intents. It has no targets, no focus, and no command
--- table: what an intent does is the application's.
export type Router = typeof(setmetatable({} :: RouterState, RouterMetatable))

local function router(): Router return setmetatable({ added = {} }, RouterMetatable) end

return table.freeze {
  formatVersion = Native.formatVersion,
  key = key,
  pointerButton = pointerButton,
  gamepadButton = gamepadButton,
  button = button,
  axis = axis,
  gamepadAxis = gamepadAxis,
  pointerAxis = pointerAxis,
  constant = constant,
  invert = invert,
  scale = scale,
  deadzone = deadzone,
  threshold = threshold,
  chord = chord,
  any = any,
  gate = gate,
  tap = tap,
  hold = hold,
  axisFromButtons = axisFromButtons,
  vector2 = vector2,
  actionActive = actionActive,
  actionValue = actionValue,
  graph = graph,
  fromJson = fromJson,
  document = document,
  label = label,
  bindings = bindings,
  presentations = presentations,
  conflicts = conflicts,
  router = router,
  runtime = Native.runtime,
}

--[========[
@api-document input @jess/input



`@jess/input` is input for scripts, the built-in package's Luau over `jess.input`, the native half ([Input Runtime](@/docs/contributing/input-runtime.md) has the model). A script writes a binding document as tables, the native side compiles, validates, and evaluates it, and everything that decides what input means to a person (labels, the shape of a binding a GUI draws, conflict checks, intents) is Luau over the document and the action events. Under a host ([Application Kernel](@/docs/contributing/application-kernel.md)) that runtime is the application's live input: real devices feed it, the host ticks it in the input phase, and the script configures it and reads it after the tick. Anywhere else it is headless: synthetic devices and a clock the script moves, which is what a test, a replay, or a package's own binding check needs. No device event ever calls into Luau.

{% usage_note(title="Three capabilities") %}
Under a script domain every runtime method checks a capability: `input.actions` for `action`, `stats`, `now`, and `tick`; `input.observe` for `devices`; `input.configure` for everything that changes the runtime (`install`, `uninstall`, `restoreDefaults`, `setActive`, `pushLayer`, `popLayer`, `connect`, `disconnect`, `press`, `release`, `axis`, `focus`, `advance`). A context without the grant gets `capability 'input.actions' denied to domain#1 gen#1 context#2`. Everything else is data and checks nothing: the builders, compiling, labels, presentation, conflicts, and the router. Outside any domain the runtime's own grant decides: `jess run`, `jess test`, and a package's tests hold all three, a package target holds the ones it declares, and a runtime made without one refuses with `jess.input: needs the 'input.configure' capability, which this runtime does not grant`.
{% end %}

Four things to know before the signatures:

- **Nothing here means anything.** Action names (`move`, `editor.save`) are yours; the module reserves none.
- **Durations are seconds** in every function and milliseconds in the document (`withinMs`, `durationMs`), which is what the native crate stores.
- **Bindings are addressed by position from 1** in their set's or layer's `bindings`, the way the document's own array counts.
- **Values are shaped by the action's `valueType`:** `digital` is a boolean, `scalar` a number, `vector2` a `vector` with `z` 0.

## Nodes

{{ api_symbol(value="@jess/input.key") }}

A key by its positional name: the W3C `KeyboardEvent.code` list (`KeyW`, `ControlLeft`, `Space`, `Numpad7`). `KeyW` is the same key on an AZERTY board; what's printed on it is the layout's business.

{{ api_symbol(value="@jess/input.gamepadButton") }}

A gamepad button by position: `South`, `East`, `West`, `North`, `LeftBumper`, `RightBumper`, `LeftTrigger`, `RightTrigger`, `Select`, `Start`, `Guide`, `LeftStick`, `RightStick`, `DPadUp`, `DPadDown`, `DPadLeft`, `DPadRight`. `South` is `A` on an Xbox pad and `Cross` on a PlayStation one; [`label`](#labels) supplies the letter.

{{ api_symbol(value="@jess/input.pointerButton") }}

`Primary`, `Secondary`, `Middle`, `Back`, or `Forward`.

{{ api_symbol(value="@jess/input.button") }}
{{ api_symbol(value="@jess/input.axis") }}

Any control by its full name, `class:Name`: `key:KeyA`, `gamepadButton:South`, `gamepadAxis:LeftStickX`, `pointerAxis:DeltaY`, `touch:0`. `button` refuses an axis and `axis` a button, each naming the other. Every builder that names a control checks it against the native vocabulary (`no key of that name`) when it is called.

{{ api_symbol(value="@jess/input.gamepadAxis") }}
{{ api_symbol(value="@jess/input.pointerAxis") }}

Axes by bare name. Sticks (`LeftStickX`, `LeftStickY`, `RightStickX`, `RightStickY`) read `-1..1` with `Y` up; triggers (`LeftTrigger`, `RightTrigger`) read `0..1`. Pointer axes are `X`, `Y` (position, pixels), `DeltaX`, `DeltaY` (motion this tick), `WheelX`, `WheelY` (steps this tick).

{{ api_symbol(value="@jess/input.constant") }}
{{ api_symbol(value="@jess/input.invert") }}
{{ api_symbol(value="@jess/input.scale") }}
{{ api_symbol(value="@jess/input.deadzone") }}
{{ api_symbol(value="@jess/input.threshold") }}

Transforms. `invert` is not for a digital input and negation otherwise; `scale` and `deadzone` take a scalar or a vector, and a deadzone on a vector is radial, so a stick's dead spot stays round: magnitudes at or below `inner` are zero, at or above `outer` are one, and the band between is rescaled. `threshold` makes a button of a scalar, on at magnitude `level` or more (`0 <= inner < outer <= 1`, `level > 0`).

{{ api_symbol(value="@jess/input.chord") }}
{{ api_symbol(value="@jess/input.any") }}

`chord` is every member held: on when the last member goes down, off when any comes up, whatever the order. Members aren't consumed, so a plain binding to `S` still fires under `Ctrl+S`. `any` is any member held; it's how one action takes a keyboard key or a pad button.

{{ api_symbol(value="@jess/input.gate") }}

`input` while the digital `condition` is on, and the input type's zero while it's off. With `actionActive` it's how one action depends on another.

{{ api_symbol(value="@jess/input.tap") }}
{{ api_symbol(value="@jess/input.hold") }}

A tap is on for exactly one tick when `input` is released within `within` seconds of its press. A hold turns on once `input` has been held for `duration` seconds and stays on until release. Both measure from the device's own event timestamps, and a release after the tap window is not a tap, so `tap(a, 0.2)` and `hold(a, 0.35)` on the same button tell themselves apart.

{{ api_symbol(value="@jess/input.axisFromButtons") }}
{{ api_symbol(value="@jess/input.vector2") }}

Two buttons as a `-1`, `0`, `1` axis (both held is `0`), and two scalars as a vector: `horizontal` is its `x`, `vertical` its `y`.

{{ api_symbol(value="@jess/input.actionActive") }}
{{ api_symbol(value="@jess/input.actionValue") }}

Another action, by name: whether it's active this tick, or its value with its type. Actions are evaluated after the actions they read; a cycle is a compile error that names it.

## Compiling

{{ api_symbol(value="@jess/input.graph") }}

Compiles a document and validates all of it at once. A document is `actions` (each `{ name, valueType }`), `sets` (each `{ name, owner, bindings }`), and optional `layers` (each `{ name, owner, bindings, masks }`); a binding is `{ action, input }`. `owner` is the package declaring the set, for diagnostics. `version`, `sets`, and `layers` are filled in when left out, in a copy: the table you pass isn't changed.

- **Errors:** every problem in the document, one per line, each placed: `set "gameplay" (from @jess/example), action "quickSave", binding 1, at chord: chord's members[1] must be digital, and it is scalar`. Unknown actions, duplicate names, inputs of the wrong type, a binding that doesn't produce its action's type, zero thresholds, bad deadzone edges, and cycles are all refused. A document with any error compiles to nothing.

```luau
--!strict
local input = require '@jess/input'

local document: input.Document = {
  actions = {
    { name = 'move', valueType = 'vector2' },
    { name = 'quickSave', valueType = 'digital' },
    { name = 'interact', valueType = 'digital' },
    { name = 'contextMenu', valueType = 'digital' },
    { name = 'sprint', valueType = 'digital' },
  },

  sets = {
    {
      name = 'gameplay',
      owner = '@my/package',
      bindings = {
        {
          action = 'move',
          input = input.vector2(
            input.axisFromButtons(input.key 'KeyA', input.key 'KeyD'),
            input.axisFromButtons(input.key 'KeyS', input.key 'KeyW')
          ),
        },
        { action = 'quickSave', input = input.chord { input.key 'ControlLeft', input.key 'KeyS' } },
        { action = 'interact', input = input.tap(input.gamepadButton 'South', 0.2) },
        { action = 'contextMenu', input = input.hold(input.gamepadButton 'South', 0.35) },
        { action = 'sprint', input = input.gate(input.key 'ShiftLeft', input.actionActive 'move') },
      },
    },
  },

  layers = {
    {
      name = 'inventory',
      owner = '@my/package',
      bindings = { { action = 'interact', input = input.key 'KeyE' } },
      masks = { 'sprint' },
    },
  },
}

local graph = input.graph(document)
print(#graph:actions()) -- 5
```

{{ api_symbol(value="@jess/input.fromJson") }}

Reads a saved document and compiles it.

- **Errors:** a document of another format version, an unknown node type or field (``unknown variant `doubleTap` ``), a value of the wrong type, each with the line and column; then everything `graph` refuses. Nothing unrecognized is skipped.

{{ api_symbol(value="@jess/input.document") }}

A compiled graph's document, with everything `graph` fills in filled in: the table to hand to `bindings`, `presentations`, and `conflicts`, or to edit and compile again.

### InputGraph

{{ api_symbol(value="InputGraph.toJson") }}
{{ api_symbol(value="InputGraph.actions") }}

The document as JSON (the same document is always the same text, so it diffs and saves), and the actions in declaration order. A compiled graph is what `runtime:install` takes.

## Labels

{{ api_symbol(value="@jess/input.label") }}

The glyph identifier a presentation family (`keyboardMouse`, `xbox`, `playstation`, `nintendo`, `genericGamepad`, `touch`) gives a control: `A` for `gamepadButton:South` on an Xbox pad, `Cross` on a PlayStation one, `B` on a Nintendo one (whose face buttons are swapped against Xbox's), and the positional name (`South`) on a generic pad. Keys, pointer controls, and axes keep their names, and a touch contact is `Contact0`. A theme maps the identifier to whatever it draws; a device reports its family in `runtime:devices()`.

```luau
--!strict
print(input.label('xbox', 'gamepadButton:South')) -- A
print(input.label('nintendo', 'gamepadButton:South')) -- B
print(input.label('keyboardMouse', 'key:KeyW')) -- KeyW
```

## Presentation and conflicts

{{ api_symbol(value="@jess/input.bindings") }}

Where an action's bindings are: `{ set = 'gameplay', index = 3 }` or `{ layer = 'inventory', index = 1 }`, sets first. `index` counts from 1 in that owner's `bindings`.

{{ api_symbol(value="@jess/input.presentations") }}

The action's bindings a person using `family` can press, as data for a GUI to draw. Each has the `location`, and a `shape`: `{ kind = 'control', control = 'gamepadButton:South', family = 'xbox', label = 'A' }`, or `chord`/`anyOf` with `parts`, `tap`/`hold` with `input` and the threshold in seconds (`within`, `duration`), `axis` with `negative` and `positive`, `vector2` with `horizontal` and `vertical`, `while` with `input` and `condition`, `action` with `action`, or `constant`. Transforms that don't change what to press are left out.

```luau
--!strict
local shape = input.presentations(document, 'contextMenu', 'playstation')[1].shape
if shape.kind == 'hold' and shape.input.kind == 'control' then
  print(shape.kind, shape.duration, shape.input.label) -- hold  0.35  Cross
end
print(#input.presentations(document, 'contextMenu', 'keyboardMouse')) -- 0
```

{{ api_symbol(value="@jess/input.conflicts") }}

Two bindings in one set or layer that fire different actions from the same press, chord, tap, hold, or axis: `{ owner = { set = 's' }, kind = 'press', controls = { 'key:ControlLeft', 'key:KeyS' }, actions = { 'a', 'b' }, bindings = { ... } }`, the controls sorted. `S` beside `Ctrl+S`, a tap beside a hold, a binding to one particular device, and the same button in two sets are not reported: whether those collide depends on what an application activates together, and the document has the structure to judge it.

## Intents

{{ api_symbol(value="@jess/input.router") }}

An action is interpreted input (`ui.accept` became active); an intent is what that means to a target (activate whatever has focus). A router is a table of routes from action edges to intents and nothing more: no targets, no focus, no command table.

{{ api_symbol(value="@jess/input.Router.route") }}
{{ api_symbol(value="@jess/input.Router.dispatch") }}
{{ api_symbol(value="@jess/input.Router.routes") }}
{{ api_symbol(value="@jess/input.Router.clear") }}

`dispatch` takes a tick's events, from `runtime:tick()` or an input phase's payload, and returns the intents they mean, each event's routes in the order they were added: `{ intent, action, kind, value, time, device }`. Routes are by name, so they outlive every graph, and a route to an action no graph declares waits for one that does.

```luau
--!strict
local router = input.router()
router:route('quickSave', 'pressed', 'game.save')

local saver = input.runtime()
saver:install(graph)
saver:setActive 'gameplay'
local board = saver:connect 'keyboard'
saver:press(board, 'key:ControlLeft')
saver:press(board, 'key:KeyS')
for _, intent in router:dispatch(saver:tick()) do
  print(intent.intent, intent.action) -- game.save  quickSave
end
```

## The runtime

{{ api_symbol(value="@jess/input.runtime") }}

Under a host, the domain's live runtime: every call returns a handle over the same one, the host ticks it once per frame, and the input context's handler receives that tick's events as its payload (`{ time, generation, events }`, rows shaped as below; a router makes intents of them). `tick` and `advance` are refused there (`InputRuntime:tick is the host's on a live input runtime: ...`); synthetic events (`connect`, `press`, ...) still work, under `input.configure`, and land in the next host tick.

Anywhere else, a headless runtime of the script's own: synthetic devices, a clock that moves only when the script says so, and one graph at a time. With `windows = true` it also takes the keyboard and pointer of each of the [windows](@/docs/api/gpu.md#windows) the script opens, polled at every `tick` and stamped with the runtime's clock, as a host's are; a live runtime has them from its host already, and refuses the option.

```luau
--!strict
local runtime = input.runtime()
runtime:install(graph)
runtime:setActive 'gameplay'
local keyboard, pad = runtime:connect 'keyboard', runtime:connect 'gamepad'
runtime:tick()

runtime:press(keyboard, 'key:ControlLeft')
runtime:advance(0.016)
runtime:tick()
print((runtime:action 'quickSave' :: InputActionState).active) -- false

runtime:press(keyboard, 'key:KeyS')
runtime:advance(0.016)
for _, event in runtime:tick() do
  print(event.action, event.kind) -- move  pressed / move  changed / quickSave  pressed
end

runtime:press(pad, 'gamepadButton:South')
runtime:advance(0.4)
runtime:tick()
print((runtime:action 'contextMenu' :: InputActionState).pressed) -- true
```

`S` is also `move`'s back key, so the chord's tick moves too: chord members aren't consumed.

### InputRuntime

{{ api_symbol(value="InputRuntime.install") }}
{{ api_symbol(value="InputRuntime.uninstall") }}
{{ api_symbol(value="InputRuntime.restoreDefaults") }}

`install` takes a compiled graph (from `graph` or `fromJson`), replaces the installed one, and returns the new generation; sets that were active and layers that were pushed stay so where the new graph has them by name, every action starts from rest, and a button held across the swap is ignored until released. `restoreDefaults` puts the installed document back.

{{ api_symbol(value="InputRuntime.setActive") }}
{{ api_symbol(value="InputRuntime.pushLayer") }}
{{ api_symbol(value="InputRuntime.popLayer") }}

Activate (the default) or deactivate a set; push a layer on top of the stack, or remove it (`true` if it was pushed). All take effect at the next tick. The topmost pushed layer that names an action decides it; masked actions are silent.

- **Errors:** `the installed action graph has no set "menu"`; no graph installed.

{{ api_symbol(value="InputRuntime.connect") }}
{{ api_symbol(value="InputRuntime.disconnect") }}
{{ api_symbol(value="InputRuntime.devices") }}

Synthetic devices, by id. Disconnecting releases everything the device held. `devices` lists every connected device the runtime has seen, real ones included, as of the last tick, each with the `backend` that found it where it says: a window's keyboard and pointer say `window:<number>`, the window's [`number`](@/docs/api/gpu.md#gpuwindow).

- **Errors:** `no device 3 is known to this runtime`.

{{ api_symbol(value="InputRuntime.press") }}
{{ api_symbol(value="InputRuntime.release") }}
{{ api_symbol(value="InputRuntime.axis") }}
{{ api_symbol(value="InputRuntime.focus") }}
{{ api_symbol(value="InputRuntime.advance") }}
{{ api_symbol(value="InputRuntime.now") }}

Events, stamped with the runtime's clock, which `advance` moves. A relative axis (`pointerAxis:DeltaX`) moves by `value`; every other axis moves to it.

{{ api_symbol(value="InputRuntime.tick") }}

Applies every event pushed so far, evaluates the graph once, and returns this tick's edges: `{ action, kind = 'pressed' | 'released' | 'changed', value, time, device }`. A press and release that both land between two ticks are invisible, so tick as often as the shortest input you care about. On a live runtime the host ticks; this raises.

{{ api_symbol(value="InputRuntime.action") }}

`{ value, active, pressed, released, changed, since, device }` after the last tick, or `nil` for a name the graph doesn't declare. `pressed` and `released` are this tick's edges; `device` is the id behind the value.

{{ api_symbol(value="InputRuntime.stats") }}

What the last tick cost: `deviceEvents`, `ticks`, `nodesEvaluated`, `bindingsEvaluated`, `actionsChanged`, `actionEvents`, `activeSets`, `activeLayers`.

## Windows

A [window](@/docs/api/gpu.md#windows) is a keyboard and a pointer, as far as this module cares. Each window has one of each, its own: `window <number> keyboard` and `window <number> pointer` in `runtime:devices()`, with `backend = 'window:<number>'`, the window's [`number`](@/docs/api/gpu.md#gpuwindow). They connect at the window's first input and disconnect when it closes. Keys, pointer buttons, position (`pointerAxis:X` and `pointerAxis:Y`, physical pixels from the window's top left), motion, and the wheel are named as every backend names them, so a binding written for a keyboard is a binding for a window.

- **Who gets them.** Under the host of an application target that declares `gpu.window`, the live runtime has every window's devices from its host, and asking for `{ windows = true }` there is refused: `jess.input.runtime: the live input runtime takes its windows' input from its host already`. A target without `gpu.window` stays headless. A script with no host asks with `input.runtime { windows = true }`, and its runtime polls its windows at every `tick`, stamped with the runtime's clock.
- **Every window, or one.** A binding to a control on any device (`input.key 'Space'`) sees every window; a binding to one device sees one window. Two runtimes that both ask each get every window's input, and polling one takes nothing from the other.
- **The pointer.** A window's pointer is where the pointer is in that window, and at 0, 0 once it leaves, so a binding to any pointer's position follows the window the pointer is over. Raw mouse motion has no window, and goes to the pointer of the window that has the keyboard.
- **Focus.** The application is focused while any of its windows has the keyboard, and hears that it lost focus only when none has.
- **Text is not a control.** What a key types, with the layout and dead keys applied, and what an input method composes are among the window's own [`events()`](@/docs/api/gpu.md#gpuwindow) (`text`, `preedit`, `inputMethod`), and `window:textInput(true, area)` lets an input method compose for it. Bindings are for actions; a text field reads text.

```luau
--!strict
local window = jess.gpu.window(jess.gpu.device(), { title = 'keys', width = 320, height = 240 })
local runtime = input.runtime { windows = true }
runtime:install(input.graph {
  actions = { { name = 'jump', valueType = 'digital' } },
  sets = {
    {
      name = 'play',
      owner = '@example/keys',
      bindings = { { action = 'jump', input = input.key 'Space' } },
    },
  },
})
runtime:setActive 'play'

for _ = 1, 600 do
  jess.gpu.pump()
  for _, event in runtime:tick() do
    print(event.action, event.kind)
  end

  for _, event in window:events() do
    if event.kind == 'text' then print('typed', event.text) end
  end
end
```

That is 600 frames of a window at the display's pace: Space pressed in it is `jump`, and what a key types arrives as `text` beside it. The window draws nothing, since nothing [shows](@/docs/api/gpu.md#gpuwindow) a plan in it; input doesn't need one.

## jess.input



{{ api_symbol(value="jess.input.graph") }}
{{ api_symbol(value="jess.input.formatVersion") }}
{{ api_symbol(value="jess.input.control") }}
{{ api_symbol(value="jess.input.runtime") }}

The native half `@jess/input` is written over: `graph(json)` compiles a document already encoded as JSON, `control(text)` returns a control's canonical `class:Name` or raises, `formatVersion` is the document format this jess reads and writes, and `runtime` is `input.runtime`. The wrapper also exports that format as `input.formatVersion`. A script has no reason to call the native table directly; it is here so nothing about the boundary is hidden.

Related: [Input Runtime](@/docs/contributing/input-runtime.md), the model behind all of this.

]========]
