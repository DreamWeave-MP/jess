#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

site_package() {
  if [[ -n "${JESS_SITE_PACKAGE:-}" ]]; then
    printf '%s\n' "$JESS_SITE_PACKAGE"
    return
  fi
  if [[ -f "$ROOT/jpk/dreamweave-site/jess.toml" ]]; then
    printf '%s\n' "$ROOT/jpk/dreamweave-site"
    return
  fi
  if [[ -f "$ROOT/tools/site/dreamweave-site.jpk" ]]; then
    printf '%s\n' "$ROOT/tools/site/dreamweave-site.jpk"
    return
  fi
  echo "buildSite: no site-generator package found" >&2
  echo "buildSite: check it out at jpk/dreamweave-site or set JESS_SITE_PACKAGE" >&2
  exit 2
}

build_site() {
  local out="${1:-$ROOT/site/public}"
  local base_url="${2:-}"
  local package
  package="$(site_package)"

  if [[ -z "$out" || "$out" == "/" ]]; then
    echo "buildSite: refusing unsafe output path: '$out'" >&2
    exit 2
  fi

  rm -rf -- "$out"
  if [[ -n "$base_url" ]]; then
    jess run --capability filesystem.read --capability filesystem.write --package "$package" "$ROOT/tools/site/build.luau" "$ROOT/site" "$out" "$base_url"
  else
    jess run --capability filesystem.read --capability filesystem.write --package "$package" "$ROOT/tools/site/build.luau" "$ROOT/site" "$out"
  fi
}

case "${1:-build}" in
  serve)
    HOST="${2:-127.0.0.1}"
    PORT="${3:-1111}"
    if command -v python3 >/dev/null 2>&1; then
      exec python3 "$ROOT/tools/site/serve.py" "$ROOT" "$HOST" "$PORT"
    elif command -v python >/dev/null 2>&1; then
      exec python "$ROOT/tools/site/serve.py" "$ROOT" "$HOST" "$PORT"
    else
      echo "buildSite serve: Python 3 is required for the temporary browser-facing dev server." >&2
      echo "Jess builds the site itself; L3i currently has no raw TCP listener exposed to Luau." >&2
      exit 127
    fi
    ;;
  build)
    build_site "${2:-$ROOT/site/public}"
    ;;
  -h|--help|help)
    cat <<USAGE
Usage:
  ./buildSite [build] [OUTPUT]
  ./buildSite serve [HOST] [PORT]

Examples:
  ./buildSite
  ./buildSite /tmp/jess-site
  ./buildSite serve
  ./buildSite serve 0.0.0.0 8080
USAGE
    ;;
  *)
    # Preserve the original convenience form: ./buildSite /some/output
    build_site "$1"
    ;;
esac
