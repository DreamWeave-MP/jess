--!strict
-- @jess/log: structured logging for scripts and packages, over one native sink the host owns.

export type Fields = { [string]: string | number | boolean }
export type Record = {
  read level: string,
  read target: string,
  read message: string,
  read fields: Fields,
}

export type Logger = {
  read debug: (message: string, fields: Fields?) -> (),
  read info: (message: string, fields: Fields?) -> (),
  read warn: (message: string, fields: Fields?) -> (),
  read error: (message: string, fields: Fields?) -> (),
  read child: (fields: Fields) -> Logger,
}

return function(emit: (level: string, target: string, message: string, fields: Fields) -> ())
  -- Captures are per thread; `coroutine.running()` is nil on the main thread, keyed as `false`.
  local captures: { [thread | boolean]: { { Record } } } = {}

  local function merge(parent: Fields, fields: Fields?): Fields
    if not fields then return parent end

    local result = table.clone(parent)

    for key, value in fields do
      assert(type(key) == 'string', 'log field names must be strings')
      assert(
        type(value) == 'string' or type(value) == 'number' or type(value) == 'boolean',
        'log fields must be strings, numbers, or booleans'
      )

      if type(value) == 'number' then
        assert(value == value and math.abs(value) ~= math.huge, 'log fields must be finite')
      end

      result[key] = value
    end

    return table.freeze(result)
  end

  local function logger(target: string, context: Fields): Logger
    local function write(level: string, message: string, fields: Fields?)
      assert(type(message) == 'string', 'a log message must be a string')
      local merged = merge(context, fields)
      local active = captures[coroutine.running() or false]

      if active then
        local record: Record =
          table.freeze { level = level, target = target, message = message, fields = merged }

        for _, records in active do
          table.insert(records, record)
        end

        return
      end

      emit(level, target, message, merged)
    end

    return table.freeze {
      debug = function(message: string, fields: Fields?) write('debug', message, fields) end,
      info = function(message: string, fields: Fields?) write('info', message, fields) end,
      warn = function(message: string, fields: Fields?) write('warn', message, fields) end,
      error = function(message: string, fields: Fields?) write('error', message, fields) end,
      child = function(fields: Fields): Logger return logger(target, merge(context, fields)) end,
    }
  end

  local NoFields: Fields = table.freeze({} :: Fields)

  local function new(target: string, fields: Fields?): Logger
    assert(type(target) == 'string', 'a logger target must be a string')
    return logger(target, merge(NoFields, fields))
  end

  local default = new 'jess'

  local function capture(body: () -> ()): { Record }
    local records: { Record } = {}
    local thread = coroutine.running() or false
    local active = captures[thread] or {}
    captures[thread] = active
    table.insert(active, records)
    -- The body is the caller's code. If it fails, this capture still has to come off the stack,
    -- or every later record on this thread would vanish into it; the failure is raised again
    -- unchanged.
    local success, failure = pcall(body)
    table.remove(active)

    if #active == 0 then captures[thread] = nil end

    if not success then error(failure, 0) end

    return records
  end

  return table.freeze {
    new = new,
    debug = default.debug,
    info = default.info,
    warn = default.warn,
    error = default.error,
    capture = capture,
  }
end

--[========[
@api-document log @jess/log



A [built-in module](@/docs/scripting/built-in-modules.md): `require('@jess/log')` is the same frozen table in every script, typed as `Module__jess_log`. A record has a level, a target, a message, and fields (strings, finite numbers, booleans). Records leave the VM through one sink the host owns: `jess` writes them to stderr as one JSON object per line, `debug` ones excepted; `jess test` collects them per case; a Rust host picks its own with `jess::lua::stdlib::set_log_sink`, or, for code running in a [script domain](@/docs/contributing/script-domains.md#diagnostics-and-profiling), gives the domain a log stream (`DomainSpec::logs`) that collects every context's and worker's records with who logged them. Scripts can't reach the sink, only the module.

```luau
--!strict
local log = require '@jess/log'
local logger = log.new('site', { package = 'com.example.site' })
logger.info('rendered', { page = 'docs/index.md', bytes = 4096 })
logger.child({ step = 'sass' }).warn 'brand.sass has no tokens'
```

```text
{"level":"info","target":"site","message":"rendered","fields":{"bytes":4096.0,"package":"com.example.site","page":"docs/index.md"},"source":"build.jsl"}
{"level":"warn","target":"site","message":"brand.sass has no tokens","fields":{"package":"com.example.site","step":"sass"},"source":"build.jsl"}
```

`source` is the chunk that logged, as the VM sees it, not something the script said.

### log.new

{{ api_symbol(value="@jess/log.new") }}

A logger for `target`, carrying `fields` in every record it writes. The table is copied and frozen; changing it afterwards changes nothing.

- **Errors:** a non-string target raises `a logger target must be a string`. Field keys must be strings; field values must be strings, booleans, or finite numbers. Invalid fields raise when the logger is made, a child is made, or a record is written.

### JessLogger.debug, info, warn, error

{{ api_symbol(value="JessLogger.info") }}

Writes one record at that level. `fields` are merged over the logger's, the call's winning. A field that isn't a string, a finite number, or a boolean is an error, as is a message that isn't a string.

### JessLogger.child

{{ api_symbol(value="JessLogger.child") }}

A logger with the same target and more context.

### log.debug, info, warn, error

These module functions log with the target `jess`, for a script that doesn't want a logger of its own.

#### log.debug

{{ api_symbol(value="@jess/log.debug") }}

#### log.info

{{ api_symbol(value="@jess/log.info") }}

#### log.warn

{{ api_symbol(value="@jess/log.warn") }}

#### log.error

{{ api_symbol(value="@jess/log.error") }}

### log.capture

{{ api_symbol(value="@jess/log.capture") }}

Runs `body` and returns what was logged by the same Luau coroutine while it ran: the sink never sees those records. A different coroutine has its own capture stack, even when it runs on the same OS thread. Captures nest within a coroutine, and an outer capture holds what inner ones did. The returned array is mutable, but its records and their fields are frozen. An error in `body` is raised again unchanged, once the capture is closed. `@jess/test` runs every case inside one, which is how a case's `logs` get into its result.

```luau
--!strict
local log = require '@jess/log'
local records = log.capture(function() log.new('a').warn('careful', { count = 2 }) end)
print(#records, records[1].level, records[1].target, records[1].fields.count)
-- 1  warn  a  2
```


