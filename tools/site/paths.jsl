--!strict
-- Where the repository's site is: the nearest folder, from the one the command runs in up, that
-- holds `site/config.toml`. A package's target has no folder of its own to start from (a JPK has
-- none), so the repository is found from wherever inside it the command runs.
local fs = require '@dream/fs'

local function repositoryRoot(): string
  local start = assert(fs.cwd())
  local folder: string? = start

  while folder and folder ~= '' do
    if fs.isFile(fs.join(folder, 'site', 'config.toml')) then return folder end

    local above = fs.parent(folder)

    if above == folder then break end

    folder = above
  end

  return start
end

local Root = repositoryRoot()

return table.freeze {
  root = Root,
  site = fs.join(Root, 'site'),
  public = fs.join(Root, 'site', 'public'),
}
