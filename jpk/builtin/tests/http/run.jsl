--!strict
-- @jess/http's pure half: what it makes of a URL and of a Location header. The wire half runs
-- against a loopback server in jess's own test suite, where sockets can be granted.
local http = require '@jess/http'
local test = require '@jess/test'
local expect = test.expect
local suite = test.new()

suite.describe('@jess/http', function()
  suite.it('takes a URL apart and fills in the defaults', function()
    local url = http.parseUrl 'HTTPS://Example.ORG/a/b?c=1#frag'
    assert(url)
    expect(url.scheme).toBe 'https'
    expect(url.host).toBe 'example.org'
    expect(url.port).toBe(443)
    expect(url.target).toBe '/a/b?c=1'

    local bare = http.parseUrl 'http://127.0.0.1:8080'
    assert(bare)
    expect(bare.port).toBe(8080)
    expect(bare.target).toBe '/'

    local six = http.parseUrl 'http://[::1]:81/x'
    assert(six)
    expect(six.host).toBe '[::1]'
    expect(six.port).toBe(81)
  end)

  suite.it('refuses what it does not fetch', function()
    local _, _, kind = http.parseUrl 'ftp://example.org/file'
    expect(kind).toBe 'unsupportedScheme'

    local _, _, credentials = http.parseUrl 'https://user:secret@example.org/'
    expect(credentials).toBe 'credentialsInUrl'

    local _, _, relative = http.parseUrl '/just/a/path'
    expect(relative).toBe 'invalidUrl'

    local _, _, port = http.parseUrl 'http://example.org:99999/'
    expect(port).toBe 'invalidUrl'
  end)

  suite.it('resolves a Location header the way a browser does', function()
    local base = 'https://example.org/packages/feed.json?x=1'
    expect(http.resolveReference(base, 'https://mirror.example/f.json')).toBe 'https://mirror.example/f.json'
    expect(http.resolveReference(base, '//mirror.example/f.json')).toBe 'https://mirror.example/f.json'
    expect(http.resolveReference(base, '/other.json')).toBe 'https://example.org/other.json'
    expect(http.resolveReference(base, 'sibling.json')).toBe 'https://example.org/packages/sibling.json'
    expect(http.resolveReference(base, '../up/./file.jpk?y=2')).toBe 'https://example.org/up/file.jpk?y=2'
    expect(http.resolveReference(base, 'dir/')).toBe 'https://example.org/packages/dir/'
  end)

  suite.it('resolves a query, a fragment or nothing against the base path, as RFC 3986 does', function()
    local base = 'https://example.org/api/items?page=1#top'
    expect(http.resolveReference(base, '?page=2')).toBe 'https://example.org/api/items?page=2'
    expect(http.resolveReference(base, '#bottom')).toBe 'https://example.org/api/items?page=1#bottom'
    expect(http.resolveReference(base, '')).toBe 'https://example.org/api/items?page=1'
    expect(http.resolveReference('https://example.org', '?q=1')).toBe 'https://example.org?q=1'

    local url = http.parseUrl(http.resolveReference('https://example.org', '?q=1') :: string)
    assert(url)
    expect(url.target).toBe '/?q=1'
  end)

  suite.it('refuses a URL that would write its own lines into the request', function()
    for _, url in
      {
        'http://example.org/a\r\nX-Injected: yes',
        'http://example.org/a b',
        'http://example.org/a\tb',
        'http://example.org/\0',
        'http://exa\nmple.org/',
        'http://example.org:80\r\n/',
        'http://example.org/caf\195\169',
        'http://[::1\r\n]/',
        'http://exa%mple.org/',
        'http://example.org\\@other.org/',
      }
    do
      local parsed, message, kind = http.parseUrl(url)
      expect(parsed).toBeNil()
      expect(kind == 'invalidUrl' or kind == 'credentialsInUrl').toBe(true)
      expect((string.find(message :: string, '\n', 1, true))).toBeNil()
    end

    local _, secret = http.parseUrl 'not a url?token=SECRET'
    expect((string.find(secret :: string, 'SECRET', 1, true))).toBeNil()

    local named = http.parseUrl 'https://bücher.example/'
    assert(named)
    expect(named.host).toBe 'bücher.example'
  end)

  suite.it('never accepts a URL whose host or target could break the request line', function()
    -- A fixed linear congruential sequence, so a failure reproduces.
    local seed = 20261028
    local function nextByte(): number
      seed = (seed * 1103515245 + 12345) % 2147483648
      return seed % 256
    end

    local alphabet = { 'a', '/', '?', '#', ':', '@', '[', ']', '%', ' ', '\r', '\n', '\t', '\0', '.', '-', '\128', '\255', '1' }
    local accepted = 0
    for _ = 1, 4000 do
      local pieces: { string } = {}
      for _ = 1, 1 + nextByte() % 24 do
        table.insert(pieces, alphabet[1 + nextByte() % #alphabet])
      end

      local url = http.parseUrl(`http://{table.concat(pieces)}`)
      if not url then continue end

      accepted += 1
      expect((string.find(url.target, '[%c \128-\255]'))).toBeNil()
      expect((string.find(url.host, '[%c /?#@]'))).toBeNil()
      expect(string.sub(url.target, 1, 1)).toBe '/'
    end

    expect(accepted > 0).toBe(true)
  end)
end)

return suite
