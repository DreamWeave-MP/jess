--!strict
--!native
-- @jess/render/cull: which bounding spheres the standard camera may see.
--
-- Native whole: its one function is a loop over every sphere of a scene, every frame. On a
-- verified build, 20,000 spheres against the six planes took about 1.8 ms as bytecode and 0.4 ms
-- native. The conventions are the camera's: column-order matrices, and clip-space depth from 0
-- to 1.
local camera = require './camera'

local cull = {}

--- Marks which of `count` bounding spheres a view may see, and returns how many. `bounds` holds
--- each sphere as four `f32`s, its centre's `x`, `y`, `z` and its radius, 16 bytes a sphere;
--- `viewProjection` is projection after view, as `camera.multiply(projection, view)` gives it;
--- and `mask` gets a byte a sphere from `maskOffset` (0 by default): 1 where any of the sphere is
--- inside all six planes of the view, 0 where it is wholly outside one. A sphere near a corner
--- of the view may be marked though no part of it shows: the test errs toward drawing.
function cull.spheres(
  bounds: buffer,
  count: number,
  viewProjection: camera.Matrix,
  mask: buffer,
  maskOffset: number?
): number
  assert(#viewProjection == 16, `@jess/render/cull: a matrix is 16 numbers, not {#viewProjection}`)
  assert(
    count >= 0 and count * 16 <= buffer.len(bounds),
    `@jess/render/cull: {count} spheres of 16 bytes run past the {buffer.len(bounds)} given`
  )
  local first = maskOffset or 0
  assert(
    first >= 0 and first + count <= buffer.len(mask),
    `@jess/render/cull: {count} bytes from {first} run past a mask of {buffer.len(mask)}`
  )

  -- Each plane is `last` times the matrix's last row plus `sign` times another, scaled so its
  -- normal is one unit long: a point is inside it where the plane's dot with it isn't negative.
  local function plane(last: number, sign: number, row: number): (number, number, number, number)
    local normalX = last * viewProjection[4] + sign * viewProjection[row]
    local normalY = last * viewProjection[8] + sign * viewProjection[row + 4]
    local normalZ = last * viewProjection[12] + sign * viewProjection[row + 8]
    local offset = last * viewProjection[16] + sign * viewProjection[row + 12]
    local scale = 1 / math.sqrt(normalX * normalX + normalY * normalY + normalZ * normalZ)

    return normalX * scale, normalY * scale, normalZ * scale, offset * scale
  end

  local leftX, leftY, leftZ, leftW = plane(1, 1, 1)
  local rightX, rightY, rightZ, rightW = plane(1, -1, 1)
  local bottomX, bottomY, bottomZ, bottomW = plane(1, 1, 2)
  local topX, topY, topZ, topW = plane(1, -1, 2)
  local farX, farY, farZ, farW = plane(1, -1, 3)
  -- Depth starts at 0, not at minus the last row, so the near plane is the depth row alone.
  local nearX, nearY, nearZ, nearW = plane(0, 1, 3)
  local visible = 0

  for index = 0, count - 1 do
    local at = index * 16
    local centerX, centerY = buffer.readf32(bounds, at), buffer.readf32(bounds, at + 4)
    local centerZ = buffer.readf32(bounds, at + 8)
    local reach = -buffer.readf32(bounds, at + 12)
    local seen = if leftX * centerX + leftY * centerY + leftZ * centerZ + leftW >= reach
        and rightX * centerX + rightY * centerY + rightZ * centerZ + rightW >= reach
        and bottomX * centerX + bottomY * centerY + bottomZ * centerZ + bottomW >= reach
        and topX * centerX + topY * centerY + topZ * centerZ + topW >= reach
        and nearX * centerX + nearY * centerY + nearZ * centerZ + nearW >= reach
        and farX * centerX + farY * centerY + farZ * centerZ + farW >= reach
      then 1
      else 0
    buffer.writeu8(mask, first + index, seen)
    visible += seen
  end

  return visible
end

return table.freeze(cull)
