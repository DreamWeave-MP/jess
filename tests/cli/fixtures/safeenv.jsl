--!strict
--[[
Runs the safeenv canary's loop in the script's own environment, which jess marks safe so Luau calls
builtins like `math.floor` and `buffer.readi32` directly, and in a copy of it, which `setfenv`
marks unsafe: both must compute the same.

Whether the safe one is several times faster, which is what says builtins are on the fast path, is
the canary's to measure (`tools/bench/canaries/safeenv.jsl`), on a verified build: a ratio of two
timings is no test, since a busy machine slows one and not the other.
]]
local Canary = require '../../../tools/bench/canaries/safeenv'

local _, scaleText = ...
local count = 20000 * (tonumber(scaleText) or 1)

local safe, unsafe = Canary.makeLoop(), Canary.makeLoop()
setfenv(unsafe, table.clone(_G))

local started = os.clock()
local expected = safe(count)
local elapsed = os.clock() - started
assert(unsafe(count) == expected, 'the unsafe copy computed something else')
print(`canary {elapsed}`)
