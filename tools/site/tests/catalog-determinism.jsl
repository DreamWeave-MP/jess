--!strict
-- Generate the complete catalog twice from the same runtime and source tree.
local catalog = require '../generated-reference'
local fs = require '@dream/fs'
local json = require '@jess/json'
local first = catalog.generate '.'
local second = catalog.generate '.'
assert(first == second, 'API catalog changes between identical builds')
print('API catalog is deterministic')

local extracted = json.decode(first) :: { documents: { { slug: string, body: string } } }
local hasGpu = false
for _, document in extracted.documents do
  for code in string.gmatch(document.body, '```text\n(.-)```') do
    for line in string.gmatch(code, '[^\n]+') do
      assert(not string.match(line, '^[%w_./:]+%b()%s*%-%>'),
        `API reference: {document.slug} contains a copied signature in a text block`)
    end
  end

  if document.slug ~= 'gpu' then continue end
  hasGpu = true
  assert(not string.find(document.body, '| Field | Type |', 1, true), 'GPU fields must use generated types')
  assert(not string.find(document.body, '| Member | Type |', 1, true), 'GPU members must use generated types')
end
assert(hasGpu, 'GPU source documentation is missing')

local pages, walkProblem = fs.walk('site/content/docs/api', { include = 'files', sort = true })
if not pages then error(`API reference: {walkProblem}`, 0) end

for _, path in pages.paths do
  if path == '_index.md' or path == 'symbols.md' or not string.find(path, '%.md$') then continue end
  local content, readProblem = fs.readFileString(fs.join('site', 'content', 'docs', 'api', path))
  if not content then error(`API reference: {readProblem}`, 0) end
  local _, frontMatterEnd = string.find(content, '\n---\n', 5, true)
  assert(frontMatterEnd, `API reference: missing frontmatter in {path}`)
  local body = string.match(string.sub(content, frontMatterEnd + 1), '^%s*(.-)%s*$')
  assert(body == '<!-- Generated from the API documentation in Jess source. -->',
    `API reference: {path} must not maintain separate reference prose`)
end

local root = `target/reference-fixture-{os.time()}-{math.random(1, 1000000000)}`
local page = fs.join(root, 'site', 'content', 'docs', 'api', 'sample.md')
local Marker = '<!-- Generated from the API documentation in Jess source. -->'
local written, writeProblem = fs.writeFile(page, Marker, { createParents = true })
if not written then error(`fixture: {writeProblem}`, 0) end

local function reference(signature: string): string
  local input = json.encodeTable({
    schemaVersion = 2,
    modules = { '@jess/example' },
    symbols = { { name = '@jess/example.read', module = '@jess/example', signature = signature, description = '', source = 'sample.jsl' } },
    documents = { { slug = 'sample', module = '@jess/example', source = 'sample.jsl', body = '{{ api_symbol(value="@jess/example.read") }}' } },
  })
  local staging = catalog.prepare(root, input)
  local content, problem = fs.readFileString(fs.join(staging, 'content', 'docs', 'api', 'sample.md'))
  catalog.cleanup(staging)
  if not content then error(`fixture: {problem}`, 0) end
  return content
end

local before = reference('@jess/example.read(value: string) -> string')
local after = reference('@jess/example.read(value: number) -> number')
assert(string.find(before, 'read(value: string)', 1, true), 'original declaration missing')
assert(string.find(after, 'read(value: number)', 1, true), 'changed declaration missing')
local broken = json.encodeTable({
  schemaVersion = 2,
  modules = { '@jess/example' },
  symbols = {},
  documents = { { slug = 'sample', module = '@jess/example', source = 'sample.jsl', body = '{{ api_symbol(value="@jess/example.removed") }}' } },
})
-- Preparation raises when a source document names a removed symbol.
local ok, failure = pcall(catalog.prepare, root, broken)
assert(not ok and string.find(tostring(failure), 'references missing symbol', 1, true), 'missing symbol was not reported')
local copied = string.gsub(broken, '@jess/example.removed', '@jess/example.read')
copied = string.gsub(copied, 'api_symbol', 'api_signature')
-- Preparation raises when a source document contains a manually copied signature.
local copiedOk, copiedFailure = pcall(catalog.prepare, root, copied)
assert(not copiedOk and string.find(tostring(copiedFailure), 'contains a copied signature', 1, true),
  'copied signature was not reported')
local leftovers, listProblem = fs.list(fs.join(root, 'target'))
if not leftovers then error(`fixture: {listProblem}`, 0) end
assert(#leftovers == 0, 'failed preparation left a temporary site behind')
local removed, problem = fs.remove(root, { recursive = true })
if not removed then error(`fixture: {problem}`, 0) end
print('source declaration changes update the reference')
