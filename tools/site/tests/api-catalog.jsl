--!strict
local test = require '@jess/test'
local catalog = require '../api-catalog'

local Definitions = [[declare jess: {
  application: {
    exit: (status: number?) -> (),
  },
}]]
local Documentation = [[## jess.application.exit

jess.application.exit(status: number?) -> ()]]
local suite = test.new()

suite.it('extracts the documented signature', function()
  local symbols = catalog.moduleSymbols(Definitions, Documentation, 'application')
  test.expect(#symbols).toBe(1)
  test.expect(symbols[1].signature).toBe 'jess.application.exit(status: number?) -> ()'
  test.expect(symbols[1].anchor).toBe 'jess-application-exit'
end)

suite.it('indexes the generated global itself', function()
  local symbols = catalog.rootInventory('declare jess: { version: string, granted: (name: string) -> boolean }')
  test.expect(#symbols).toBe(2)
  test.expect(symbols[1].name).toBe 'jess.version'
  test.expect(symbols[2].signature).toBe 'jess.granted(name: string) -> boolean'
end)

suite.it('detects added, removed, and moved built-in modules', function()
  local expected = { ['@jess/a'] = 'src/a.jsl' }
  catalog.checkModules(expected, { ['@jess/a'] = 'src/a.jsl' })
  test.expect(function() catalog.checkModules(expected, { ['@jess/b'] = 'src/b.jsl' }) end).toThrow 'new built-in module'
  test.expect(function() catalog.checkModules(expected, {}) end).toThrow 'obsolete built-in module'
  test.expect(function() catalog.checkModules(expected, { ['@jess/a'] = 'src/new.jsl' }) end).toThrow 'moved to'
end)

suite.it('detects signature drift without depending on symbol order', function()
  local first = { name = 'x.a', module = '@jess/x', signature = 'x.a() -> ()', page = 'docs/api/x/', anchor = '', checked = false }
  local second = { name = 'x.b', module = '@jess/x', signature = 'x.b: number', page = 'docs/api/x/', anchor = '', checked = false }
  local baseline = catalog.fingerprints { first, second }
  catalog.checkFingerprints(baseline, catalog.fingerprints { second, first })
  local changed = table.clone(second)
  changed.signature = 'x.b: string'
  test.expect(function() catalog.checkFingerprints(baseline, catalog.fingerprints { first, changed }) end).toThrow 'surface for @jess/x changed'
  test.expect(function() catalog.checkFingerprints(baseline, {}) end).toThrow 'surface for @jess/x changed'
  test.expect(function() catalog.checkFingerprints({}, baseline) end).toThrow 'surface for @jess/x changed'
end)

suite.it('refuses an undocumented new member', function()
  local changed = string.gsub(Definitions, 'exit:', 'stop:')
  test.expect(function() catalog.moduleSymbols(changed, Documentation, 'application') end).toThrow 'missing documentation'
end)

suite.it('refuses a changed signature', function()
  local changed = string.gsub(Definitions, 'status: number%?', 'status: string')
  test.expect(function() catalog.moduleSymbols(changed, Documentation, 'application') end).toThrow 'signature drift'
end)

suite.it('refuses an obsolete documented member', function()
  local changed = Documentation .. '\n## jess.application.stop\n'
  test.expect(function() catalog.moduleSymbols(Definitions, changed, 'application') end).toThrow 'obsolete documentation'
end)

suite.it('extracts function and value signatures from generated stubs', function()
  local stub = [[local module: {
  open: (path: string) -> number,
  limit: number,
} = (nil :: any)
return module]]
  local docs = [[### sample.open
sample.open(path: string) -> number

### sample.limit
sample.limit: number]]
  local symbols = catalog.stubSymbols(stub, docs, 'sample')
  test.expect(#symbols).toBe(2)
  test.expect(symbols[1].signature).toBe 'sample.limit: number'
  test.expect(symbols[2].signature).toBe 'sample.open(path: string) -> number'
end)

suite.it('reads explicitly typed JSON exports from generated source', function()
  local source = [[local Null = nil
local function decode(text: string): unknown return text end
return table.freeze { decode = decode, null = Null }]]
  local symbols = catalog.sourceSymbols(source, '## json.decode', 'json')
  test.expect(#symbols).toBe(2)
  test.expect(symbols[1].signature).toBe 'json.decode(text: string) -> unknown'
  test.expect(symbols[2].signature).toBe 'json.null'
  test.expect(symbols[1].checked).toBe(false)
end)

suite.it('checks generated source signatures against their reference', function()
  local source = [[local function decode(text: string): unknown return text end
return table.freeze { decode = decode }]]
  local documentation = '## json.decode\njson.decode(text: string) -> unknown'
  local symbols = catalog.sourceSymbols(source, documentation, 'json', false, '@jess/json', nil, true)
  test.expect(symbols[1].checked).toBe(true)
  test.expect(function()
    catalog.sourceSymbols(source, '## json.decode\njson.decode(text: number) -> unknown', 'json', false, '@jess/json', nil, true)
  end).toThrow 'signature drift'
end)

suite.it('checks each generated function in a grouped heading', function()
  local source = [[local function first(): string return 'first' end
local function second(): string return 'second' end
return table.freeze { first = first, second = second }]]
  local signatures = 'sample.first() -> string; sample.second() -> string'
  local documentation = `## sample.first, sample.second\n{signatures}`
  local symbols = catalog.sourceSymbols(source, documentation, 'sample', true, nil, nil, true)
  test.expect(symbols[1].checked).toBe(true)
  test.expect(symbols[2].checked).toBe(true)
  test.expect(function()
    catalog.sourceSymbols(source, `## sample.first\n{signatures}`, 'sample', true, nil, nil, true)
  end).toThrow 'missing heading'
end)

suite.it('refuses an undocumented source export', function()
  local source = [[local function write(data: string): string return data end
return table.freeze { write = write }]]
  test.expect(function() catalog.sourceSymbols(source, '', 'backup') end).toThrow 'missing documentation'
end)

suite.it('indexes grouped source documentation without inventing an anchor', function()
  local source = [[local function first(): string return 'first' end
local function second(): string return 'second' end
return table.freeze { first = first, second = second }]]
  local symbols = catalog.sourceSymbols(source, '## sample.first, sample.second', 'sample', true)
  test.expect(#symbols).toBe(2)
  test.expect(symbols[2].anchor).toBe ''
  test.expect(function() catalog.sourceSymbols(source, 'sample.first', 'sample', true) end).toThrow 'missing documentation'
end)

suite.it('keeps the qualified module name and inferred constants', function()
  local source = [[local Null = nil
local function array(items: { string }): { string } return items end
return table.freeze { Null = Null, array = array }]]
  local symbols = catalog.sourceSymbols(source, 'value.Null value.array', 'value', true, '@jess/data/value')
  test.expect(symbols[1].module).toBe '@jess/data/value'
  test.expect(symbols[1].signature).toBe 'value.Null'
  test.expect(symbols[2].signature).toBe 'value.array(items: { string }) -> { string }'
end)

suite.it('indexes anonymous functions without inventing an inferred return type', function()
  local source = [[return table.freeze { add = function(value: string) print(value) end }]]
  local symbols = catalog.sourceSymbols(source, 'sample.add', 'sample', true)
  test.expect(symbols[1].signature).toBe 'sample.add(value: string)'
end)

suite.it('indexes a native wrapper using the generated native signature', function()
  local source = [[local Native = require '@jess'
return table.freeze { runtime = Native.runtime }]]
  local aliases = { ['Native.runtime'] = 'input.runtime(options: Options?) -> Runtime' }
  local symbols = catalog.sourceSymbols(source, 'input.runtime', 'input', true, '@jess/input', aliases)
  test.expect(symbols[1].signature).toBe 'input.runtime(options: Options?) -> Runtime'
  test.expect(function() catalog.sourceSymbols(source, 'input.runtime', 'input', true, '@jess/input', {}) end).toThrow 'unsupported input export'
end)

suite.it('indexes the audio module returned as a plain table', function()
  local source = [[local Native = {}
return { pcm = Native.pcm }]]
  local aliases = { ['Native.pcm'] = 'audio.pcm(data: buffer) -> Pcm' }
  local symbols = catalog.sourceSymbols(source, 'audio.pcm', 'audio', true, '@jess/audio', aliases)
  test.expect(symbols[1].signature).toBe 'audio.pcm(data: buffer) -> Pcm'
end)

suite.it('indexes a re-exported function using its defining source signature', function()
  local source = [[local check = require '@self/check'
return table.freeze { check = check }]]
  local aliases = { check = 'style.check(text: string) -> string' }
  local symbols = catalog.sourceSymbols(source, 'style.check', 'style', true, '@jess/style', aliases)
  test.expect(symbols[1].signature).toBe 'style.check(text: string) -> string'
end)

suite.it('preserves an exported string literal', function()
  local source = [[return table.freeze { version = '1.2' }]]
  local symbols = catalog.sourceSymbols(source, '', 'yaml')
  test.expect(symbols[1].signature).toBe "yaml.version = '1.2'"
  test.expect(symbols[1].anchor).toBe ''
end)

suite.it('refuses an unsupported source export instead of omitting it', function()
  local source = [[return table.freeze { decode = parser.decode }]]
  test.expect(function() catalog.sourceSymbols(source, '## json.decode', 'json') end).toThrow 'unsupported json export'
end)

suite.it('indexes generated types and native methods without claiming behavioral verification', function()
  local definitions = [[export type AudioOptions = { rate: number }
declare extern type jess_runtime_Worker with
  function send(self, message: any): ()
end]]
  local symbols = catalog.typeInventory(definitions)
  test.expect(#symbols).toBe(4)
  test.expect(symbols[1].name).toBe 'AudioOptions'
  test.expect(symbols[2].signature).toBe 'AudioOptions.rate: number'
  test.expect(symbols[3].page).toBe 'docs/api/worker/'
  test.expect(symbols[4].name).toBe 'jess_runtime_Worker.send'
  test.expect(symbols[4].signature).toBe 'function send(self, message: any): ()'
  test.expect(symbols[4].checked).toBe(false)
end)

suite.it('indexes exported source types under their package-qualified names', function()
  local source = [[type Private = string
export type Options = { limit: number? }
export type Value = string | number]]
  local symbols = catalog.sourceTypes(source, '@jess/example', 'docs/api/example/')
  test.expect(#symbols).toBe(3)
  test.expect(symbols[1].name).toBe '@jess/example.Options'
  test.expect(symbols[2].signature).toBe '@jess/example.Options.limit: number?'
  test.expect(symbols[3].signature).toBe 'export type Value = string | number'
end)

suite.it('indexes functions defined on a returned frozen module table', function()
  local source = [[local camera = {}
function camera.write(value: string) print(value) end
return table.freeze(camera)]]
  local symbols = catalog.tableFunctions(source, 'camera.write', 'camera', '@jess/render/camera')
  test.expect(#symbols).toBe(1)
  test.expect(symbols[1].signature).toBe 'camera.write(value: string)'
  test.expect(symbols[1].anchor).toBe 'the-camera'
  test.expect(function() catalog.tableFunctions(source, '', 'camera', '@jess/render/camera') end).toThrow 'missing documentation'
  local changed = string.gsub(source, 'return table.freeze', 'camera.extra = true\nreturn table.freeze')
  test.expect(function() catalog.tableFunctions(changed, 'camera.write', 'camera', '@jess/render/camera') end).toThrow 'unsupported camera.extra'
end)

suite.it('renders stable escaped symbol references without JavaScript', function()
  local symbol = {
    name = 'x.y', module = '@jess/x', signature = 'x.y(value: string) -> string & number',
    page = 'docs/api/x/', anchor = 'x-y', checked = false,
  }
  test.expect(catalog.symbolAnchor 'x.y').toBe 'symbol-782e79'
  test.expect(catalog.symbolAnchor 'café').toBe 'symbol-636166c3a9'
  local rendered = catalog.renderSymbols({ symbol }, '/')
  test.expect(string.find(rendered, 'id="symbol-782e79"', 1, true) ~= nil).toBe(true)
  test.expect(string.find(rendered, 'href="/docs/api/x/#x-y"', 1, true) ~= nil).toBe(true)
  test.expect(string.find(rendered, 'string &amp; number', 1, true) ~= nil).toBe(true)
  test.expect(function() catalog.renderSymbols({ symbol, symbol }, '/') end).toThrow 'duplicate symbol'
end)

return suite
