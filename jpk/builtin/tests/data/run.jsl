--!strict
--!native
-- The built-in text decoders' and encoders' contract cases. The larger differential/fuzz corpus lives outside
-- this package test: these are the small cases a Jess build should never regress.
local json = require '@jess/json'
local toml = require '@jess/data/toml'
local values = require '@jess/data/value'
local yaml = require '@jess/yaml'
local test = require '@jess/test'
local expect = test.expect
local suite = test.new()

-- What each test expects a document to hold. A decoder answers `unknown`: the shape is the
-- test's claim, and its expectations check it.
type Escapes = { text: string, values: { unknown } }
type Fruits = { fruit: { apple: { smooth: boolean }, name: string }, products: { { name: string, detail: { color: string } } } }
type CoreSchema = { nulls: { unknown }, booleans: { boolean }, integers: { number }, floats: { number }, strings: { string } }
type Nodes = { first: { folded: string, literal: string, flow: { unknown } }, second: unknown, custom: yaml.Tagged }
type Trailing = { quoted: string, single: string, flow: { number }, map: { a: number }, tagged: string, items: { unknown } }
type Quotes = { ["Maren's House"]: string, plain: string, said: string, indexed: string, list: { string } }
type Layered = {
  empty_map: unknown,
  empty_list: unknown,
  block_map: unknown,
  block_list: unknown,
  mixed: unknown,
  nested: unknown,
  custom: yaml.Tagged,
  compact: { { [string]: number } },
}

suite.describe('ordered values', function()
  suite.it('keeps one key when nil is assigned and replaced', function()
    local fields = values.map()
    values.set(fields, 'name', nil)
    expect(values.encode(fields, 'json')).toBe '{"name":null}'
    values.set(fields, 'name', 'Jess')
    values.set(fields, 'name', nil)
    values.set(fields, 'name', 'Jess')
    expect(fields.keys).toEqual { 'name' }
    expect(values.encode(fields, 'json')).toBe '{"name":"Jess"}'
  end)
end)

suite.describe('json', function()
  suite.it('decodes RFC 8259 values and UTF-16 escapes', function()
    local value = json.decode '{"text":"\\uD83D\\uDE03","values":[1,-2.5e2,true,false,null]}' :: Escapes
    expect(value.text).toBe '😃'
    expect(value.values[1]).toBe(1)
    expect(value.values[2]).toBe(-250)
    expect(value.values[3]).toBe(true)
    expect(value.values[4]).toBe(false)
    expect(value.values[5]).toBe(json.null)
  end)

  suite.it('is strict about separators, numbers, strings, and trailing data', function()
    local invalid = {
      '[1,]',
      '{"a":1,}',
      '01',
      '+1',
      '1.',
      '1e',
      '"\\q"',
      '"\\uD800"',
      'true false',
    }

    for _, source in invalid do
      expect(function() json.decode(source) end).toThrow 'json:'
    end
  end)

  suite.it('rejects numbers outside the finite number range', function()
    expect(function() json.decode '1e999' end).toThrow 'number cannot be represented'
    expect(function() json.decode '-1e999' end).toThrow 'number cannot be represented'
  end)
end)

suite.describe('toml', function()
  suite.it('implements TOML 1.1 values and keeps the native layout side channel', function()
    local value, layout = toml.decode [=[
name = "Jess"
max = 9223372036854775807
small = 42
float = 2.0
when = 1979-05-27T07:32Z
mixed = [1, "two", true,]
inline = {
  one = 1,
  two = 2,
}
]=]
    expect(value.name).toBe 'Jess'
    expect(typeof(value.small)).toBe 'number'
    expect(value.small).toBe(42)
    expect(typeof(value.max)).toBe 'integer'
    expect(tostring(value.max)).toBe '9223372036854775807'
    expect(value.when).toBe '1979-05-27T07:32Z'
    expect(value.mixed).toEqual { 1, 'two', true }
    expect(value.inline).toEqual { one = 1, two = 2 }
    expect(layout[value].keys).toEqual { 'name', 'max', 'small', 'float', 'when', 'mixed', 'inline' }
    expect(layout[value].floats.float).toBe(true)
    expect(layout[value].datetimes.when).toBe(true)
    expect(layout[value].datetimes.name).toBe(nil)

    local times, timesLayout = toml.decode 'times = [1979-05-27, 2, 07:32:00]'
    expect(timesLayout[times.times].datetimes).toEqual { [1] = true, [3] = true }
  end)

  suite.it('implements dotted tables and arrays of tables', function()
    local value = toml.decode [=[
[fruit.apple]
smooth = true
[fruit]
name = "apple"
[[products]]
name = "Hammer"
[[products]]
name = "Nail"
[products.detail]
color = "gray"
]=] :: Fruits
    expect(value.fruit.apple.smooth).toBe(true)
    expect(value.fruit.name).toBe 'apple'
    expect(value.products[1].name).toBe 'Hammer'
    expect(value.products[2].detail.color).toBe 'gray'
  end)

  suite.it('rejects TOML structural and numeric errors', function()
    local invalid = {
      'a = 01',
      'a = 1_',
      'a = 0x8000000000000000',
      'a = 1979-02-29',
      'a = "\\q"',
      'a = 1\na = 2',
      'a.b = 1\n[a]',
      'a = { b = 1 }\na.c = 2',
    }

    for _, source in invalid do
      expect(function() toml.decode(source) end).toThrow 'toml:'
    end
  end)

  suite.it('places a duplicate key at the key, inline or not', function()
    expect(function() toml.decode 'a = 1\na = 22\n' end).toThrow "duplicate key 'a' at line 2, column 1"
    expect(function() toml.decode 't = { a = 1, a = 2 }' end).toThrow "duplicate key 'a' at line 1, column 14"
  end)

  suite.it('records where keys and values are, when asked', function()
    local text = 'name = "Ada"\n[owner]\nage = 3\n'
    local document, layout = toml.decode(text, { positions = true })
    local positions = assert(layout[document].positions)
    local name = positions.name
    expect(name.key).toBe(1)
    expect(string.sub(text, name.value, name.valueEnd)).toBe '"Ada"'
    expect(positions.owner.key).toBe(15)
    expect(assert(layout[document.owner].positions).age.value).toBe(28)

    local again, plain = toml.decode(text)
    expect(plain[again].positions).toBeNil()
  end)
end)

suite.describe('yaml', function()
  suite.it('uses the YAML 1.2 Core schema', function()
    local value = yaml.decode [[
nulls: [null, Null, NULL, ~]
booleans: [true, True, FALSE]
integers: [12, -19, 0o17, 0x3A]
floats: [.5, +12e03, -.Inf, .NAN]
strings: [yes, no, on, off]
]] :: CoreSchema
    for _, item in value.nulls do expect(item).toBe(yaml.null) end
    expect(value.booleans).toEqual { true, true, false }
    expect(value.integers).toEqual { 12, -19, 15, 58 }
    expect(value.floats[1]).toBe(0.5)
    expect(value.floats[2]).toBe(12000)
    expect(value.floats[3]).toBe(-math.huge)
    expect(value.floats[4] ~= value.floats[4]).toBe(true)
    expect(value.strings).toEqual { 'yes', 'no', 'on', 'off' }
  end)

  suite.it('loads block, flow, anchor, alias, and custom-tag nodes', function()
    local value = yaml.decode [[
first: &base
  name: Jess
  folded: >-
    one
    two
  flow: [1, {two: 2},]
  literal: |
    a
    b
second: *base
custom: !<tag:example.com,2026:thing> hello
]] :: Nodes
    expect(value.second == value.first).toBe(true)
    expect(value.first.folded).toBe 'one two'
    expect(value.first.literal).toBe 'a\nb\n'
    expect((value.first.flow[2] :: { two: number }).two).toBe(2)
    expect(value.custom.tag).toBe 'tag:example.com,2026:thing'
    expect(value.custom.value).toBe 'hello'
  end)

  -- A block scalar keeps its last line break under clip whether the source ends there or not.
  -- Every expected value here is what PyYAML loads from the same text.
  suite.it('chomps a block scalar at the end of the source as it does before more content', function()
    local cases: { { string } } = {
      { 'a: |\n  x\n', 'x\n' },
      { 'a: >\n  x\n  y\n', 'x y\n' },
      { 'a: |\n  x\nb: 1\n', 'x\n' },
      { 'a: |\n  x\n  y\n', 'x\ny\n' },
      { 'a: >\n  x\n\n  y\n', 'x\ny\n' },
      { 'a: >\n  x\n\n  y\n\n', 'x\ny\n' },
      { 'a: |-\n  x\n', 'x' },
      { 'a: >-\n  x\n', 'x' },
      { 'a: |+\n  x\n', 'x\n' },
      { 'a: >+\n  x\n', 'x\n' },
      { 'a: |+\n  x\n\n', 'x\n\n' },
      { 'a: >+\n  x\n  y\n\n', 'x y\n\n' },
      { 'a: |\n  x', 'x' },
      { 'a: >\n  x\n  y', 'x y' },
      { 'a: |+\n  x', 'x' },
      { 'a: |+\n  x\n  ', 'x\n' },
      { 'a: >+\n  x\n\n  ', 'x\n\n' },
      { 'a: |\n  x\n\n\n', 'x\n' },
      { 'a: >\n  x\n\n\n', 'x\n' },
      { 'a: |-\n  x\n\n\n', 'x' },
      { 'a: |+\n  x\n\n\n', 'x\n\n\n' },
      { 'a: >+\n  x\n\n\n', 'x\n\n\n' },
      { 'a: >+\n  x\n\nb: 1\n', 'x\n\n' },
      { 'a: |\n', '' },
      { 'a: |+\n', '' },
      { 'a: |\n\n\n', '' },
      { 'a: |+\n\n', '\n' },
      { 'a: |+\n\n\n', '\n\n' },
    }

    for _, case in cases do
      local value = yaml.decode(case[1]) :: { a: string }
      expect(value.a).toBe(case[2])
    end

    expect(yaml.decode '- |\n  x\n').toEqual { 'x\n' }
    expect(yaml.decode '- >\n  x\n  y\n').toEqual { 'x y\n' }
    expect(yaml.decode '- >+\n  x\n\n\n').toEqual { 'x\n\n\n' }

    local nested = yaml.decode 'a:\n  b:\n    - c: |\n        x\n' :: { a: { b: { { c: string } } } }
    expect(nested.a.b[1].c).toBe 'x\n'

    local folded = yaml.decode 'a:\n  b: >\n    x\n    y\n' :: { a: { b: string } }
    expect(folded.a.b).toBe 'x y\n'
  end)

  suite.it('loads independent documents and rejects malformed graphs', function()
    local documents = yaml.decodeAll '---\none\n...\n---\ntwo\n...\n'
    expect(documents).toEqual { 'one', 'two' }
    expect(function() yaml.decode '[1,,2]' end).toThrow 'YAML:'
    expect(function() yaml.decode 'value: *missing' end).toThrow 'YAML:'
    expect(function() yaml.decode 'a: 1\na: 2' end).toThrow 'YAML:'
  end)

  suite.it('reads a node from where it starts, whatever blanks or comment follow it', function()
    local value = yaml.decode(
      'quoted: "hello world"   \r\nsingle: \'it\'\'s\' \nflow: [1, 2] # two\nmap: {a: 1} \n'
        .. 'tagged: !!str "5" \nitems:\n  - "x" # first\n  - [3] \n'
    ) :: Trailing
    expect(value.quoted).toBe 'hello world'
    expect(value.single).toBe "it's"
    expect(value.flow).toEqual { 1, 2 }
    expect(value.map.a).toBe(1)
    expect(value.tagged).toBe '5'
    expect(value.items[1]).toBe 'x'
    expect(value.items[2]).toEqual { 3 }
  end)

  -- Localization files name places in their keys: `Maren's House: "..."`, quote and all.
  suite.it('reads a quote or a bracket inside a plain scalar as its own byte', function()
    local value = yaml.decode(
      'Maren\'s House: "v"\nplain: it\'s fine # c\nsaid: say "hi" # c\nindexed: k[1] # c\n'
        .. 'list:\n  - it\'s # c\n'
    ) :: Quotes
    expect(value["Maren's House"]).toBe 'v'
    expect(value.plain).toBe "it's fine"
    expect(value.said).toBe 'say "hi"'
    expect(value.indexed).toBe 'k[1]'
    expect(value.list).toEqual { "it's" }
  end)

  -- A root node may start on the `---` line, or put its properties on a line of their own.
  suite.it('starts a root node on its --- line or after its own properties', function()
    expect(yaml.decode '--- [1.0]\n').toEqual { 1 }
    expect(yaml.decode '--- |\n  x\n').toBe 'x\n'
    expect(yaml.decode '--- plain\n').toBe 'plain'
    expect(yaml.decode '--- # only a comment\nkey: 1\n').toEqual { key = 1 }
    expect(yaml.decode '--- !thing\nkey: 1\n').toEqual { tag = '!thing', value = { key = 1 } }
    expect(yaml.decode '!thing\nkey: 1\n').toEqual { tag = '!thing', value = { key = 1 } }
    expect(yaml.decode '---\n!thing\n- item\n').toEqual { tag = '!thing', value = { 'item' } }
    local anchored = yaml.decode '--- &root\nkey: 1\n' :: { key: number }
    expect(anchored.key).toBe(1)
    expect(yaml.decodeAll '--- [1]\n--- [2]\n').toEqual { { 1 }, { 2 } }
    expect(yaml.decodeAll '--- first\n...\n--- second\n').toEqual { 'first', 'second' }
    expect(function() yaml.decode '--- key: 1\n' end).toThrow "YAML: a block collection cannot start on the '---' line"
    expect(function() yaml.decode '--- - item\n' end).toThrow "YAML: a block collection cannot start on the '---' line"
    -- An indented --- is content, not a marker.
    expect(yaml.decode 'key: x\n  --- y\n').toEqual { key = 'x --- y' }
    expect(yaml.decode '- item\n- ---\n').toEqual { 'item', '---' }
  end)

  -- A tag on a line of its own resolves the scalar's text, as the same tag inline would.
  suite.it('resolves a scalar under a tag from the line above as the tag says', function()
    expect(yaml.decode 'key: !!str\n  0x10\n').toEqual { key = '0x10' }
    expect(yaml.decode '!!str\n1.0\n').toBe '1.0'
    expect(yaml.decode 'key: !\n  1.5\n').toEqual { key = '1.5' }
    expect(yaml.decode 'key: !!float\n  .inf\n').toEqual { key = math.huge }
    expect(function() yaml.decode 'key: !!int\n  1.0\n' end).toThrow 'YAML: invalid !!int scalar'
    local _, layout = yaml.decodeWithLayout 'key: !\n  1.5\nother: !!float\n  2\n'
    local marks = {}
    for _, entry in layout do
      marks = entry.floats
    end
    expect(marks).toEqual { other = true }
  end)

  suite.it('reads a compact mapping as its own column says', function()
    expect(yaml.decode '- first:\n  second: 1\n').toEqual { { first = jess.null, second = 1 } }
    expect(yaml.decode '- first:\n    second: 1\n').toEqual { { first = { second = 1 } } }
    expect(yaml.decode '- first:\n  - item\n').toEqual { { first = { 'item' } } }
    local anchored = yaml.decode '- &base first: 1.5\n  second: 2\n- *base\n' :: { unknown }
    expect(anchored[1]).toEqual { first = 1.5, second = 2 }
    expect(anchored[2]).toBe(anchored[1])
    expect(yaml.decode '- !thing first: 1\n').toEqual { { tag = '!thing', value = { first = 1 } } }
    local value, layout = yaml.decodeWithLayout '- first: 1\n  second: 2\n'
    local count = 0
    for _ in layout do
      count += 1
    end
    expect(count).toBe(2)
    expect(layout[(value :: { unknown })[1]].keys).toEqual { 'first', 'second' }
  end)

  suite.it('refuses an integer outside the signed 64-bit range rather than clamping or wrapping it', function()
    expect(typeof(yaml.decode '9223372036854775807')).toBe 'integer'
    expect(typeof(yaml.decode '-9223372036854775808')).toBe 'integer'
    expect(typeof(yaml.decode '0x7fffffffffffffff')).toBe 'integer'
    expect(yaml.decode '000000000000000000000001').toBe(1)
    for _, text in { '9223372036854775808', '-9223372036854775809', '99999999999999999999', '0xffffffffffffffffff', '0x8000000000000000', '0o1000000000000000000000' } do
      expect(function() yaml.decode(text) end).toThrow 'YAML: integer is outside the signed 64-bit Luau range'
    end
  end)

  -- A plain scalar's quotes are its own bytes, and it can never hold a mapping.
  suite.it('reads a plain scalar as YAML does: quotes inside it are text, a colon and blank end it', function()
    expect(yaml.decode 'run: echo "a #b"\n').toEqual { run = 'echo "a' }
    expect(yaml.decode "run: echo '#x' # comment\n").toEqual { run = "echo '#x'" }
    expect(yaml.decode 'run: echo "a:b"\n').toEqual { run = 'echo "a:b"' }
    expect(yaml.decode 'key: http://example.test\n').toEqual { key = 'http://example.test' }
    expect(yaml.decode 'key: first\n  - second\n').toEqual { key = 'first - second' }
    expect(yaml.decode 'key: first\n  second:third\n').toEqual { key = 'first second:third' }
    expect(yaml.decode 'key: "quoted: colon # and hash"\n').toEqual { key = 'quoted: colon # and hash' }
    expect(yaml.decode "- 'it''s: fine'\n").toEqual { "it's: fine" }
    for _, text in { 'run: echo "a: b"\n', 'key: first: second\n', 'key: first\n  second: third\n', 'run: first:\n', 'name: Setup\n  description: more\n' } do
      expect(function() yaml.decode(text) end).toThrow 'YAML: mapping values are not allowed in a plain scalar'
    end
  end)

  suite.it('refuses a compact mapping continued off its column, and control characters', function()
    expect(function() yaml.decode '- first: [1]\n   second: 2\n' end).toThrow 'YAML: a compact mapping continues at the column of its first key'
    expect(function() yaml.decode '- first: 1\n   second: 2\n' end).toThrow 'YAML: mapping values are not allowed in a plain scalar'
    expect(function() yaml.decode 'key: a\0b\n' end).toThrow 'YAML: control characters are not allowed'
    expect(function() yaml.decode 'key: a\27b\n' end).toThrow 'YAML: control characters are not allowed'
    expect(function() yaml.decode 'key: a\u{9F}b\n' end).toThrow 'YAML: control characters are not allowed'
    expect(yaml.decode 'key: a\tb\r\n').toEqual { key = 'a\tb' }
    expect(yaml.decode 'key: a\u{85}b\n').toEqual { key = 'a\u{85}b' }
  end)

  suite.it('reads implicit flow entries, any 1.x version, and block indentation from a compact key', function()
    expect(yaml.decode 'map: {first, second: 2}\n').toEqual { map = { first = jess.null, second = 2 } }
    expect(function() yaml.decode 'map: {, second}\n' end).toThrow "YAML: expected ':' in flow mapping"
    expect(yaml.decode '%YAML 1.1\n---\nkey: value\n').toEqual { key = 'value' }
    expect(function() yaml.decode '%YAML 2.0\n---\nkey: value\n' end).toThrow 'YAML: unsupported YAML version 2.0'
    expect(function() yaml.decode 'key: !! value\n' end).toThrow 'YAML: a tag handle needs a suffix'
    expect(yaml.decode 'key: ! value\n').toEqual { key = 'value' }
    expect(yaml.decode '- run: |2\n     indented\n').toEqual { { run = ' indented\n' } }
    expect(yaml.decode 'run: |2\n   indented\n').toEqual { run = ' indented\n' }
    expect(yaml.decode '- |2\n   indented\n').toEqual { ' indented\n' }
  end)

  -- A Luau table can't say whether the file wrote `{}` or `[]`, `{1: a}` or `[a]`, `1.0` or `1`.
  suite.it('keeps the layout side channel the Luau tables forget', function()
    local text = 'empty_map: {}\nempty_list: []\nblock_map:\n  1: a\n  2: b\nblock_list:\n  - a\n  - b\n'
      .. 'whole: 1\nfraction: 1.0\nexponent: 1e3\ninfinite: .inf\ntagged: !!float 1\ncounted: !!int 2\n'
      .. 'quoted: "1.0"\nanchored: &ratio 2.5\naliased: *ratio\nmixed: [1, 1.0, *ratio]\nnested: [1.0]\n'
      .. 'custom: !thing {}\ncompact:\n  - first: 1.5\n    second: 2\n'
    local value, layout = yaml.decodeWithLayout(text)
    local document = value :: Layered
    local top = layout[document]
    expect(top.keys).toEqual {
      'empty_map', 'empty_list', 'block_map', 'block_list', 'whole', 'fraction', 'exponent', 'infinite', 'tagged',
      'counted', 'quoted', 'anchored', 'aliased', 'mixed', 'nested', 'custom', 'compact',
    }
    expect(layout[document.empty_map].keys).toEqual {}
    expect(layout[document.empty_list].keys).toBe(nil)
    expect(layout[document.block_map].keys).toEqual { 1, 2 }
    expect(layout[document.block_list].keys).toBe(nil)
    expect(document.block_map).toEqual(document.block_list)
    expect(top.floats).toEqual { fraction = true, exponent = true, infinite = true, tagged = true, anchored = true, aliased = true }
    expect(layout[document.mixed].floats).toEqual { [2] = true, [3] = true }
    expect(layout[document.nested].floats).toEqual { [1] = true }
    expect(layout[document.custom]).toBe(nil)
    expect(layout[document.custom.value].keys).toEqual {}
    local compact = document.compact[1]
    expect(layout[compact].keys).toEqual { 'first', 'second' }
    expect(layout[compact].floats).toEqual { first = true }

    local documents, all = yaml.decodeAllWithLayout '---\n[1.0]\n---\n{}\n'
    expect(all[documents[1]].floats).toEqual { [1] = true }
    expect(all[documents[2]].keys).toEqual {}
    local _, none = yaml.decodeWithLayout ''
    expect((next(none))).toBe(nil)
  end)
end)

suite.describe('encode', function()
  --- One document with a field of each kind, in an order no sort would give. TOML has no null.
  local function document(null: boolean): values.Map
    local fields: { { unknown } } = {
      { 'name', 'Jess' },
      { 'count', 3 },
      { 'ratio', values.float(2) },
      { 'tags', values.array { 'a', 'b' } },
      { 'absent', nil },
      { 'nested', values.struct { { 'on', true }, { 'note', 'yes' } } },
    }

    if null then table.insert(fields, 2, { 'nothing', values.Null }) end

    return values.struct(fields)
  end

  suite.it('writes JSON on one line, fields in the order they were built', function()
    expect(json.encode(document(true))).toBe(
      '{"name":"Jess","nothing":null,"count":3,"ratio":2.0,"tags":["a","b"],"absent":null,'
        .. '"nested":{"on":true,"note":"yes"}}'
    )
  end)

  suite.it('writes YAML in block style, quoting only what a reader would take for something else', function()
    expect(yaml.encode(document(true))).toBe(table.concat({
      'name: Jess',
      'nothing: null',
      'count: 3',
      'ratio: 2.0',
      'tags:',
      '- a',
      '- b',
      'absent: null',
      'nested:',
      '  on: true',
      '  note: yes',
      '',
    }, '\n'))
  end)

  suite.it('writes TOML with tables after values, and leaves an absent field out', function()
    expect(toml.encode(document(false))).toBe(table.concat({
      'name = "Jess"',
      'count = 3',
      'ratio = 2.0',
      'tags = [',
      '    "a",',
      '    "b",',
      ']',
      '',
      '[nested]',
      'on = true',
      'note = "yes"',
      '',
    }, '\n'))

    expect(function() toml.encode(document(true)) end).toThrow 'toml:'
  end)

  suite.it('writes what each decoder reads back as the same values', function()
    local fromJson = json.decode(json.encode(document(true))) :: toml.Table
    local fromYaml = yaml.decode(yaml.encode(document(true))) :: toml.Table
    local fromToml = toml.decode(toml.encode(document(false)))

    local documents: { toml.Table } = { fromJson, fromYaml, fromToml }

    for _, read in documents do
      expect({ read.name, read.count, read.ratio }).toEqual { 'Jess', 3, 2 }
      expect(read.tags).toEqual { 'a', 'b' }
      expect(read.nested).toEqual { on = true, note = 'yes' }
    end

    expect(fromJson.nothing).toBe(json.null)
    expect(fromYaml.nothing).toBe(yaml.null)
  end)

  -- A document is written in chunks, so millions of lines never need one table past Luau's 2^26
  -- entries; this one crosses many chunk boundaries and must read as if written whole.
  suite.it('writes a document of many pieces whole, in order', function()
    local items: { unknown } = {}
    local jsonItems: { string }, yamlLines: { string } = {}, {}
    for index = 1, 5000 do
      local item = values.map()
      values.set(item, 'id', index)
      values.set(item, 'name', `item {index}`)
      table.insert(items, item)
      table.insert(jsonItems, `\{"id":{index},"name":"item {index}"}`)
      table.insert(yamlLines, `- id: {index}\n  name: item {index}\n`)
    end

    local document = values.array(items)
    expect(json.encode(document)).toBe(`[{table.concat(jsonItems, ',')}]`)
    expect(yaml.encode(document)).toBe(table.concat(yamlLines))
  end)

  suite.it('writes a null a decoder read as a null', function()
    expect(json.encode(values.array { json.decode 'null', yaml.decode 'null' })).toBe '[null,null]'
  end)

  suite.it('writes a plain table with sorted keys, indented or on one line', function()
    local value = { zeta = { 1, 2.5, 'x\ty' }, alpha = 'Caf\233', empty = {}, none = json.null }
    expect(json.encodeTable(value)).toBe '{"alpha":"Caf\233","empty":[],"none":null,"zeta":[1,2.5,"x\\ty"]}'
    expect(json.encodeTable(value, { latin1 = true })).toContain '"Caf\\u00e9"'
    expect(json.encodeTable({ items = { 1 } }, { indent = 1 })).toBe '{\n "items": [\n  1\n ]\n}'
    expect(function() json.encodeTable { 1, nil, 3 } end).toThrow 'string keys or dense array indexes'
    expect(function() json.encodeTable(0 / 0) end).toThrow 'NaN or infinite'
  end)

  suite.it('has one null, jess.null, everywhere', function()
    expect(json.null).toBe(jess.null)
    expect(yaml.decode 'null').toBe(jess.null)
    expect(values.Null).toBe(jess.null)
    expect(json.encode(jess.null)).toBe 'null'
  end)

  suite.it('refuses a table it would have to guess about, and a format it doesn\'t write', function()
    expect(function() json.encode { 1, 2 } end).toThrow 'a bare table is neither a list nor a map'
    expect(function() yaml.encode { name = 'Jess' } end).toThrow 'a bare table is neither a list nor a map'
    expect(function() json.encode(print) end).toThrow 'a function can\'t be written'
    expect(function() values.encode(values.array {}, 'xml') end).toThrow 'unknown format \'xml\''
  end)
end)

return suite
